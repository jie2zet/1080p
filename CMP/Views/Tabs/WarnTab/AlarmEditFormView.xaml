    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="10,0,20,0" >
            <hc:Row Margin="0,0,0,20">
                <hc:Col Span="12">
                    <hc:Row>
                        <hc:Col Span="8">
                            <Label Content="报警名称"/>
                        </hc:Col>
                        <hc:Col Span="16">
                            <TextBox Text="{Binding CurrentAlarm.AlarmName}"/>
                        </hc:Col>
                    </hc:Row>
                </hc:Col>
                <hc:Col Span="12">
                    <hc:Row>
                        <hc:Col Span="6">
                            <Label Content="类型"/>
                        </hc:Col>
                        <hc:Col Span="18"> 
                            <hc:ComboBox Text="{Binding CurrentAlarm.Type}" ItemsSource="{Binding AlarmTypes}"/>
                        </hc:Col>
                    </hc:Row>
                </hc:Col>
            </hc:Row>
            <hc:Row Margin="0,0,0,20">
                <hc:Col Span="12">
                    <hc:Row>
                        <hc:Col Span="6">
                            <Label Content="单元"/>
                        </hc:Col>
                        <hc:Col Span="18">
                            <TextBox Text="{Binding CurrentAlarm.Unit}"/>
                        </hc:Col>
                    </hc:Row>
                </hc:Col>
                <hc:Col Span="12">
                    <hc:Row>
                        <hc:Col Span="6">
                            <Label Content="操作"/>
                        </hc:Col>
                        <hc:Col Span="18">
                            <hc:ComboBox Text="{Binding CurrentAlarm.DefaultOperation}" ItemsSource="{Binding DefaultOperations}"/>
                        </hc:Col>
                    </hc:Row>
                </hc:Col>
            </hc:Row>
            <hc:Row Margin="0,0,0,20">
                <hc:Col Span="12">
                    <hc:Row>
                        <hc:Col Span="8">
                            <Label Content="报警时间"/>
                        </hc:Col>
                        <hc:Col Span="16">
                            <hc:DateTimePicker SelectedDateTime="{Binding CurrentAlarm.AlarmTime, UpdateSourceTrigger=PropertyChanged}" DateTimeFormat="yyyy-MM-dd HH:mm:ss" />
                        </hc:Col>
                    </hc:Row>
                </hc:Col>
                <hc:Col Span="12">
                    <hc:Row>
                        <hc:Col Span="6">
                            <Label Content="描述"/>
                        </hc:Col>
                        <hc:Col Span="18">
                            <TextBox Text="{Binding CurrentAlarm.Description}"/>
                        </hc:Col>
                    </hc:Row>
                </hc:Col>
            </hc:Row>
            <hc:Row>
                <hc:Col Span="12">
                    <hc:Row>
                        <hc:Col Span="6">
                            <Label Content="备注"/>
                        </hc:Col>
                        <hc:Col Span="18">
                            <TextBox Text="{Binding CurrentAlarm.Comment}"/>
                        </hc:Col>
                    </hc:Row>
                </hc:Col>
                   
            </hc:Row>
        </StackPanel>
    </Grid>
</UserControl>