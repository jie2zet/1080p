<UserControl x:Class="CMP.Views.Tabs.WarnTab.AlarmTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"             
             xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:CMP.ViewModels.Tabs.WarnTab"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:AlarmTabContentViewModel}"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
            
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="2" BorderBrush="White" Height="70" Margin="5,10,5,10" Padding="10,0,10,0">
            <hc:RelativePanel VerticalAlignment="Center" >
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Height="70" >
                    <ComboBox Height="30"  ItemsSource="{Binding AlarmTypes}" SelectedItem="{Binding SelectedAlarmType}" Width="200" hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="100" FontSize="16"  hc:InfoElement.Title="Alarm Type" Style="{StaticResource ComboBoxExtend}" />

                    <ComboBox Height="30"  Margin="10,0,0,0" ItemsSource="{Binding DefaultOperations}" SelectedItem="{Binding SelectedOperation}" Width="250" hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="160" FontSize="16"  hc:InfoElement.Title="Default Operation" Style="{StaticResource ComboBoxExtend}" />

                   
                    <TextBox hc:InfoElement.Title="Alarm Name"   hc:InfoElement.TitlePlacement="Left"  hc:InfoElement.TitleWidth="120"   Text="{Binding AlarmName}"  Style="{StaticResource TextBoxExtend}"   Width="300"  FontSize="14" Height="30" Margin="10,0,0,0" />

                    <hc:DateTimePicker x:Name="StartTimePicker" Height="30" hc:InfoElement.Title="Start Time"  hc:InfoElement.TitlePlacement="Left"  FontSize="16"
                           SelectedDateTime="{Binding StartTime}" 
                           Margin="10,0,0,0" Width="300" Style="{StaticResource DateTimePickerExtend}"/>

                    <hc:DateTimePicker x:Name="EndTimePicker" Height="30" hc:InfoElement.Title="End Time"  hc:InfoElement.TitlePlacement="Left" FontSize="16" 
                           SelectedDateTime="{Binding EndTime}" 
                           Margin="10,0,0,0" Width="300" Style="{StaticResource DateTimePickerExtend}"/>
                    <Button Content="刷新"  Command="{Binding RefreshCommand}" Style="{StaticResource ButtonSuccess}"  FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" hc:RelativePanel.AlignRightWithPanel="True" Orientation="Horizontal" Height="70" >
                    
                    <Button Name="Add_btn" Content="新增" Command="{Binding InsertCommand}" CommandParameter="FormDialog" Style="{StaticResource ButtonSuccess}"  FontSize="14" Margin="0" VerticalAlignment="Center" Click="Add_btn_Click" />
                </StackPanel> 
            </hc:RelativePanel>
        </Border>

        <DataGrid x:Name="AlarmGrid"
                  Grid.Row="1"
                  IsReadOnly="True"
                  Margin="5"
                  ItemsSource="{Binding AlarmData}"
                  CanUserReorderColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeaderWidth="60"
                  AutoGenerateColumns="False"
                  SelectedItem="{Binding SelectedItem}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.CanContentScroll="True">
               <DataGrid.Columns>                  
                    <DataGridTextColumn Binding="{Binding AlarmName}" Header="报警名称" Width="200" />
                    <DataGridTextColumn Binding="{Binding Type}" Header="类型" Width="120" />
                    <DataGridTextColumn Binding="{Binding Unit}" Header="单位" Width="80" />
                    <DataGridTextColumn Binding="{Binding DefaultOperation}" Header="默认操作" Width="150" />
                    <DataGridTextColumn Binding="{Binding Description}" Header="描述" Width="*" MinWidth="200" />
                    <DataGridTextColumn Binding="{Binding AlarmTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Header="报警时间" Width="180" />
                    <DataGridTextColumn Binding="{Binding Comment}" Header="备注" Width="150" />
                    <DataGridTemplateColumn Width="100" CanUserResize="False" Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="编辑"  
                         Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" 
                         CommandParameter="{Binding}"
                         Width='60' Margin="0,0,10,0" Style="{StaticResource ButtonSuccess}"></Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        <Border Grid.Row="2" Background="AliceBlue" Height="50">
            <hc:Pagination HorizontalAlignment="Right"
                           DataCountPerPage="{Binding PageSize}"
                           MaxPageCount="{Binding TotalPages}"
                           PageIndex="{Binding Page, Mode=TwoWay}"
                           IsJumpEnabled="True"
                           Margin="10">
                <bh:Interaction.Triggers>
                    <bh:EventTrigger EventName="PageUpdated">
                        <prism:InvokeCommandAction Command="{Binding PageChangeCommand}"/>
                    </bh:EventTrigger>
                </bh:Interaction.Triggers>
            </hc:Pagination>
        </Border>
    </Grid>
</UserControl>