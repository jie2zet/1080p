<UserControl x:Class="CMP.Views.Tabs.WarnTab.ConsumableTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMP.Views.Tabs.WarnTab"
             xmlns:vm="clr-namespace:CMP.ViewModels.Tabs.WarnTab"
             xmlns:models="clr-namespace:CMP.Models.Warn"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:localBehavior="clr-namespace:Core.Controls.Behaviors;assembly=Core"
             xmlns:converter="clr-namespace:Core.Controls.Converters;assembly=Core"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance vm:ConsumableTabContentViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converter:NegativeIntToBoolConverter x:Key="NegativeIntToBoolConverter"/>
        <converter:StringNullOrEmptyConverter x:Key="StringNullOrEmptyConverter"/>
        <converter:StringToDateTimeConverter x:Key="StringToDateTimeConverter"/>
        <Style x:Key="LocalBaseTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="25"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="LocalBaseTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        
        <DataTemplate x:Key="ConsumableGroupTemplate">
            <StackPanel Margin="0,5">
                <!-- 列头 -->
                <Border CornerRadius="10" Background="{DynamicResource PrimaryBrush}">
                    <Grid Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lex:Loc ConsumableName}" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{lex:Loc WaferCount}" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="{lex:Loc UsedTime}" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="{lex:Loc WaferCountSet}" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="4" Text="{lex:Loc UsedTimeSet}" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="5" Text="{lex:Loc UpdateTime}" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Column="6" Text="{lex:Loc Update}" Foreground="White"
                                   TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- 数据行 -->
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#D0D8E8" BorderThickness="1"
                                    Background="White" Margin="0,2" Height="30" Padding="6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="0.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="2,0"
                                            CornerRadius="8" BorderBrush="#C0C8D8" BorderThickness="1"
                                            Background="#F8F9FA">
                                        <!-- 耗材名称（只读） -->
                                        <TextBlock Text="{Binding ConsumableName}" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                    </Border>
                                    <!-- 晶圆计数（只读） -->
                                    <Border Grid.Column="1" Margin="2,0"
                                            CornerRadius="8" BorderBrush="#C0C8D8" BorderThickness="1"
                                            Background="#F8F9FA">
                                        <TextBlock Text="{Binding WaferCount}" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                    </Border>
                                    <!-- 使用时间（只读） -->
                                    <Border Grid.Column="2" Margin="2,0"
                                            CornerRadius="8" BorderBrush="#C0C8D8" BorderThickness="1"
                                            Background="#F8F9FA">
                                        <TextBlock Text="{Binding UsedTime}" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                    </Border>

                                    <!-- 设定晶圆数（可编辑，条件满足时禁用） -->
                                    <Border Grid.Column="3" Margin="2,0"
                                            CornerRadius="8" BorderBrush="#C0C8D8" BorderThickness="1"
                                            Background="Transparent">
                                        <TextBox Text="{Binding WaferCountSet, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center" VerticalAlignment="Center"
                                                 BorderThickness="0" Background="Transparent"
                                                 IsEnabled="{Binding IsWaferCountSetEditable}"/>
                                    </Border>
                                    <!-- 设定时间（可编辑，条件满足时禁用） -->
                                    <Border Grid.Column="4" Margin="2,0"
                                            CornerRadius="8" BorderBrush="#C0C8D8" BorderThickness="1"
                                            Background="Transparent">
                                        <hc:TimePicker SelectedTime="{Binding UsedTimeSet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,
                                                            Converter={StaticResource StringToDateTimeConverter}}"
                                                           Text="{Binding UsedTimeSet, Mode=OneWay}"
                                                           HorizontalContentAlignment="Center"
                                                 VerticalAlignment="Center"  TimeFormat="HH:mm:ss"
                                                 BorderThickness="0" Background="Transparent"
                                                 IsEnabled="{Binding IsUsedTimeSetEditable}"/>
                                    </Border>

                                    <!-- 更新时间（只读） -->
                                    <TextBlock Grid.Column="5" Text="{Binding UpdateTime}" Foreground="Black"
                                               TextAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- 更新按钮 -->
                                    <Button Grid.Column="6" Content="{lex:Loc Update}"
                                            Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Height="26" MinWidth="50" Margin="2"
                                            Background="{StaticResource PrimaryBrush}"
                                            Foreground="White"
                                            hc:BorderElement.CornerRadius="10"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        
    </UserControl.Resources>
    
    <Grid>
        <TabControl x:Name="tabControl" MaxHeight="770" VerticalAlignment="Top">
            <TabItem Style="{StaticResource SecondaryTabItemStyle}" Header="{lex:Loc Polish}">
                <ScrollViewer VerticalScrollBarVisibility="Visible" CanContentScroll="True">
                    <StackPanel Orientation="Vertical" Margin="5">
                        <Border CornerRadius="10" Background="{DynamicResource PrimaryBrush}" Margin="0,0,0,8">
                            <Grid Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lex:Loc Equipment}" Foreground="White"
                                           TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{lex:Loc PolisherA}" Foreground="White"
                                           TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="{lex:Loc PolisherB}" Foreground="White"
                                           TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="{lex:Loc PolisherC}" Foreground="White"
                                           TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Grid.Column="4" Text="{lex:Loc PolisherD}" Foreground="White"
                                           TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="#D0D8E8" BorderThickness="1" Background="White" Margin="0,0,0,10" Height="30" Padding="6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Margin="2,0" CornerRadius="8" BorderBrush="#C0C8D8" BorderThickness="1" Background="#F8F9FA">
                                    <TextBlock Text="{Binding EquipmentLifetimeCount}" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                </Border>
                                <Border Grid.Column="1" Margin="2,0" CornerRadius="8" BorderBrush="#C0C8D8" BorderThickness="1" Background="#F8F9FA">
                                    <TextBlock Text="{Binding PolisherALifetimeCount}" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                </Border>
                                <Border Grid.Column="2" Margin="2,0" CornerRadius="8" BorderBrush="#C0C8D8" BorderThickness="1" Background="#F8F9FA">
                                    <TextBlock Text="{Binding PolisherBLifetimeCount}" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                </Border>
                                <Border Grid.Column="3" Margin="2,0" CornerRadius="8" BorderBrush="#C0C8D8" BorderThickness="1" Background="#F8F9FA">
                                    <TextBlock Text="{Binding PolisherCLifetimeCount}" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                </Border>
                                <Border Grid.Column="4" Margin="2,0" CornerRadius="8" BorderBrush="#C0C8D8" BorderThickness="1" Background="#F8F9FA">
                                    <TextBlock Text="{Binding PolisherDLifetimeCount}" TextAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ConsumableGroups}" ScrollViewer.CanContentScroll="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Workstation}" FontWeight="Bold" 
                                               Foreground="White" TextAlignment="Center" HorizontalAlignment="Stretch"
                                               Style="{StaticResource TextBlockBaseStyle}" Background="#00A2E8"/>
                                        <ContentPresenter Content="{Binding Consumables}" ContentTemplate="{StaticResource ConsumableGroupTemplate}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Style="{StaticResource SecondaryTabItemStyle}" Header="{lex:Loc Roller}">
                <ScrollViewer VerticalScrollBarVisibility="Visible" CanContentScroll="True" >
                    <ItemsControl ItemsSource="{Binding ConsumableGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Margin="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Workstation}" FontWeight="Bold" 
                           Foreground="White" TextAlignment="Center" HorizontalAlignment="Stretch"
                           Style="{StaticResource TextBlockBaseStyle}" Background="#00A2E8"/>
                                    <ContentPresenter Content="{Binding Consumables}" ContentTemplate="{StaticResource ConsumableGroupTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Style="{StaticResource SecondaryTabItemStyle}" Header="{lex:Loc Pen}">
                <ScrollViewer VerticalScrollBarVisibility="Visible" CanContentScroll="True">
                    <ItemsControl ItemsSource="{Binding ConsumableGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Margin="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Workstation}" FontWeight="Bold" 
                           Foreground="White" TextAlignment="Center" HorizontalAlignment="Stretch"
                           Style="{StaticResource TextBlockBaseStyle}" Background="#00A2E8"/>
                                    <ContentPresenter Content="{Binding Consumables}" ContentTemplate="{StaticResource ConsumableGroupTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <behavior:Interaction.Triggers>
                <behavior:EventTrigger EventName="SelectionChanged">
                    <behavior:InvokeCommandAction Command="{Binding SelectionChangedCommand}"
                                                  PassEventArgsToCommand="True"
                                                  CommandParameter="{Binding ElementName=tabControl,Path=SelectedItem.Header}">
                    </behavior:InvokeCommandAction>
                </behavior:EventTrigger>
            </behavior:Interaction.Triggers>
        </TabControl>
    </Grid>
</UserControl>
