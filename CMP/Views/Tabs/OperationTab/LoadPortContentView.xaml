<UserControl x:Class="CMP.Views.Tabs.OperationTab.LoadPortContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 mc:Ignorable="d"
 xmlns:lex="http://wpflocalizeextension.codeplex.com"
 xmlns:prism="http://prismlibrary.com/"
 xmlns:hc="https://handyorg.github.io/handycontrol" 
 xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
 xmlns:viewModels="clr-namespace:CMP.ViewModels.Tabs.OperationTab"             
 xmlns:converters="clr-namespace:Core.Controls.Converters;assembly=Core"
 prism:ViewModelLocator.AutoWireViewModel="True"
 d:DataContext="{d:DesignInstance viewModels:LoadPortContentViewModel}"
 lex:ResxLocalizationProvider.DefaultAssembly="CMP"
 lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DesignHeight="450" Width="1582">
    <UserControl.Resources>
        <!-- Converter for Bot Server State -->
        <converters:OnOffStateConverter x:Key="OnOffStateConverter" />
        <!-- Converter for String Formatting -->
        <converters:StringFormatConverter x:Key="StringFormatConverter" />
       
         <converters:SlotIdConverter x:Key="SlotIdConverter"/>
       
        <!-- 在UserControl.Resources中添加 -->
        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="MinWidth" Value="55"/>
            <Setter Property="MaxWidth" Value="70"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1"/>
        </Style>

        <Style x:Key="SmallDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
            <Setter Property="MinWidth" Value="55"/>
            <Setter Property="MaxWidth" Value="70"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1"/>
        </Style>
        <!-- 扁平化按钮样式 -->
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    <Border BorderThickness="1" Margin="5" Padding="0" CornerRadius="4">
        <StackPanel extensions:StackPanelHelpers.Spacing="10" Orientation="Horizontal">
            <!-- LoadPort 1 -->
            <GroupBox MinHeight="330" MinWidth="200" Background="Transparent"
              hc:TitleElement.Background="{StaticResource PrimaryBrush}"
              Padding="10" Style="{StaticResource GroupBoxTab.Small}">
                <GroupBox.Header>
                    <StackPanel>
                        <TextBlock Padding="5" Foreground="White">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource StringFormatConverter}">
                                    <Binding Source="{lex:Loc LoadPort}" />
                                    <Binding Source="1" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </GroupBox.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：FOUP图片和晶圆列表 -->
                    <Grid Grid.Row="0" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左边FOUP图片 -->
                        <Image Grid.Column="0" Source="{Binding LoadPortDatas[0].FoupImageSource}" Width="80" Height="80" Margin="0 0 10 0" VerticalAlignment="Center"/>

                        <!-- 右边晶圆列表（每行一个） -->
                        <ScrollViewer Grid.Column="1"  HorizontalScrollBarVisibility="Disabled"   VerticalScrollBarVisibility="Auto"  Height="260" Width="110">
                            <ItemsControl ItemsSource="{Binding LoadPortDatas[0].WaferList}">
                                <ItemsControl.ItemsPanel >
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="100" Height="8" Margin="1" Background="{Binding WaferColor}" ToolTip="{Binding WaferStatus}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SlotID,Converter={StaticResource SlotIdConverter}}"    FontSize="7" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 第二行：Connect/Disconnect按钮 -->
                    <Grid Grid.Row="1" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" 
                            Content="{lex:Loc Connect}"
                            Style="{StaticResource FlatButtonStyle}"
                            Command="{Binding LoadPortDatas[0].ConnectCommand}"
                            CommandParameter="COM1"
                            Margin="0 0 10 0"
                            Width="80"
                            Background="#2C66A7"
                            Foreground="White"
                            BorderBrush="#005A9E"/>

                        <Button Grid.Column="2" 
                            Content="{lex:Loc Disconnect}"
                            Style="{StaticResource FlatButtonStyle}"
                            Command="{Binding LoadPortDatas[0].DisconnectCommand}"
                            CommandParameter="COM1"
                            Width="80"
                            Background="#CC0000"
                            Foreground="White"
                            BorderBrush="#990000" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                    </Grid> 
                    <!-- 第三行：控制按钮区域 -->
                    <Grid Grid.Row="2" Margin=" 0 10 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左边8个按钮 -->
                        <Grid Grid.Column="0" Margin="0 0 5 0 ">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="{lex:Loc Load}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="CLDMP" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="{lex:Loc UnLoad}"  Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="CULOD"  Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/> 
                            <Button Grid.Row="1" Grid.Column="0" Content="{lex:Loc Dock}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="YDOOR" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="{lex:Loc UnDock}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="YWAIT" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="{lex:Loc Latch}"  Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="DORCL" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="{lex:Loc UnLatch}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="DOROP"  Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="0" Content="{lex:Loc Mapping}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="REMAP"  Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="{lex:Loc Stop}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="STOP_"  Style="{StaticResource SmallDangerButtonStyle}" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                        </Grid>

                        <!-- 中间虚线分隔 -->
                        <Rectangle Grid.Column="1" Width="1" Fill="LightGray" Margin="2 0" VerticalAlignment="Stretch">
                            <Rectangle.StrokeDashArray>
                                <DoubleCollection>1,1</DoubleCollection>
                            </Rectangle.StrokeDashArray>
                        </Rectangle>

                        <!-- 右边8个按钮 -->
                        <Grid Grid.Column="2" Margin="5 0 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="{lex:Loc Clamp}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="PODCL" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="{lex:Loc UnClamp}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="PODOP" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="{lex:Loc Vacc}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="VACON" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="{lex:Loc UnVacc}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="VACOF" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="{lex:Loc Open}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="DORBK" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="{lex:Loc Close}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="DORFW" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="0" Content="{lex:Loc ORG}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[0].MOVCommand}" CommandParameter="ORGSH" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="{lex:Loc Reset}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[0].SETCommand}" CommandParameter="RESET" IsEnabled="{Binding LoadPortDatas[0].IsConnected}"/>
                        </Grid>
                    </Grid>

                    <!-- 第四行：下拉列表、输入框和按钮 -->
                    <Grid Grid.Row="3" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" 
                          ItemsSource="{Binding LoadPortDatas[0].CommandList}"
                          SelectedItem="{Binding LoadPortDatas[0].SelectedCommand}"
                          Margin="0 0 5 0"/>
                        <TextBox Grid.Column="1" 
                             Text="{Binding LoadPortDatas[0].CommandParameter}"
                             Margin="5 0 5 0"/>
                        <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}"
                            Content="{lex:Loc Set}" Width="80"
                            Command="{Binding LoadPortDatas[0].SETCommand}"
                            Margin="5 0 0 0"/>
                    </Grid>

                    <!-- 第五行：日志展示区 -->
                    <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1" Width="280" Height="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding LoadPortDatas[0].LogMessages}" 
                         BorderThickness="0"  >
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                       FontFamily="Consolas" 
                                       FontSize="8"
                                       TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </GroupBox>

            <!-- LoadPort 2 -->
            <GroupBox MinHeight="330" MinWidth="200" Background="Transparent"
                  hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                  Padding="10" Style="{StaticResource GroupBoxTab.Small}">
                <GroupBox.Header>
                    <StackPanel>
                        <TextBlock Padding="5" Foreground="White">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource StringFormatConverter}">
                                    <Binding Source="{lex:Loc LoadPort}" />
                                    <Binding Source="2" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </GroupBox.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：FOUP图片和晶圆列表 -->
                    <Grid Grid.Row="0" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左边FOUP图片 -->
                        <Image Grid.Column="0" Source="{Binding LoadPortDatas[1].FoupImageSource}" Width="80" Height="80" Margin="0 0 10 0" VerticalAlignment="Center"/>

                        <!-- 右边晶圆列表（每行一个） -->
                        <ScrollViewer Grid.Column="1"  HorizontalScrollBarVisibility="Disabled"   VerticalScrollBarVisibility="Auto"  Height="260" Width="110">
                            <ItemsControl ItemsSource="{Binding LoadPortDatas[1].WaferList}">
                                <ItemsControl.ItemsPanel >
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="100" Height="8" Margin="1" Background="{Binding WaferColor}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SlotID}" FontSize="8" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 第二行：Connect/Disconnect按钮 -->
                    <Grid Grid.Row="1" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" 
                            Content="{lex:Loc Connect}"
                            Style="{StaticResource FlatButtonStyle}"
                            Command="{Binding LoadPortDatas[1].ConnectCommand}"
                            CommandParameter="1"
                            Margin="0 0 10 0"
                            Width="80"
                            Background="#2C66A7"
                            Foreground="White"
                            BorderBrush="#005A9E"/>

                        <Button Grid.Column="2" 
                            Content="{lex:Loc Disconnect}"
                            Style="{StaticResource FlatButtonStyle}"
                            Command="{Binding LoadPortDatas[1].DisconnectCommand}"
                            CommandParameter="1"
                            Width="80"
                            Background="#CC0000"
                            Foreground="White"
                            BorderBrush="#990000" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                    </Grid>
                    <!-- 第三行：控制按钮区域 -->
                    <Grid Grid.Row="2" Margin=" 0 10 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左边8个按钮 -->
                        <Grid Grid.Column="0" Margin="0 0 5 0 ">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="{lex:Loc Load}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="CLDMP" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="{lex:Loc UnLoad}"  Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="CULOD"  Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="{lex:Loc Dock}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="YDOOR" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="{lex:Loc UnDock}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="YWAIT" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="{lex:Loc Latch}"  Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="DORCL" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="{lex:Loc UnLatch}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="DOROP"  Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="0" Content="{lex:Loc Mapping}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="REMAP"  Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="{lex:Loc Stop}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="STOP_"  Style="{StaticResource SmallDangerButtonStyle}" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                        </Grid>

                        <!-- 中间虚线分隔 -->
                        <Rectangle Grid.Column="1" Width="1" Fill="LightGray" Margin="2 0" VerticalAlignment="Stretch">
                            <Rectangle.StrokeDashArray>
                                <DoubleCollection>1,1</DoubleCollection>
                            </Rectangle.StrokeDashArray>
                        </Rectangle>

                        <!-- 右边8个按钮 -->
                        <Grid Grid.Column="2" Margin="5 0 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="{lex:Loc Clamp}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="PODCL" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="{lex:Loc UnClamp}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="PODOP" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="{lex:Loc Vacc}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="VACON" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="{lex:Loc UnVacc}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="VACOF" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="{lex:Loc Open}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="DORBK" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="{lex:Loc Close}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="DORFW" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="0" Content="{lex:Loc ORG}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[1].MOVCommand}" CommandParameter="ORGSH" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="{lex:Loc Reset}" Style="{StaticResource SmallButtonStyle}" Command="{Binding LoadPortDatas[1].SETCommand}" CommandParameter="RESET" IsEnabled="{Binding LoadPortDatas[1].IsConnected}"/>
                        </Grid>
                    </Grid>

                    <!-- 第四行：下拉列表、输入框和按钮 -->
                    <Grid Grid.Row="3" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" 
                          ItemsSource="{Binding LoadPortDatas[1].CommandList}"
                          SelectedItem="{Binding LoadPortDatas[1].SelectedCommand}"
                          Margin="0 0 5 0"/>
                        <TextBox Grid.Column="1" Text="{Binding LoadPortDatas[1].CommandParameter}"  Margin="5 0 5 0"/>
                        <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}"
                            Content="{lex:Loc Set}" Width="80"
                            Command="{Binding LoadPortDatas[1].SETCommand}"
                            Margin="5 0 0 0"/>
                    </Grid>

                    <!-- 第五行：日志展示区 -->
                    <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1" Width="280" Height="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding LoadPortDatas[1].LogMessages}"  BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                           FontFamily="Consolas" 
                                           FontSize="8"
                                           TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </GroupBox>

            <!-- LoadPort 3 -->
            <GroupBox MinHeight="330" MinWidth="200" Background="Transparent"
              hc:TitleElement.Background="{StaticResource PrimaryBrush}"
              Padding="10" Style="{StaticResource GroupBoxTab.Small}">
                <GroupBox.Header>
                    <StackPanel>
                        <TextBlock Padding="5" Foreground="White">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource StringFormatConverter}">
                                    <Binding Source="{lex:Loc LoadPort}" />
                                    <Binding Source="3" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </GroupBox.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：FOUP图片和晶圆列表 -->
                    <Grid Grid.Row="0" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左边FOUP图片 -->
                        <Image Grid.Column="0" Source="{Binding LoadPortDatas[2].FoupImageSource}" Width="80" Height="80" Margin="0 0 10 0" VerticalAlignment="Center"/>

                        <!-- 右边晶圆列表（每行一个） -->
                        <ScrollViewer Grid.Column="1"  HorizontalScrollBarVisibility="Disabled"   VerticalScrollBarVisibility="Auto"  Height="260" Width="110">
                            <ItemsControl ItemsSource="{Binding LoadPortDatas[2].WaferList}">
                                <ItemsControl.ItemsPanel >
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="100" Height="8" Margin="1" Background="{Binding WaferColor}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SlotID}" FontSize="8" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 第二行：Connect/Disconnect按钮 -->
                    <Grid Grid.Row="1" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" 
                            Content="{lex:Loc Connect}"
