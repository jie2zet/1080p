                        <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}"
                            Content="{lex:Loc Set}" Width="80"
                            Command="{Binding LoadPortDatas[4].SETCommand}"
                            Margin="5 0 0 0"/>
                    </Grid>

                    <!-- 第五行：日志展示区 -->
                    <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1" Width="280" Height="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding LoadPortDatas[4].LogMessages}"  BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                               FontFamily="Consolas" 
                               FontSize="8"
                               TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </GroupBox>
        </StackPanel>   
    </Border>
</UserControl>
