<UserControl x:Class="CMP.Views.Tabs.OperationTab.LoadPortContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:viewModels="clr-namespace:CMP.ViewModels.Tabs.OperationTab"
             xmlns:lp="clr-namespace:CMP.Models.Operation.LoadPort"
             xmlns:converters="clr-namespace:Core.Controls.Converters;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:LoadPortContentViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DesignHeight="450" d:DesignWidth="1582">
    <UserControl.Resources>
        <converters:OnOffStateConverter x:Key="OnOffStateConverter" />
        <converters:StringFormatConverter x:Key="StringFormatConverter" />
        <converters:SlotIdConverter x:Key="SlotIdConverter"/>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="MinWidth" Value="55"/>
            <Setter Property="MaxWidth" Value="70"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1"/>
        </Style>

        <Style x:Key="SmallDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
            <Setter Property="MinWidth" Value="55"/>
            <Setter Property="MaxWidth" Value="70"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1"/>
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 单口操作面板：DataContext = LoadPortData -->
        <DataTemplate x:Key="LoadPortPanelTemplate" DataType="{x:Type lp:LoadPortData}">
            <GroupBox MinHeight="330" MinWidth="200" Background="Transparent"
                      hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                      Padding="10" Style="{StaticResource GroupBoxTab.Small}">
                <GroupBox.Header>
                    <StackPanel>
                        <TextBlock Padding="5" Foreground="White">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource StringFormatConverter}">
                                    <Binding Source="{lex:Loc LoadPort}" />
                                    <Binding Path="DisplayNumber" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </GroupBox.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- FOUP + 晶圆列表 -->
                    <Grid Grid.Row="0" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="{Binding FoupImageSource}" Width="80" Height="80" Margin="0 0 10 0" VerticalAlignment="Center"/>

                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Height="260" Width="110">
                            <ItemsControl ItemsSource="{Binding WaferList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="100" Height="8" Margin="1" Background="{Binding WaferColor}" ToolTip="{Binding WaferStatus}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SlotID, Converter={StaticResource SlotIdConverter}}" FontSize="7" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Connect / Disconnect / StopLoad -->
                    <Grid Grid.Row="1" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="{lex:Loc Connect}"
                                Style="{StaticResource FlatButtonStyle}"
                                Command="{Binding ConnectCommand}"
                                CommandParameter="{Binding PortNumber}"
                                Margin="0 0 10 0"
                                Width="80"
                                Background="#2C66A7"
                                Foreground="White"
                                BorderBrush="#005A9E"/>

                        <Button Grid.Column="2"
                                Content="{lex:Loc Disconnect}"
                                Style="{StaticResource FlatButtonStyle}"
                                Command="{Binding DisconnectCommand}"
                                CommandParameter="{Binding PortNumber}"
                                Margin="0 0 10 0"
                                Width="80"
                                Background="#CC0000"
                                Foreground="White"
                                BorderBrush="#990000"
                                IsEnabled="{Binding IsConnected}"/>

                        <Button Grid.Column="3"
                                Content="{lex:Loc StopLoad}"
                                Style="{StaticResource FlatButtonStyle}"
                                Command="{Binding StopLoadCommand}"
                                Width="88"
                                Background="#CC0000"
                                Foreground="White"
                                BorderBrush="#990000"/>
                    </Grid>

                    <!-- MOV / SET 按钮 -->
                    <Grid Grid.Row="2" Margin="0 10 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0 0 5 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="{lex:Loc Load}" Command="{Binding MOVCommand}" CommandParameter="CLDMP" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="{lex:Loc UnLoad}" Command="{Binding MOVCommand}" CommandParameter="CULOD" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="{lex:Loc Dock}" Command="{Binding MOVCommand}" CommandParameter="YDOOR" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="{lex:Loc UnDock}" Command="{Binding MOVCommand}" CommandParameter="YWAIT" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="{lex:Loc Latch}" Command="{Binding MOVCommand}" CommandParameter="DORCL" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="{lex:Loc UnLatch}" Command="{Binding MOVCommand}" CommandParameter="DOROP" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="0" Content="{lex:Loc Mapping}" Command="{Binding MOVCommand}" CommandParameter="REMAP" Style="{StaticResource SmallButtonStyle}" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="{lex:Loc Stop}" Command="{Binding MOVCommand}" CommandParameter="STOP_" Style="{StaticResource SmallDangerButtonStyle}" IsEnabled="{Binding IsConnected}"/>
                        </Grid>

                        <Rectangle Grid.Column="1" Width="1" Fill="LightGray" Margin="2 0" VerticalAlignment="Stretch">
                            <Rectangle.StrokeDashArray>
                                <DoubleCollection>1,1</DoubleCollection>
                            </Rectangle.StrokeDashArray>
                        </Rectangle>

                        <Grid Grid.Column="2" Margin="5 0 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="{lex:Loc Clamp}" Style="{StaticResource SmallButtonStyle}" Command="{Binding MOVCommand}" CommandParameter="PODCL" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="{lex:Loc UnClamp}" Style="{StaticResource SmallButtonStyle}" Command="{Binding MOVCommand}" CommandParameter="PODOP" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="{lex:Loc Vacc}" Style="{StaticResource SmallButtonStyle}" Command="{Binding MOVCommand}" CommandParameter="VACON" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="{lex:Loc UnVacc}" Style="{StaticResource SmallButtonStyle}" Command="{Binding MOVCommand}" CommandParameter="VACOF" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="0" Content="{lex:Loc Open}" Style="{StaticResource SmallButtonStyle}" Command="{Binding MOVCommand}" CommandParameter="DORBK" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="{lex:Loc Close}" Style="{StaticResource SmallButtonStyle}" Command="{Binding MOVCommand}" CommandParameter="DORFW" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="0" Content="{lex:Loc ORG}" Style="{StaticResource SmallButtonStyle}" Command="{Binding MOVCommand}" CommandParameter="ORGSH" IsEnabled="{Binding IsConnected}"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="{lex:Loc Reset}" Style="{StaticResource SmallButtonStyle}" Command="{Binding SETCommand}" CommandParameter="RESET" IsEnabled="{Binding IsConnected}"/>
                        </Grid>
                    </Grid>

                    <!-- SET 参数 -->
                    <Grid Grid.Row="3" Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding CommandList}"
                                  SelectedItem="{Binding SelectedCommand}"
                                  Margin="0 0 5 0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding CommandParameter}"
                                 Margin="5 0 5 0"/>
                        <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}"
                                Content="{lex:Loc Set}" Width="80"
                                Command="{Binding SETCommand}"
                                Margin="5 0 0 0"/>
                    </Grid>

                    <!-- 日志 -->
                    <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1" Width="280" Height="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding LogMessages}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas"
                                                   FontSize="8"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </GroupBox>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderThickness="1" Margin="5" Padding="0" CornerRadius="4">
        <ItemsControl ItemsSource="{Binding LoadPortDatas}"
                      ItemTemplate="{StaticResource LoadPortPanelTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel extensions:StackPanelHelpers.Spacing="10" Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Border>
</UserControl>
