<UserControl x:Class="CMP.Views.Tabs.OperationTab.RobotControlTab.PolishASideArm3.PolishASideArm3ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewModel="clr-namespace:CMP.ViewModels.Tabs.OperationTab.RobotControlTab"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:polishASideArm3="clr-namespace:CMP.Views.Tabs.OperationTab.RobotControlTab.PolishASideArm3"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModel:PolishASideArm3ControlViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <Style x:Key="HiddenTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="MoveToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DC3545"/>
                    <Setter Property="BorderBrush" Value="#DC3545"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ToggleButtonSuccess" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1E7E34"/>
                    <Setter Property="BorderBrush" Value="#1C7430"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                    <Setter Property="BorderBrush" Value="#1E7E34"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ToggleButtonWarning" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D39E00"/>
                    <Setter Property="BorderBrush" Value="#C69500"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                    <Setter Property="BorderBrush" Value="#D39E00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ToggleButtonDanger" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#BD2130"/>
                    <Setter Property="BorderBrush" Value="#B21F2D"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <TabControl Style="{StaticResource HiddenTabControlStyle}" SelectedIndex="{Binding CurrentViewIndex}">
        <!-- Main View (Index 0) -->
        <TabItem>
            <Grid Background="#E8E8E8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Title Bar -->
                <Grid Grid.Row="0" Margin="10,10,10,5">
                    <TextBlock Text="{lex:Loc PolishASideArm3}" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc StationOperation}" Style="{StaticResource ButtonSuccess}" 
                            MinWidth="80" Height="30" Padding="10,5"
                            HorizontalAlignment="Right" Command="{Binding StationOperationCommand}"/>
                </Grid>

                <!-- Main Content Area -->
                <Grid Grid.Row="1" Margin="10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Axis Position Adjustment -->
                    <GroupBox Grid.Column="0" Header="{lex:Loc PolishASideArm3XAxisPositionAdjustment}" Margin="0,0,5,0" Background="White" BorderBrush="#CCCCCC">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- StandbyPosition -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc StandbyPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <controls:EditableNumericWithActions Grid.Row="0" Grid.Column="1"
                                 Value="{Binding XStandbyPosition}"
                                 Minimum="{Binding PositionMinimum}"
                                 Maximum="{Binding PositionMaximum}"
                                 DecimalPlaces="3"
                                 Increment="0.001"
                                 IsDirty="{Binding IsXStandbyPositionDirty, Mode=OneWay}"
                                 SetCommand="{Binding XStandbyPositionSetCommand}"
                                 CancelCommand="{Binding XStandbyPositionCancelCommand}"/>
                    <ToggleButton Grid.Row="0" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                            Width="55" Height="28" Margin="5,0" IsChecked="{Binding XStandbyPositionMoveToggle, Mode=OneWay}" Command="{Binding XStandbyPositionMoveCommand}"/>

                        <!-- TransferArmPosition -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc TransferArmPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <controls:EditableNumericWithActions Grid.Row="1" Grid.Column="1"
                                 Value="{Binding XTransferArmPosition}"
                                 Minimum="{Binding PositionMinimum}"
                                 Maximum="{Binding PositionMaximum}"
                                 DecimalPlaces="3"
                                 Increment="0.001"
                                 IsDirty="{Binding IsXTransferArmPositionDirty, Mode=OneWay}"
                                 SetCommand="{Binding XTransferArmPositionSetCommand}"
                                 CancelCommand="{Binding XTransferArmPositionCancelCommand}"/>
                        <ToggleButton Grid.Row="1" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                              Width="55" Height="28" Margin="5,0" IsChecked="{Binding XTransferArmPositionMoveToggle, Mode=OneWay}" Command="{Binding XTransferArmPositionMoveCommand}"/>

                        <!-- PolishAPosition -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc PolishAPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <controls:EditableNumericWithActions Grid.Row="2" Grid.Column="1"
                                 Value="{Binding XPolishAPosition}"
                                 Minimum="{Binding PositionMinimum}"
                                 Maximum="{Binding PositionMaximum}"
                                 DecimalPlaces="3"
                                 Increment="0.001"
                                 IsDirty="{Binding IsXPolishAPositionDirty, Mode=OneWay}"
                                 SetCommand="{Binding XPolishAPositionSetCommand}"
                                 CancelCommand="{Binding XPolishAPositionCancelCommand}"/>
                        <ToggleButton Grid.Row="2" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                            Width="55" Height="28" Margin="5,0" IsChecked="{Binding XPolishAPositionMoveToggle, Mode=OneWay}" Command="{Binding XPolishAPositionMoveCommand}"/>

                        <!-- PolishBPosition -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{lex:Loc PolishBPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <controls:EditableNumericWithActions Grid.Row="3" Grid.Column="1"
                                 Value="{Binding XPolishBPosition}"
                                 Minimum="{Binding PositionMinimum}"
                                 Maximum="{Binding PositionMaximum}"
                                 DecimalPlaces="3"
                                 Increment="0.001"
                                 IsDirty="{Binding IsXPolishBPositionDirty, Mode=OneWay}"
                                 SetCommand="{Binding XPolishBPositionSetCommand}"
                                 CancelCommand="{Binding XPolishBPositionCancelCommand}"/>
                        <ToggleButton Grid.Row="3" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                            Width="55" Height="28" Margin="5,0" IsChecked="{Binding XPolishBPositionMoveToggle, Mode=OneWay}" Command="{Binding XPolishBPositionMoveCommand}"/>


                    <!-- UNIFIED Right-Side Panel: Spanning all rows (0 to 6) -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="7" Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                         <!-- Row 0: JOG Speed -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="32" Margin="0,0,0,0">
                            <TextBlock Text="{lex:Loc JogSpeed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Width="100"
                                                 Value="{Binding XJogSpeed}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsXJogSpeedDirty, Mode=OneWay}"
                                                 SetCommand="{Binding XJogSpeedSetCommand}"
                                                 CancelCommand="{Binding XJogSpeedCancelCommand}"/>
                        </StackPanel>
                        
                        <!-- Row 1: Auto Speed -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="32" Margin="0,0,0,0">
                            <TextBlock Text="{lex:Loc AutoSpeed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Width="100"
                                                 Value="{Binding XAutoSpeed}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsXAutoSpeedDirty, Mode=OneWay}"
                                                 SetCommand="{Binding XAutoSpeedSetCommand}"
                                                 CancelCommand="{Binding XAutoSpeedCancelCommand}"/>
                        </StackPanel>

                        <!-- Row 2: Current Coordinate -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="32" Margin="0,0,0,0">
                            <TextBlock Text="{lex:Loc CurrentCoordinate}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding XCurrentCoordinate, StringFormat=F3}" Width="100" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Spacer between settings and motion controls -->
                        <Border Height="8" />

                        <!-- Enable -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding XIsEnabled}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ToggleButton Content="{lex:Loc Enable}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="80" Height="28" IsChecked="{Binding XIsEnabled, Mode=OneWay}" Command="{Binding XEnableCommand}"/>
                        </StackPanel>
                        
                        <!-- Up Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                  IsOn="{Binding XJogUpActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <b:InvokeCommandAction Command="{Binding XPressJogUpCommand}"/>
                                    </b:EventTrigger>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <b:InvokeCommandAction Command="{Binding XReleaseJogUpCommand}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Path Data="M30,10 L15,35 L45,35 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Middle Signal Light -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                  IsOn="{Binding XJogMiddleActive}" VerticalAlignment="Center" Margin="0,0,85,0"/>
                        </StackPanel>
                        
                        <!-- Down Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                  IsOn="{Binding XJogDownActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <b:InvokeCommandAction Command="{Binding XPressJogDownCommand}"/>
                                    </b:EventTrigger>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <b:InvokeCommandAction Command="{Binding XReleaseJogDownCommand}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Path Data="M30,35 L15,10 L45,10 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Origin -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding XIsAtOrigin}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ToggleButton Content="{lex:Loc Origin}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="80" Height="28" IsChecked="{Binding XOriginToggle, Mode=TwoWay}" Command="{Binding XOriginCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Alarm Code -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding XAlarmCode}" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    
                    <!-- Alarm Status -->
                    <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc DriverAlarm}" VerticalAlignment="Center"/>
                        <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                                              IsOn="{Binding XDriverAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc LimitAlarm}" VerticalAlignment="Center"/>
                        <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                                              IsOn="{Binding XLimitAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- Right: Axis Position Adjustment (Z-Axis) -->
            <GroupBox Grid.Column="1" Header="{lex:Loc PolishASideArm3ZAxisPositionAdjustment}" Margin="5,0,0,0" Background="White" BorderBrush="#CCCCCC">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- StandbyPosition -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc StandbyPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <controls:EditableNumericWithActions Grid.Row="0" Grid.Column="1"
                                     Value="{Binding ZStandbyPosition}"
                                     Minimum="{Binding PositionMinimum}"
                                     Maximum="{Binding PositionMaximum}"
                                     DecimalPlaces="3"
                                     Increment="0.001"
                                     IsDirty="{Binding IsZStandbyPositionDirty, Mode=OneWay}"
                                     SetCommand="{Binding ZStandbyPositionSetCommand}"
                                     CancelCommand="{Binding ZStandbyPositionCancelCommand}"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                Width="55" Height="28" Margin="5,0" IsChecked="{Binding ZStandbyPositionMoveToggle, Mode=OneWay}" Command="{Binding ZStandbyPositionMoveCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding ZStandbyPositionArrived}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    
                    <!-- PolishAPosition -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc PolishAPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <controls:EditableNumericWithActions Grid.Row="1" Grid.Column="1"
                                     Value="{Binding ZPolishAPosition}"
                                     Minimum="{Binding PositionMinimum}"
                                     Maximum="{Binding PositionMaximum}"
                                     DecimalPlaces="3"
                                     Increment="0.001"
                                     IsDirty="{Binding IsZPolishAPositionDirty, Mode=OneWay}"
                                     SetCommand="{Binding ZPolishAPositionSetCommand}"
                                     CancelCommand="{Binding ZPolishAPositionCancelCommand}"/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                Width="55" Height="28" Margin="5,0" IsChecked="{Binding ZPolishAPositionMoveToggle, Mode=OneWay}" Command="{Binding ZPolishAPositionMoveCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding ZPolishAPositionArrived}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    
                    <!-- PolishBPosition -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc PolishBPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <controls:EditableNumericWithActions Grid.Row="2" Grid.Column="1"
                                     Value="{Binding ZPolishBPosition}"
                                     Minimum="{Binding PositionMinimum}"
                                     Maximum="{Binding PositionMaximum}"
                                     DecimalPlaces="3"
                                     Increment="0.001"
                                     IsDirty="{Binding IsZPolishBPositionDirty, Mode=OneWay}"
                                     SetCommand="{Binding ZPolishBPositionSetCommand}"
                                     CancelCommand="{Binding ZPolishBPositionCancelCommand}"/>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                Width="55" Height="28" Margin="5,0" IsChecked="{Binding ZPolishBPositionMoveToggle, Mode=OneWay}" Command="{Binding ZPolishBPositionMoveCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding ZPolishBPositionArrived}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- TransferArmPosition -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{lex:Loc TransferArmPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <controls:EditableNumericWithActions Grid.Row="3" Grid.Column="1"
                                     Value="{Binding ZTransferArmPosition}"
                                     Minimum="{Binding PositionMinimum}"
                                     Maximum="{Binding PositionMaximum}"
                                     DecimalPlaces="3"
                                     Increment="0.001"
                                     IsDirty="{Binding IsZTransferArmPositionDirty, Mode=OneWay}"
                                     SetCommand="{Binding ZTransferArmPositionSetCommand}"
                                     CancelCommand="{Binding ZTransferArmPositionCancelCommand}"/>
                    <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                Width="55" Height="28" Margin="5,0" IsChecked="{Binding ZTransferArmPositionMoveToggle, Mode=OneWay}" Command="{Binding ZTransferArmPositionMoveCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding ZTransferArmPositionArrived}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- UNIFIED Right-Side Panel: Spanning all rows (0 to 6) -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="7" Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                         <!-- Row 0: JOG Speed -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="32" Margin="0,0,0,0">
                            <TextBlock Text="{lex:Loc JogSpeed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Width="100"
                                                 Value="{Binding ZJogSpeed}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsZJogSpeedDirty, Mode=OneWay}"
                                                 SetCommand="{Binding ZJogSpeedSetCommand}"
                                                 CancelCommand="{Binding ZJogSpeedCancelCommand}"/>
                        </StackPanel>
                        
                        <!-- Row 1: Auto Speed -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="32" Margin="0,0,0,0">
                            <TextBlock Text="{lex:Loc AutoSpeed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Width="100"
                                                 Value="{Binding ZAutoSpeed}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsZAutoSpeedDirty, Mode=OneWay}"
                                                 SetCommand="{Binding ZAutoSpeedSetCommand}"
                                                 CancelCommand="{Binding ZAutoSpeedCancelCommand}"/>
                        </StackPanel>

                        <!-- Row 2: Current Coordinate -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Height="32" Margin="0,0,0,0">
                            <TextBlock Text="{lex:Loc CurrentCoordinate}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ZCurrentCoordinate, StringFormat=F3}" Width="100" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Spacer between settings and motion controls -->
                        <Border Height="8" />

                        <!-- Enable -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding ZIsEnabled}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ToggleButton Content="{lex:Loc Enable}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="80" Height="28" IsChecked="{Binding ZIsEnabled, Mode=OneWay}" Command="{Binding ZEnableCommand}"/>
                        </StackPanel>
                        
                        <!-- Up Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                  IsOn="{Binding ZJogUpActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <b:InvokeCommandAction Command="{Binding ZPressJogUpCommand}"/>
                                    </b:EventTrigger>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <b:InvokeCommandAction Command="{Binding ZReleaseJogUpCommand}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Path Data="M30,10 L15,35 L45,35 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Middle Signal Light -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                  IsOn="{Binding ZJogMiddleActive}" VerticalAlignment="Center" Margin="0,0,85,0"/>
                        </StackPanel>
                        
                        <!-- Down Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                  IsOn="{Binding ZJogDownActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <b:InvokeCommandAction Command="{Binding ZPressJogDownCommand}"/>
                                    </b:EventTrigger>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <b:InvokeCommandAction Command="{Binding ZReleaseJogDownCommand}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Path Data="M30,35 L15,10 L45,10 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Origin -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding ZIsAtOrigin}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ToggleButton Content="{lex:Loc Origin}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="80" Height="28" IsChecked="{Binding ZOriginToggle, Mode=TwoWay}" Command="{Binding ZOriginCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Alarm Code -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding ZAlarmCode}" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    
                    <!-- Alarm Status -->
                    <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc DriverAlarm}" VerticalAlignment="Center"/>
                        <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                                              IsOn="{Binding ZDriverAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc LimitAlarm}" VerticalAlignment="Center"/>
                        <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                                              IsOn="{Binding ZLimitAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
        
        <!-- Bottom Status Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,5,10,10" VerticalAlignment="Top">
            <ToggleButton Content="{lex:Loc EmergencyStop}" Style="{StaticResource ToggleButtonDanger}" MinWidth="70" Height="28" Margin="0,0,10,0" IsChecked="{Binding EmergencyStopToggle, Mode=OneWay}" Command="{Binding EmergencyStopCommand}"/>
            <Button Content="{lex:Loc Alarm}" Style="{StaticResource ButtonWarning}" MinWidth="70" Height="28" Margin="0,0,10,0" Command="{Binding AlarmResetCommand}"/>
            <ToggleButton Content="{lex:Loc Save}" Style="{StaticResource ToggleButtonSuccess}" MinWidth="70" Height="28" IsChecked="{Binding SaveToggle, Mode=OneWay}" Command="{Binding SaveCommand}"/>
        </StackPanel>
            </Grid>
        </TabItem>
        
        <!-- Station Operation View (Index 1) -->
        <TabItem>
            <polishASideArm3:PolishASideArm3StationView DataContext="{Binding}"/>
        </TabItem>
    </TabControl>
</UserControl>

