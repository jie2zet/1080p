<UserControl x:Class="CMP.Views.Tabs.OperationTab.RobotControlTab.PolishASideArm3.PolishASideArm3StationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:robotControlTab="clr-namespace:CMP.ViewModels.Tabs.OperationTab.RobotControlTab"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance robotControlTab:PolishASideArm3ControlViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DesignHeight="600" d:DesignWidth="900">
    
    <Grid Background="#C8E6E6">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Grid Grid.Row="0">
            <Button Style="{StaticResource ButtonSuccess}" 
                    Width="80" Height="32" HorizontalAlignment="Left" Margin="20,0,0,0"
                    Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M6,0 L0,5 L6,10 M0,5 L10,5" Stroke="White" StrokeThickness="1.5" 
                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{lex:Loc Back}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{lex:Loc PolishASideArm3}" FontSize="20" FontWeight="Bold" 
                       Foreground="#006666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Row 1: Reset/Start/Stop + Alarm Area -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <!-- Reset -->
                <Button Content="{lex:Loc Reset}" Style="{StaticResource ButtonPrimary}" Width="60" Height="28" Command="{Binding StationResetCommand}"/>
                <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding StationIsReset}" VerticalAlignment="Center" Margin="5,0,15,0"/>
                <!-- Start -->
                <Button Content="{lex:Loc Start}" Style="{StaticResource ButtonSuccess}" Width="60" Height="28" Command="{Binding StationStartCommand}"/>
                <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding StationIsRunning}" VerticalAlignment="Center" Margin="5,0,15,0"/>
                <!-- Stop -->
                <Button Content="{lex:Loc Stop}" Style="{StaticResource ButtonDanger}" Width="60" Height="28" Command="{Binding StationStopCommand}"/>
                <controls:SignalLight Width="20" Height="20" LightColor="Red" IsOn="{Binding StationIsStopped}" VerticalAlignment="Center" Margin="5,0,30,0"/>
                
                <!-- Alarm Area -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc ModuleAlarm}" VerticalAlignment="Center" FontSize="13" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="16" Height="16" LightColor="Red" IsOn="{Binding ModuleAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc GlobalAlarm}" VerticalAlignment="Center" FontSize="13" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="16" Height="16" LightColor="Red" IsOn="{Binding GlobalAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Content="{lex:Loc AlarmReset}" Style="{StaticResource ButtonWarning}" 
                            Width="100" Height="40" FontSize="12" Command="{Binding StationAlarmResetCommand}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            
            <!-- Row 2: Operation Buttons + Status + Manual/Auto -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Operation Buttons and Status -->
                <StackPanel Grid.Column="0">
                    <!-- Pick From Polish A (从PolishA取) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding PickFromPolishAActive}" VerticalAlignment="Center"/>
                        <Button Content="{lex:Loc PickFromPolishA}" Style="{StaticResource ButtonPrimary}" Width="130" Height="28" Margin="8,0" Command="{Binding PickFromPolishACommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding PickFromPolishADone}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Pick From Polish A 2 (从PolishA取2) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding PickFromPolishA2Active}" VerticalAlignment="Center"/>
                        <Button Content="{lex:Loc PickFromPolishA2}" Style="{StaticResource ButtonPrimary}" Width="130" Height="28" Margin="8,0" Command="{Binding PickFromPolishA2Command}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding PickFromPolishA2Done}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Place To Transfer Arm (放回中转手臂) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding PlaceToTransferArmActive}" VerticalAlignment="Center"/>
                        <Button Content="{lex:Loc PlaceToTransferArm}" Style="{StaticResource ButtonPrimary}" Width="130" Height="28" Margin="8,0" Command="{Binding PlaceToTransferArmCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding PlaceToTransferArmDone}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Reserve (备用) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding ReserveActive}" VerticalAlignment="Center"/>
                        <Button Content="{lex:Loc Reserve}" Style="{StaticResource ButtonPrimary}" Width="130" Height="28" Margin="8,0" Command="{Binding ReserveCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding ReserveDone}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Right: Manual/Auto Buttons and Sensor Data -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top" extensions:StackPanelHelpers.Spacing="10">
                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                        <Button Content="{lex:Loc Manual}" Style="{StaticResource ButtonPrimary}" Width="70" Height="32" Command="{Binding ManualModeCommand}"/>
                        <Button Content="{lex:Loc Auto}" Style="{StaticResource ButtonPrimary}" Width="70" Height="32" Command="{Binding AutoModeCommand}"/>
                    </StackPanel>

                    <!-- Spacing -->
                    <Border Height="20"/>

                    <!-- Sensors -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/> <!-- Spacer -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/> <!-- New Row for PolishB Load/Unload -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/> <!-- For right side signal light -->
                        </Grid.ColumnDefinitions>
                        
                        <!-- Arm 3 Fiber 1 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc Arm3Fiber1}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="24" Height="24" LightColor="Red" IsOn="{Binding Arm3Fiber1}" VerticalAlignment="Center" Margin="0,0,0,10"/>

                        <!-- Arm 3 Fiber 2 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc Arm3Fiber2}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="24" Height="24" LightColor="Red" IsOn="{Binding Arm3Fiber2}" VerticalAlignment="Center" Margin="0,0,0,10"/>

                        <!-- Arm 3 Fiber 3 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc Arm3Fiber3}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <controls:SignalLight Grid.Row="2" Grid.Column="1" Width="24" Height="24" LightColor="Red" IsOn="{Binding Arm3Fiber3}" VerticalAlignment="Center" Margin="0,0,0,10"/>

                        <!-- Foup/Slot -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{lex:Loc FoupSlot}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <Border Grid.Row="4" Grid.Column="1" CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Background="White" Width="80" Height="30" Margin="0,0,0,10">
                            <TextBlock Text="{Binding FoupSlot}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
                        </Border>

                        <!-- Index -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{lex:Loc WaferIndex}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <Border Grid.Row="5" Grid.Column="1" CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Background="White" Width="80" Height="30" Margin="0,0,0,10">
                            <TextBlock Text="{Binding WaferIndex}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
                        </Border>


                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
