<UserControl x:Class="CMP.Views.Tabs.OperationTab.RobotControlTab.TransferModule.TransferModuleStationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:robotControlTab="clr-namespace:CMP.ViewModels.Tabs.OperationTab.RobotControlTab"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance robotControlTab:TransferModuleControlViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DesignHeight="600" d:DesignWidth="900">
    
    <UserControl.Resources>
        <Style x:Key="MoveToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DC3545"/>
                    <Setter Property="BorderBrush" Value="#DC3545"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="#C8E6E6">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Grid Grid.Row="0">
            <Button Style="{StaticResource ButtonSuccess}" 
                    Width="80" Height="32" HorizontalAlignment="Left" Margin="20,0,0,0"
                    Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M6,0 L0,5 L6,10 M0,5 L10,5" Stroke="White" StrokeThickness="1.5" 
                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{lex:Loc Back}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{lex:Loc TransferModule}" FontSize="20" FontWeight="Bold" 
                       Foreground="#006666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Row 1: Reset/Start/Stop + Alarm Area -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <!-- Reset -->
                <Button Content="{lex:Loc Reset}" Style="{StaticResource ButtonPrimary}" Width="60" Height="28" Command="{Binding StationResetCommand}"/>
                <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding StationIsReset}" VerticalAlignment="Center" Margin="5,0,15,0"/>
                <!-- Start -->
                <Button Content="{lex:Loc Start}" Style="{StaticResource ButtonSuccess}" Width="60" Height="28" Command="{Binding StationStartCommand}"/>
                <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding StationIsRunning}" VerticalAlignment="Center" Margin="5,0,15,0"/>
                <!-- Stop -->
                <Button Content="{lex:Loc Stop}" Style="{StaticResource ButtonDanger}" Width="60" Height="28" Command="{Binding StationStopCommand}"/>
                <controls:SignalLight Width="20" Height="20" LightColor="Red" IsOn="{Binding StationIsStopped}" VerticalAlignment="Center" Margin="5,0,30,0"/>
                
                <!-- Alarm Area -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc ModuleAlarm}" VerticalAlignment="Center" FontSize="13" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="16" Height="16" LightColor="Red" IsOn="{Binding ModuleAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc GlobalAlarm}" VerticalAlignment="Center" FontSize="13" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="16" Height="16" LightColor="Red" IsOn="{Binding GlobalAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Content="{lex:Loc AlarmReset}" Style="{StaticResource ButtonWarning}" 
                            Width="100" Height="40" FontSize="12" Command="{Binding StationAlarmResetCommand}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            
            <!-- Row 2: Operation Buttons + Status + Manual/Auto -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Operation Buttons and Status -->
                <StackPanel Grid.Column="0">
                    <!-- Load Operation -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding LoadOperationActive}" VerticalAlignment="Center"/>
                        <ToggleButton Content="{lex:Loc LoadOperation}" Style="{StaticResource MoveToggleButtonStyle}" Width="120" Height="28" Margin="8,0" IsChecked="{Binding LoadOperationToggle, Mode=TwoWay}" Command="{Binding LoadOperationCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding LoadOperationDone}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Unload Operation -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding UnloadOperationActive}" VerticalAlignment="Center"/>
                        <ToggleButton Content="{lex:Loc UnloadOperation}" Style="{StaticResource MoveToggleButtonStyle}" Width="120" Height="28" Margin="8,0" IsChecked="{Binding UnloadOperationToggle, Mode=TwoWay}" Command="{Binding UnloadOperationCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding UnloadOperationDone}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="8,0,0,10">
                        <TextBlock Text="{lex:Loc LoadInduction}" Width="120" VerticalAlignment="Center"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding LoadInduction}" VerticalAlignment="Center" Margin="8,0,18,0"/>
                        <TextBlock Text="{lex:Loc UnloadInduction}" Width="120" VerticalAlignment="Center"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding UnloadInduction}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    
                    <!-- Door Control Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <ToggleButton Content="{lex:Loc LoadDoorOpen}" Style="{StaticResource MoveToggleButtonStyle}" Width="120" Height="28" Margin="28,0,8,0" IsChecked="{Binding LoadDoorOpenToggle, Mode=TwoWay}" Command="{Binding LoadDoorOpenCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding LoadDoorOpenDone}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <ToggleButton Content="{lex:Loc LoadDoorClose}" Style="{StaticResource MoveToggleButtonStyle}" Width="120" Height="28" Margin="28,0,8,0" IsChecked="{Binding LoadDoorCloseToggle, Mode=TwoWay}" Command="{Binding LoadDoorCloseCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding LoadDoorCloseDone}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <ToggleButton Content="{lex:Loc SideDoorOpen}" Style="{StaticResource MoveToggleButtonStyle}" Width="120" Height="28" Margin="28,0,8,0" IsChecked="{Binding SideDoorOpenToggle, Mode=TwoWay}" Command="{Binding SideDoorOpenCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding SideDoorOpenDone}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <ToggleButton Content="{lex:Loc SideDoorClose}" Style="{StaticResource MoveToggleButtonStyle}" Width="120" Height="28" Margin="28,0,8,0" IsChecked="{Binding SideDoorCloseToggle, Mode=TwoWay}" Command="{Binding SideDoorCloseCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding SideDoorCloseDone}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <ToggleButton Content="{lex:Loc UnloadDoorOpen}" Style="{StaticResource MoveToggleButtonStyle}" Width="120" Height="28" Margin="28,0,8,0" IsChecked="{Binding UnloadDoorOpenToggle, Mode=TwoWay}" Command="{Binding UnloadDoorOpenCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding UnloadDoorOpenDone}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <ToggleButton Content="{lex:Loc UnloadDoorClose}" Style="{StaticResource MoveToggleButtonStyle}" Width="120" Height="28" Margin="28,0,8,0" IsChecked="{Binding UnloadDoorCloseToggle, Mode=TwoWay}" Command="{Binding UnloadDoorCloseCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding UnloadDoorCloseDone}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Right: Manual/Auto Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" extensions:StackPanelHelpers.Spacing="10">
                    <ToggleButton Content="{lex:Loc Manual}" Style="{StaticResource MoveToggleButtonStyle}" Width="70" Height="32" IsChecked="{Binding ManualModeToggle, Mode=OneWay}" Command="{Binding ManualModeCommand}"/>
                    <ToggleButton Content="{lex:Loc Auto}" Style="{StaticResource MoveToggleButtonStyle}" Width="70" Height="32" IsChecked="{Binding AutoModeToggle, Mode=OneWay}" Command="{Binding AutoModeCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
