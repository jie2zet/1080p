<UserControl x:Class="CMP.Views.Tabs.OperationTab.RobotControlTab.TransferModule.TransferModuleControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewModel="clr-namespace:CMP.ViewModels.Tabs.OperationTab.RobotControlTab"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:transferModule="clr-namespace:CMP.Views.Tabs.OperationTab.RobotControlTab.TransferModule"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModel:TransferModuleControlViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="600">
    
    <UserControl.Resources>
        <Style x:Key="HiddenTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="MoveToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DC3545"/>
                    <Setter Property="BorderBrush" Value="#DC3545"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ToggleButtonSuccess" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1E7E34"/>
                    <Setter Property="BorderBrush" Value="#1C7430"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                    <Setter Property="BorderBrush" Value="#1E7E34"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ToggleButtonWarning" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D39E00"/>
                    <Setter Property="BorderBrush" Value="#C69500"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                    <Setter Property="BorderBrush" Value="#D39E00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ToggleButtonDanger" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#BD2130"/>
                    <Setter Property="BorderBrush" Value="#B21F2D"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <TabControl Style="{StaticResource HiddenTabControlStyle}" SelectedIndex="{Binding CurrentViewIndex}">
        <!-- Main View (Index 0) -->
        <TabItem>
            <Grid Background="#E8E8E8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Title Bar -->
                <Grid Grid.Row="0" Margin="10,10,10,5">
                    <TextBlock Text="{lex:Loc TransferModuleAndPosition}" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc StationOperation}" Style="{StaticResource ButtonSuccess}" 
                            MinWidth="80" Height="30" Padding="10,5"
                            HorizontalAlignment="Right" Command="{Binding StationOperationCommand}"/>
                </Grid>

                <!-- Main Content Area -->
                <Grid Grid.Row="1" Margin="10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Axis Position Adjustment -->
                    <GroupBox Grid.Column="0" Header="{lex:Loc AxisPositionAdjustment}" Margin="0,0,5,0" Background="White" BorderBrush="#CCCCCC">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- LoadPosition -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc LoadPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <controls:EditableNumericWithActions Grid.Row="0" Grid.Column="1"
                                                 Value="{Binding LoadPosition}"
                                                 Minimum="{Binding PositionMinimum}"
                                                 Maximum="{Binding PositionMaximum}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsLoadPositionDirty, Mode=OneWay}"
                                                 SetCommand="{Binding LoadPositionSetCommand}"
                                                 CancelCommand="{Binding LoadPositionCancelCommand}"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                Width="55" Height="28" Margin="5,0" IsChecked="{Binding LoadPositionMoveToggle, Mode=OneWay}" Command="{Binding LoadPositionMoveCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding LoadPositionArrived}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                     
                    <!-- JOG Speed -->
                    <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{lex:Loc JogSpeed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <controls:EditableNumericWithActions Width="100"
                                                 Value="{Binding JogSpeed}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsJogSpeedDirty, Mode=OneWay}"
                                                 SetCommand="{Binding JogSpeedSetCommand}"
                                                 CancelCommand="{Binding JogSpeedCancelCommand}"/>
                    </StackPanel>
                    
                    <!-- UnloadPosition -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc UnloadPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <controls:EditableNumericWithActions Grid.Row="1" Grid.Column="1"
                                                 Value="{Binding UnloadPosition}"
                                                 Minimum="{Binding PositionMinimum}"
                                                 Maximum="{Binding PositionMaximum}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsUnloadPositionDirty, Mode=OneWay}"
                                                 SetCommand="{Binding UnloadPositionSetCommand}"
                                                 CancelCommand="{Binding UnloadPositionCancelCommand}"/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                Width="55" Height="28" Margin="5,0" IsChecked="{Binding UnloadPositionMoveToggle, Mode=OneWay}" Command="{Binding UnloadPositionMoveCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding UnloadPositionArrived}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    
                    <!-- Auto Speed -->
                    <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{lex:Loc AutoSpeed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <controls:EditableNumericWithActions Width="100"
                                                 Value="{Binding AutoSpeed}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsAutoSpeedDirty, Mode=OneWay}"
                                                 SetCommand="{Binding AutoSpeedSetCommand}"
                                                 CancelCommand="{Binding AutoSpeedCancelCommand}"/>
                    </StackPanel>
                    
                    <!-- SparePosition -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc SparePosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <controls:EditableNumericWithActions Grid.Row="2" Grid.Column="1"
                                                 Value="{Binding SparePosition}"
                                                 Minimum="{Binding PositionMinimum}"
                                                 Maximum="{Binding PositionMaximum}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsSparePositionDirty, Mode=OneWay}"
                                                 SetCommand="{Binding SparePositionSetCommand}"
                                                 CancelCommand="{Binding SparePositionCancelCommand}"/>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                Width="55" Height="28" Margin="5,0" IsChecked="{Binding SparePositionMoveToggle, Mode=OneWay}" Command="{Binding SparePositionMoveCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding SparePositionArrived}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    
                    <!-- Current Coordinate -->
                    <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{lex:Loc CurrentCoordinate}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding CurrentCoordinate, StringFormat=F3}" Width="100" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 鍙充晶鎺у埗鍖猴細Enable銆佷笂绠ご銆佷腑闂翠俊鍙风伅銆佷笅绠ご銆丱rigin 鍨傜洿鎺掑垪 -->
                    <StackPanel Grid.Row="3" Grid.RowSpan="2" Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0">
                        <!-- Enable -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ToggleButton Content="{lex:Loc Enable}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="80" Height="28" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding EnableCommand}"/>
                        </StackPanel>
                        
                        <!-- Up Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                  IsOn="{Binding JogUpActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <b:InvokeCommandAction Command="{Binding PressJogUpCommand}"/>
                                    </b:EventTrigger>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <b:InvokeCommandAction Command="{Binding ReleaseJogUpCommand}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Path Data="M30,10 L15,35 L45,35 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Middle Signal Light -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                  IsOn="{Binding JogMiddleActive}" VerticalAlignment="Center" Margin="0,0,85,0"/>
                        </StackPanel>
                        
                        <!-- Down Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                  IsOn="{Binding JogDownActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <b:InvokeCommandAction Command="{Binding PressJogDownCommand}"/>
                                    </b:EventTrigger>
                                    <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <b:InvokeCommandAction Command="{Binding ReleaseJogDownCommand}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Path Data="M30,35 L15,10 L45,10 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Origin -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding IsAtOrigin}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ToggleButton Content="{lex:Loc Origin}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="80" Height="28" IsChecked="{Binding OriginToggle, Mode=TwoWay}" Command="{Binding OriginCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Alarm Code -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding AlarmCode}" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    
                    <!-- Alarm Status -->
                    <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc DriverAlarm}" VerticalAlignment="Center"/>
                        <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                                              IsOn="{Binding DriverAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc LimitAlarm}" VerticalAlignment="Center"/>
                        <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                                              IsOn="{Binding LimitAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </GroupBox>
            
            <!-- Right: Empty space (Station Operation is on separate page) -->
            <Grid Grid.Column="1" Margin="5,0,0,0">
                <!-- Intentionally left empty -->
            </Grid>
        </Grid>
        
        <!-- Bottom Status Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,5,10,10" VerticalAlignment="Top">
            <ToggleButton Content="{lex:Loc EmergencyStop}" Style="{StaticResource ToggleButtonDanger}" MinWidth="70" Height="28" Margin="0,0,10,0" IsChecked="{Binding EmergencyStopToggle, Mode=OneWay}" Command="{Binding EmergencyStopCommand}"/>
            <ToggleButton Content="{lex:Loc Alarm}" Style="{StaticResource ToggleButtonWarning}" MinWidth="70" Height="28" Margin="0,0,10,0" IsChecked="{Binding AlarmResetToggle, Mode=OneWay}" Command="{Binding AlarmResetCommand}"/>
            <ToggleButton Content="{lex:Loc Save}" Style="{StaticResource ToggleButtonSuccess}" MinWidth="70" Height="28" IsChecked="{Binding SaveToggle, Mode=OneWay}" Command="{Binding SaveCommand}"/>
        </StackPanel>
            </Grid>
        </TabItem>
        
        <!-- Station Operation View (Index 1) -->
        <TabItem>
            <transferModule:TransferModuleStationView DataContext="{Binding}"/>
        </TabItem>
    </TabControl>
</UserControl>

