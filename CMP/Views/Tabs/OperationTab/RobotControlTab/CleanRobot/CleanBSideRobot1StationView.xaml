<UserControl x:Class="CMP.Views.Tabs.OperationTab.RobotControlTab.CleanRobot.CleanBSideRobot1StationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:robotControlTab="clr-namespace:CMP.ViewModels.Tabs.OperationTab.RobotControlTab.CleanRobot"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance robotControlTab:CleanBSideRobot1ViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DesignHeight="600" d:DesignWidth="900">
    
    <UserControl.Resources>
        <Style x:Key="MoveToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DC3545"/>
                    <Setter Property="BorderBrush" Value="#DC3545"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="#C8E6E6">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Grid Grid.Row="0">
            <Button Style="{StaticResource ButtonSuccess}" 
                    Width="80" Height="32" HorizontalAlignment="Left" Margin="20,0,0,0"
                    Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M6,0 L0,5 L6,10 M0,5 L10,5" Stroke="White" StrokeThickness="1.5" 
                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{lex:Loc Back}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{lex:Loc CleanARobot2}" FontSize="20" FontWeight="Bold" 
                       Foreground="#006666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Row 1: Reset/Start/Stop + Alarm Area -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <!-- Reset -->
                <Button Content="{lex:Loc Reset}" Style="{StaticResource ButtonPrimary}" Width="60" Height="28" Command="{Binding StationResetCommand}"/>
                <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding StationIsReset}" VerticalAlignment="Center" Margin="5,0,15,0"/>
                <!-- Start -->
                <Button Content="{lex:Loc Start}" Style="{StaticResource ButtonSuccess}" Width="60" Height="28" Command="{Binding StationStartCommand}"/>
                <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding StationIsRunning}" VerticalAlignment="Center" Margin="5,0,15,0"/>
                <!-- Stop -->
                <Button Content="{lex:Loc Stop}" Style="{StaticResource ButtonDanger}" Width="60" Height="28" Command="{Binding StationStopCommand}"/>
                <controls:SignalLight Width="20" Height="20" LightColor="Red" IsOn="{Binding StationIsStopped}" VerticalAlignment="Center" Margin="5,0,30,0"/>
                
                <!-- Alarm Area -->
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc ModuleAlarm}" VerticalAlignment="Center" FontSize="13" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="16" Height="16" LightColor="Red" IsOn="{Binding ModuleAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc GlobalAlarm}" VerticalAlignment="Center" FontSize="13" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="16" Height="16" LightColor="Red" IsOn="{Binding GlobalAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Content="{lex:Loc AlarmReset}" Style="{StaticResource ButtonWarning}" 
                            Width="100" Height="40" FontSize="12" Command="{Binding StationAlarmResetCommand}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            
            <!-- Row 2: Operation Buttons + Status + Manual/Auto -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Operation Buttons and Status -->
                <StackPanel Grid.Column="0">
                    <!-- PickFromRoller1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding PickFromRoller1Active}" VerticalAlignment="Center"/>
                        <ToggleButton Content="{lex:Loc PickFromRoller1}" Style="{StaticResource MoveToggleButtonStyle}" Width="130" Height="28" Margin="8,0" IsChecked="{Binding PickFromRoller1Toggle, Mode=TwoWay}" Command="{Binding PickFromRoller1Command}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding PickFromRoller1Done}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- PickFromRoller2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding PickFromRoller2Active}" VerticalAlignment="Center"/>
                        <ToggleButton Content="{lex:Loc PickFromRoller2}" Style="{StaticResource MoveToggleButtonStyle}" Width="130" Height="28" Margin="8,0" IsChecked="{Binding PickFromRoller2Toggle, Mode=TwoWay}" Command="{Binding PickFromRoller2Command}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding PickFromRoller2Done}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- PlaceToRoller3 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding PlaceToRoller3Active}" VerticalAlignment="Center"/>
                        <ToggleButton Content="{lex:Loc PlaceToRoller3}" Style="{StaticResource MoveToggleButtonStyle}" Width="130" Height="28" Margin="8,0" IsChecked="{Binding PlaceToRoller3Toggle, Mode=TwoWay}" Command="{Binding PlaceToRoller3Command}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding PlaceToRoller3Done}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- PickFromRoller3 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding PickFromRoller3Active}" VerticalAlignment="Center"/>
                        <ToggleButton Content="{lex:Loc PickFromRoller3}" Style="{StaticResource MoveToggleButtonStyle}" Width="130" Height="28" Margin="8,0" IsChecked="{Binding PickFromRoller3Toggle, Mode=TwoWay}" Command="{Binding PickFromRoller3Command}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding PickFromRoller3Done}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- PlaceToPen1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding PlaceToPen1Active}" VerticalAlignment="Center"/>
                        <ToggleButton Content="{lex:Loc PlaceToPen1}" Style="{StaticResource MoveToggleButtonStyle}" Width="130" Height="28" Margin="8,0" IsChecked="{Binding PlaceToPen1Toggle, Mode=TwoWay}" Command="{Binding PlaceToPen1Command}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding PlaceToPen1Done}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- PlaceToRollerB2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding PlaceToRollerB2Active}" VerticalAlignment="Center"/>
                        <ToggleButton Content="{lex:Loc PlaceToRollerB2}" Style="{StaticResource MoveToggleButtonStyle}" Width="130" Height="28" Margin="8,0" IsChecked="{Binding PlaceToRollerB2Toggle, Mode=TwoWay}" Command="{Binding PlaceToRollerB2Command}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding PlaceToRollerB2Done}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Right: Manual/Auto Buttons and Sensor Data -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top" extensions:StackPanelHelpers.Spacing="10">
                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                        <ToggleButton Content="{lex:Loc Manual}" Style="{StaticResource MoveToggleButtonStyle}" Width="70" Height="32" IsChecked="{Binding StationManualModeToggle, Mode=OneWay}" Command="{Binding StationManualModeCommand}"/>
                        <ToggleButton Content="{lex:Loc Auto}" Style="{StaticResource MoveToggleButtonStyle}" Width="70" Height="32" IsChecked="{Binding StationAutoModeToggle, Mode=OneWay}" Command="{Binding StationAutoModeCommand}"/>
                    </StackPanel>

                    <!-- Spacing -->
                    <Border Height="20"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
