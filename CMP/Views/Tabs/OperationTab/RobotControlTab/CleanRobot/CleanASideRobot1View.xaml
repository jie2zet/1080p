<UserControl x:Class="CMP.Views.Tabs.OperationTab.RobotControlTab.CleanRobot.CleanASideRobot1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMP.Views.Tabs.OperationTab.RobotControlTab.CleanRobot"
             mc:Ignorable="d" 
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewModel="clr-namespace:CMP.ViewModels.Tabs.OperationTab.RobotControlTab.CleanRobot"
             xmlns:extension="clr-namespace:Core.Controls.Extensions;assembly=Core"
             xmlns:controls="clr-namespace:CMP.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModel:CleanASideRobot1ViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DesignHeight="600" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="HiddenTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton 样式：未选中时为 Primary，选中时为 Danger -->
        <Style x:Key="MoveToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DC3545"/>
                    <Setter Property="BorderBrush" Value="#DC3545"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- 绿色 ToggleButton 样式 (Start/Success) -->
        <Style x:Key="ToggleButtonSuccess" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1E7E34"/>
                    <Setter Property="BorderBrush" Value="#1C7430"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                    <Setter Property="BorderBrush" Value="#1E7E34"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 黄色 ToggleButton 样式 (Pause/Warning) -->
        <Style x:Key="ToggleButtonWarning" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D39E00"/>
                    <Setter Property="BorderBrush" Value="#C69500"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                    <Setter Property="BorderBrush" Value="#D39E00"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 红色 ToggleButton 样式 (Stop/Danger) -->
        <Style x:Key="ToggleButtonDanger" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#BD2130"/>
                    <Setter Property="BorderBrush" Value="#B21F2D"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <TabControl Style="{StaticResource HiddenTabControlStyle}" SelectedIndex="{Binding CurrentViewIndex}">
        <TabItem>
            <Grid extension:GridHelpers.RowDefinitions="auto,auto,auto" Background="#E8E8E8">
                <Grid  Grid.Row="0" Margin="10,10">
                    <TextBlock Text="{lex:Loc CleanASideRobot1}" FontSize="16" FontWeight="Bold" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button Content="{lex:Loc StationOperation}" Style="{StaticResource ButtonSuccess}"
                MinWidth="80" Height="30"
                HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding StationOperationCommand}"/>
                </Grid>

                <Grid Grid.Row="1" extension:GridHelpers.ColumnDefinitions="*,*" extension:GridHelpers.RowDefinitions="9*,*">
                    <GroupBox Grid.Column="0" Header="{lex:Loc AxisPositionAdjustment}" Background="White" Margin="10" BorderBrush="#CCCCCC">
                        <Grid extension:GridHelpers.ColumnDefinitions="auto,100,auto,auto,*" extension:GridHelpers.RowDefinitions="32,32,32,32,32,32,32,auto,auto">
                            <!-- RollerA1/A2 position -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc RollerA1orA2}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <controls:EditableNumericWithActions Grid.Row="0" Grid.Column="1"
                                Value="{Binding RollerA1orA2Position}"
                                Minimum="{Binding PositionMinimum}"
                                Maximum="{Binding PositionMaximum}"
                                DecimalPlaces="3"
                                Increment="0.001"
                                IsDirty="{Binding IsRollerA1orA2PositionDirty, Mode=OneWay}"
                                SetCommand="{Binding RollerA1orA2PositionSetCommand}"
                                CancelCommand="{Binding RollerA1orA2PositionCancelCommand}"/>
                            <ToggleButton Grid.Row="0" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                 Width="55" Height="28" Margin="5,0" IsChecked="{Binding RollerA1orA2MoveToggle, Mode=OneWay}" Command="{Binding RollerA1orA2MoveCommand}"/>
                            <!-- JOG Speed -->
                            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{lex:Loc JogSpeed}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <controls:EditableNumericWithActions Width="100"
                                    Value="{Binding JogSpeed}"
                                    DecimalPlaces="3"
                                    Increment="0.001"
                                    IsDirty="{Binding IsJogSpeedDirty, Mode=OneWay}"
                                    SetCommand="{Binding JogSpeedSetCommand}"
                                    CancelCommand="{Binding JogSpeedCancelCommand}"/>
                            </StackPanel>

                            <!-- RollerA3 Position -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc RollerA3}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <controls:EditableNumericWithActions Grid.Row="1" Grid.Column="1"
                                Value="{Binding RollerA3Position}"
                                Minimum="{Binding PositionMinimum}"
                                Maximum="{Binding PositionMaximum}"
                                DecimalPlaces="3"
                                Increment="0.001"
                                IsDirty="{Binding IsRollerA3PositionDirty, Mode=OneWay}"
                                SetCommand="{Binding RollerA3PositionSetCommand}"
                                CancelCommand="{Binding RollerA3PositionCancelCommand}"/>
                            <ToggleButton Grid.Row="1" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                              Width="55" Height="28" Margin="5,0" IsChecked="{Binding RollerA3MoveToggle, Mode=OneWay}" Command="{Binding RollerA3MoveCommand}"/>
                            <!-- Auto Speed -->
                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{lex:Loc AutoSpeed}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <controls:EditableNumericWithActions Width="100"
                                    Value="{Binding AutoSpeed}"
                                    DecimalPlaces="3"
                                    Increment="0.001"
                                    IsDirty="{Binding IsAutoSpeedDirty, Mode=OneWay}"
                                    SetCommand="{Binding AutoSpeedSetCommand}"
                                    CancelCommand="{Binding AutoSpeedCancelCommand}"/>
                            </StackPanel>

                            <!-- Pen A1 Position -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc PenA1}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <controls:EditableNumericWithActions Grid.Row="2" Grid.Column="1"
                                Value="{Binding PenA1Position}"
                                Minimum="{Binding PositionMinimum}"
                                Maximum="{Binding PositionMaximum}"
                                DecimalPlaces="3"
                                Increment="0.001"
                                IsDirty="{Binding IsPenA1PositionDirty, Mode=OneWay}"
                                SetCommand="{Binding PenA1PositionSetCommand}"
                                CancelCommand="{Binding PenA1PositionCancelCommand}"/>
                            <ToggleButton Grid.Row="2" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
          Width="55" Height="28" Margin="5,0" IsChecked="{Binding PenA1MoveToggle,Mode=OneWay}" Command="{Binding PenA1MoveCommand}"/>
                            <!-- Current Coordinate -->
                            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{lex:Loc CurrentCoordinate}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <Border BorderBrush="#CCCCCC" BorderThickness="1" Height="30">
                                    <TextBlock Text="{Binding CurrentCoordinate, StringFormat=F3}" 
                                   Width="98" VerticalAlignment="Center" Padding="6,0,0,0"/>
                                </Border>
                            </StackPanel>

                            <!-- Alarm Code -->
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" Grid.Row="7" Grid.Column="0" Margin="5,0,0,5" Height="30">
                                <TextBlock  Text="{Binding AlarmCode}" VerticalAlignment="Center" Padding="6,0,0,0"/>
                            </Border>

                            <!--Alarm Status-->
                            <Grid Grid.Row="8" Grid.Column="0" Margin="5,0,0,0"
                      extension:GridHelpers.RowDefinitions="24,24"
                      extension:GridHelpers.ColumnDefinitions="auto,24,auto">

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc DriverAlarm}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                  IsOn="{Binding DriverAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc LimitAlarm}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                  IsOn="{Binding LimitAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Enable and Jog Up/Down Buttons with Signal Lights -->
                            <StackPanel Grid.Row="3" Grid.Column="4" Grid.RowSpan="5" 
                            Orientation="Vertical" HorizontalAlignment="Right" Margin="0,10,10,0">
                                <!-- Enable -->
                                <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal" 
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,10,10">
                                    <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding IsEnabled}" Margin="0,0,5,0"/>
                                    <ToggleButton Content="{lex:Loc Enable}" Style="{StaticResource MoveToggleButtonStyle}" 
                                     Width="80" Height="36" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding EnableCommand}"/>
                                </StackPanel>

                                <!-- Up Button with Signal Light -->
                                <StackPanel Orientation="Horizontal">
                                    <controls:SignalLight Width="20" Height="20" IsOn="{Binding JogUpActive}" LightColor="Blue" Margin="0,0,5,0"/>
                                    <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                <b:InvokeCommandAction Command="{Binding PressJogUpCommand}"/>
                                            </b:EventTrigger>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                <b:InvokeCommandAction Command="{Binding ReleaseJogUpCommand}"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                        <Path Data="M30,10 L15,35 L45,35 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                                    </Button>

                                </StackPanel>

                                <!-- Middle Signal Light -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                                    <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                      IsOn="{Binding JogMiddleActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                </StackPanel>

                                <!-- Down Button with Signal Light -->
                                <StackPanel Orientation="Horizontal">
                                    <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                      IsOn="{Binding JogDownActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                <b:InvokeCommandAction Command="{Binding PressJogDownCommand}"/>
                                            </b:EventTrigger>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                <b:InvokeCommandAction Command="{Binding ReleaseJogDownCommand}"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                        <Path Data="M30,35 L15,10 L45,10 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="{lex:Loc RobotControl}" Background="White" Margin="10" BorderBrush="#CCCCCC">
                        <Grid extension:GridHelpers.RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto,auto"
                  extension:GridHelpers.ColumnDefinitions="auto,auto,auto,*">
                            <!-- Program Number -->
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5,0,0,10">
                                <TextBlock Text="{lex:Loc ProgramNumber}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding ProgramNumber}" Width="90" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!--Start, Pause, Stop, Reset -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="5,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <Button Content="{lex:Loc Start}" Style="{StaticResource ButtonSuccess}" MinWidth="50" Height="28" Margin="0,0,10,0" Command="{Binding StartCommand}"/>
                                    <controls:SignalLight IsBreathing="True" Width="18" Height="18" LightColor="Green" IsOn="{Binding IsRunning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <ToggleButton Content="{lex:Loc Pause}" Style="{StaticResource ToggleButtonWarning}" MinWidth="50" Height="28" Margin="0,0,10,0" IsChecked="{Binding PauseToggle}" Command="{Binding PauseCommand}"/>
                                    <controls:SignalLight Width="18" Height="18" LightColor="Yellow" IsOn="{Binding IsPaused}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <Button Content="{lex:Loc Stop}" Style="{StaticResource ButtonDanger}" MinWidth="50" Height="28" Margin="0,0,10,0" Command="{Binding StopCommand}"/>
                                    <controls:SignalLight Width="18" Height="18" LightColor="Red" IsOn="{Binding IsStopped}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <Button Content="{lex:Loc Reset}" Style="{StaticResource ButtonPrimary}" MinWidth="50" Height="28" Margin="0,0,10,0" Command="{Binding ResetCommand}"/>
                                    <controls:SignalLight Width="18" Height="18" LightColor="Blue" IsOn="{Binding IsReset}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!--Work Area Number -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5,10,0,10">
                                <TextBlock Text="{lex:Loc WorkAreaNumber}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding WorkAreaNumber}" Width="90" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!--Roller and PenA1-->
                            <Button Grid.Row="3" Content="{lex:Loc RollerA1}" Foreground="Black" Width="100" Margin="5,0,0,10" Background="#80DDFF" HorizontalAlignment="Left" Command="{Binding RollerA1_1Command}"/>
                            <Button Grid.Row="4" Content="{lex:Loc RollerA1}" Foreground="Black" Width="100" Margin="5,0,0,10" Background="#80DDFF" HorizontalAlignment="Left" Command="{Binding RollerA1_2Command}"/>
                            <Button Grid.Row="5" Content="{lex:Loc RollerA3}" Foreground="Black" Width="100" Margin="5,0,0,10" Background="#80DDFF" HorizontalAlignment="Left" Command="{Binding RollerA3Command}"/>
                            <Button Grid.Row="6" Content="{lex:Loc PenA1}" Foreground="Black" Width="100" Margin="5,0,0,10" Background="#80DDFF" HorizontalAlignment="Left" Command="{Binding PenA1Command}"/>

                            <!--Work Area-->
                            <StackPanel Grid.Column="1" Grid.Row="3" Grid.RowSpan="4" Orientation="Vertical" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="5,10">
                                    <ToggleButton Grid.Row="0" Grid.Column="1" Content="{lex:Loc WorkAreaPickup}" Style="{StaticResource MoveToggleButtonStyle}" 
    Width="140" Height="28" IsChecked="{Binding WorkAreaPickupToggle}" Margin="0,0,10,0" Command="{Binding WorkAreaPickupCommand}"/>
                                    <controls:SignalLight Grid.Row="0" Grid.Column="2" Width="18" Height="18" LightColor="Blue" 
                  IsOn="{Binding WorkAreaPickupStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="5,10">
                                    <ToggleButton Grid.Row="1" Grid.Column="1" Content="{lex:Loc WorkAreaPlace}" Style="{StaticResource MoveToggleButtonStyle}" 
    Width="140" Height="28" IsChecked="{Binding WorkAreaPlaceToggle}" Margin="0,0,10,0" Command="{Binding WorkAreaPlaceCommand}"/>
                                    <controls:SignalLight Grid.Row="1" Grid.Column="2" Width="18" Height="18" LightColor="Blue" 
                  IsOn="{Binding WorkAreaPlaceStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="5,10">
                                    <ToggleButton Grid.Row="2" Grid.Column="1" Content="{lex:Loc WaitConfirm}" Style="{StaticResource MoveToggleButtonStyle}" 
    Width="140" Height="28" IsChecked="{Binding WaitConfirmToggle}" Margin="0,0,10,0" Command="{Binding WaitConfirmCommand}"/>
                                    <controls:SignalLight Grid.Row="2" Grid.Column="2" Width="18" Height="18" LightColor="Blue" 
                  IsOn="{Binding WaitConfirmStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!--Auto Mode、Use Upper Arm、Use Lower Arm-->
                            <StackPanel Grid.Column="3" Grid.Row="3" Grid.RowSpan="4" Orientation="Vertical" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Margin="5,10">
                                    <ToggleButton Grid.Row="0" Grid.Column="4" Content="{lex:Loc AutoMode}" Style="{StaticResource MoveToggleButtonStyle}" 
    Width="140" Height="28" IsChecked="{Binding AutoModeToggle}" Margin="0,0,10,0" Command="{Binding AutoModeCommand}"/>
                                    <controls:SignalLight Grid.Row="0" Grid.Column="5" Width="18" Height="18" LightColor="Green" 
                  IsOn="{Binding AutoModeStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="5,10">
                                    <ToggleButton Grid.Row="1" Grid.Column="4" Content="{lex:Loc UseUpperArm}" Style="{StaticResource MoveToggleButtonStyle}" 
    Width="140" Height="28" IsChecked="{Binding UseUpperArmToggle}" Margin="0,0,10,0" Command="{Binding UseUpperArmCommand}"/>
                                    <controls:SignalLight Grid.Row="1" Grid.Column="5" Width="18" Height="18" LightColor="Green" 
                  IsOn="{Binding UseUpperArmStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="5,10">
                                    <ToggleButton Grid.Row="2" Grid.Column="4" Content="{lex:Loc UseLowerArm}" Style="{StaticResource MoveToggleButtonStyle}" 
    Width="140" Height="28" IsChecked="{Binding UseLowerArmToggle}" Margin="0,0,10,0" Command="{Binding UseLowerArmCommand}"/>
                                    <controls:SignalLight Grid.Row="2" Grid.Column="5" Width="18" Height="18" LightColor="Green" 
                  IsOn="{Binding UseLowerArmStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!--Confirm Switch-->
                            <StackPanel Grid.Row="7" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,5,0">
                                <ToggleButton Grid.Column="0" Content="{lex:Loc ConfirmSwitch}" Style="{StaticResource MoveToggleButtonStyle}" 
    Width="140" Height="28" IsChecked="{Binding ConfirmSwitchToggle}" Margin="0,0,10,0" Command="{Binding ConfirmSwitchCommand}"/>
                                <controls:SignalLight Grid.Column="1" Width="18" Height="18" LightColor="Green" 
                  IsOn="{Binding ConfirmSwitchStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!--Upper Arm Sensor, Command Accepted-->
                            <StackPanel Grid.Row="8" Margin="5,5,0,5" Orientation="Horizontal" Grid.ColumnSpan="3">
                                <TextBlock Text="{lex:Loc UpperArmSensor}" VerticalAlignment="Center" Margin="5"/>
                                <controls:SignalLight Width="18" Height="18" LightColor="Blue" 
                  IsOn="{Binding UpperArmSensor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{lex:Loc CommandAccepted}" VerticalAlignment="Center" Margin="5"/>
                                <controls:SignalLight Width="18" Height="18" LightColor="Green" 
                  IsOn="{Binding CommandAccepted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!--Lower Arm Sensor, -->
                            <StackPanel Grid.Row="9" Margin="5,5,0,0" Orientation="Horizontal" Grid.ColumnSpan="3">
                                <TextBlock Text="{lex:Loc LowerArmSensor}" VerticalAlignment="Center" Margin="5"/>
                                <controls:SignalLight Width="18" Height="18" LightColor="Blue" 
                      IsOn="{Binding LowerArmSensor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{lex:Loc RobotSafePosition1}" VerticalAlignment="Center" Margin="5"/>
                                <controls:SignalLight Width="18" Height="18" LightColor="Green" 
                      IsOn="{Binding RobotSafePosition1}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!--Robot Safe Position-->
                            <ToggleButton Grid.Row="8" Grid.Column="3" Grid.RowSpan="2" Content="{lex:Loc RobotSafePosition}" Margin="20,0,0,0" 
                              Style="{StaticResource MoveToggleButtonStyle}" Width="140" Height="28" IsChecked="{Binding RobotSafePositionToggle}"/>
                        </Grid>
                    </GroupBox>

                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,30,0">
                        <ToggleButton Content="{lex:Loc Origin}" FontSize="17" Margin="0,0,10,0" Height="43" Style="{StaticResource MoveToggleButtonStyle}"  IsChecked="{Binding OriginToggle, Mode=TwoWay}" Command="{Binding OrignCommand}"/>
                        <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding IsAtOrigin, Mode=OneWay}" Margin="0,0,5,0"/>
                    </StackPanel>

                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,5" VerticalAlignment="Center">
                    <ToggleButton Content="{lex:Loc EmergencyStop}" Style="{StaticResource ToggleButtonDanger}" MinWidth="70" Height="28" Margin="0,0,10,0" IsChecked="{Binding EmergencyStopToggle, Mode=OneWay}" Command="{Binding EmergencyCommand}"/>
                    <ToggleButton Content="{lex:Loc Alarm}" Style="{StaticResource ToggleButtonWarning}" MinWidth="70" Height="28" Margin="0,0,10,0" IsChecked="{Binding AlarmResetToggle, Mode=OneWay}" Command="{Binding AlarmResetCommand}"/>
                    <ToggleButton Content="{lex:Loc Save}" Style="{StaticResource ToggleButtonSuccess}" MinWidth="70" Height="28" IsChecked="{Binding SaveToggle,Mode=OneWay}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </TabItem>
        
        <TabItem>
            <local:CleanASideRobot1StationView  DataContext="{Binding}"/>
        </TabItem>
    </TabControl>

</UserControl>

