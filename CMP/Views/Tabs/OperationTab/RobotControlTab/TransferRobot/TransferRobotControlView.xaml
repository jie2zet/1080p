<UserControl x:Class="CMP.Views.Tabs.OperationTab.RobotControlTab.TransferRobot.TransferRobotControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewModel="clr-namespace:CMP.ViewModels.Tabs.OperationTab.RobotControlTab"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:local="clr-namespace:CMP.Views.Tabs.OperationTab.RobotControlTab.TransferRobot"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModel:TransferRobotControlViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <UserControl.Resources>
        <Style x:Key="HiddenTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- ToggleButton Style: Unchecked Primary, Checked Danger -->
        <Style x:Key="MoveToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DC3545"/>
                    <Setter Property="BorderBrush" Value="#DC3545"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Green ToggleButton Style (Start/Success) -->
        <Style x:Key="ToggleButtonSuccess" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1E7E34"/>
                    <Setter Property="BorderBrush" Value="#1C7430"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                    <Setter Property="BorderBrush" Value="#1E7E34"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Yellow ToggleButton Style (Pause/Warning) -->
        <Style x:Key="ToggleButtonWarning" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D39E00"/>
                    <Setter Property="BorderBrush" Value="#C69500"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                    <Setter Property="BorderBrush" Value="#D39E00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Red ToggleButton Style (Stop/Danger) -->
        <Style x:Key="ToggleButtonDanger" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#BD2130"/>
                    <Setter Property="BorderBrush" Value="#B21F2D"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <TabControl Style="{StaticResource HiddenTabControlStyle}" SelectedIndex="{Binding CurrentViewIndex}">
        <!-- Main View (Index 0) -->
        <TabItem>
            <Grid Background="#E8E8E8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Title Bar -->
                <Grid Grid.Row="0" Margin="10,10,10,5">
                    <TextBlock Text="{lex:Loc TransferRobot}" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc StationOperation}" Style="{StaticResource ButtonSuccess}" 
                            MinWidth="80" Height="30" Padding="10,5"
                            HorizontalAlignment="Right" Command="{Binding StationOperationCommand}"/>
                </Grid>

                <!-- Main Content Area -->
                <Grid Grid.Row="1" Margin="10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Axis Position Adjustment -->
                    <GroupBox Grid.Column="0" Header="{lex:Loc AxisPositionAdjustment}" Margin="0,0,5,0"
                              Background="White" BorderBrush="#CCCCCC">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Module Pick -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc ModulePickPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Grid.Row="0" Grid.Column="1"
                                                                 Value="{Binding ModulePickPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Minimum="{Binding PositionMinimum}"
                                                                 Maximum="{Binding PositionMaximum}"
                                                                 DecimalPlaces="3"
                                                                 Increment="0.001"
                                                                 IsDirty="{Binding IsModulePickPositionDirty}"
                                                                 SetCommand="{Binding ModulePickPositionSetCommand}"
                                                                 CancelCommand="{Binding ModulePickPositionCancelCommand}"/>
                            <ToggleButton Grid.Row="0" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding ModulePickMoveToggle, Mode=OneWay}" Command="{Binding ModulePickMoveCommand}"/>
                            <controls:SignalLight Grid.Row="0" Grid.Column="3" Width="18" Height="18" LightColor="Green" IsOn="{Binding ModulePickMoveStatus}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                             
                            <!-- JOG Speed -->
                            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{lex:Loc JogSpeed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Width="100"
                                                                     Value="{Binding JogSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Minimum="{Binding PositionMinimum}"
                                                                     Maximum="{Binding PositionMaximum}"
                                                                     DecimalPlaces="3"
                                                                     Increment="0.001"
                                                                     IsDirty="{Binding IsJogSpeedDirty}"
                                                                     SetCommand="{Binding JogSpeedSetCommand}"
                                                                     CancelCommand="{Binding JogSpeedCancelCommand}"/>
                            </StackPanel>
                            
                            <!-- Transfer A -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc TransferAPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Grid.Row="1" Grid.Column="1"
                                                                 Value="{Binding TransferAPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Minimum="{Binding PositionMinimum}"
                                                                 Maximum="{Binding PositionMaximum}"
                                                                 DecimalPlaces="3"
                                                                 Increment="0.001"
                                                                 IsDirty="{Binding IsTransferAPositionDirty}"
                                                                 SetCommand="{Binding TransferAPositionSetCommand}"
                                                                 CancelCommand="{Binding TransferAPositionCancelCommand}"/>
                            <ToggleButton Grid.Row="1" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding TransferAMoveToggle, Mode=OneWay}" Command="{Binding TransferAMoveCommand}"/>
                            <controls:SignalLight Grid.Row="1" Grid.Column="3" Width="18" Height="18" LightColor="Green" IsOn="{Binding TransferAMoveStatus}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            
                            <!-- Auto Speed -->
                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{lex:Loc AutoSpeed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Width="100"
                                                                     Value="{Binding AutoSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Minimum="{Binding PositionMinimum}"
                                                                     Maximum="{Binding PositionMaximum}"
                                                                     DecimalPlaces="3"
                                                                     Increment="0.001"
                                                                     IsDirty="{Binding IsAutoSpeedDirty}"
                                                                     SetCommand="{Binding AutoSpeedSetCommand}"
                                                                     CancelCommand="{Binding AutoSpeedCancelCommand}"/>
                            </StackPanel>
                            
                            <!-- Transfer B -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc TransferBPosition}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Grid.Row="2" Grid.Column="1"
                                                                 Value="{Binding TransferBPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Minimum="{Binding PositionMinimum}"
                                                                 Maximum="{Binding PositionMaximum}"
                                                                 DecimalPlaces="3"
                                                                 Increment="0.001"
                                                                 IsDirty="{Binding IsTransferBPositionDirty}"
                                                                 SetCommand="{Binding TransferBPositionSetCommand}"
                                                                 CancelCommand="{Binding TransferBPositionCancelCommand}"/>
                            <ToggleButton Grid.Row="2" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding TransferBMoveToggle, Mode=OneWay}" Command="{Binding TransferBMoveCommand}"/>
                            <controls:SignalLight Grid.Row="2" Grid.Column="3" Width="18" Height="18" LightColor="Green" IsOn="{Binding TransferBMoveStatus}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            
                            <!-- Current Coordinate -->
                            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{lex:Loc CurrentCoordinate}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding CurrentCoordinate, StringFormat=F3}" Width="100" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Roller A1 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{lex:Loc RollerA1Position}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Grid.Row="3" Grid.Column="1"
                                                                 Value="{Binding RollerA1Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Minimum="{Binding PositionMinimum}"
                                                                 Maximum="{Binding PositionMaximum}"
                                                                 DecimalPlaces="3"
                                                                 Increment="0.001"
                                                                 IsDirty="{Binding IsRollerA1PositionDirty}"
                                                                 SetCommand="{Binding RollerA1PositionSetCommand}"
                                                                 CancelCommand="{Binding RollerA1PositionCancelCommand}"/>
                            <ToggleButton Grid.Row="3" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding RollerA1MoveToggle, Mode=OneWay}" Command="{Binding RollerA1MoveCommand}"/>
                            <controls:SignalLight Grid.Row="3" Grid.Column="3" Width="18" Height="18" LightColor="Green" IsOn="{Binding RollerA1MoveStatus}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            
                            <!-- Enable -->
                            <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding IsEnabled}" Margin="0,0,5,0"/>
                                <ToggleButton Content="{lex:Loc Enable}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="80" Height="28" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding EnableCommand}"/>
                            </StackPanel>
                            
                            <!-- Roller A2 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{lex:Loc RollerA2Position}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Grid.Row="4" Grid.Column="1"
                                                                 Value="{Binding RollerA2Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Minimum="{Binding PositionMinimum}"
                                                                 Maximum="{Binding PositionMaximum}"
                                                                 DecimalPlaces="3"
                                                                 Increment="0.001"
                                                                 IsDirty="{Binding IsRollerA2PositionDirty}"
                                                                 SetCommand="{Binding RollerA2PositionSetCommand}"
                                                                 CancelCommand="{Binding RollerA2PositionCancelCommand}"/>
                            <ToggleButton Grid.Row="4" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding RollerA2MoveToggle, Mode=OneWay}" Command="{Binding RollerA2MoveCommand}"/>
                            <controls:SignalLight Grid.Row="4" Grid.Column="3" Width="18" Height="18" LightColor="Green" IsOn="{Binding RollerA2MoveStatus}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            
                           
                            <!-- Jog Up/Down Buttons with Signal Lights -->
                            <StackPanel Grid.Row="4" Grid.RowSpan="4" Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Up Button with Signal Light -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                          IsOn="{Binding JogUpActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                <b:InvokeCommandAction Command="{Binding PressJogUpCommand}"/>
                                            </b:EventTrigger>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                <b:InvokeCommandAction Command="{Binding ReleaseJogUpCommand}"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                        <Path Data="M30,10 L15,35 L45,35 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                                    </Button>
                                </StackPanel>
                                
                                <!-- Middle Light Row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" HorizontalAlignment="Left">
                                    <controls:SignalLight Width="20" Height="20" LightColor="Green" 
                                                          IsOn="{Binding JogMiddleActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <!-- Spacer to align with button column if needed or just empty -->
                                </StackPanel>

                                <!-- Down Button with Signal Light -->
                                <StackPanel Orientation="Horizontal">
                                    <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                          IsOn="{Binding JogDownActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                <b:InvokeCommandAction Command="{Binding PressJogDownCommand}"/>
                                            </b:EventTrigger>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                <b:InvokeCommandAction Command="{Binding ReleaseJogDownCommand}"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                        <Path Data="M30,35 L15,10 L45,10 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Roller B1 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{lex:Loc RollerB1Position}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Grid.Row="5" Grid.Column="1"
                                                                 Value="{Binding RollerB1Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Minimum="{Binding PositionMinimum}"
                                                                 Maximum="{Binding PositionMaximum}"
                                                                 DecimalPlaces="3"
                                                                 Increment="0.001"
                                                                 IsDirty="{Binding IsRollerB1PositionDirty}"
                                                                 SetCommand="{Binding RollerB1PositionSetCommand}"
                                                                 CancelCommand="{Binding RollerB1PositionCancelCommand}"/>
                            <ToggleButton Grid.Row="5" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding RollerB1MoveToggle, Mode=OneWay}" Command="{Binding RollerB1MoveCommand}"/>
                            <controls:SignalLight Grid.Row="5" Grid.Column="3" Width="18" Height="18" LightColor="Green" IsOn="{Binding RollerB1MoveStatus}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            
                            <!-- Roller B2 -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{lex:Loc RollerB2Position}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Grid.Row="6" Grid.Column="1"
                                                                 Value="{Binding RollerB2Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Minimum="{Binding PositionMinimum}"
                                                                 Maximum="{Binding PositionMaximum}"
                                                                 DecimalPlaces="3"
                                                                 Increment="0.001"
                                                                 IsDirty="{Binding IsRollerB2PositionDirty}"
                                                                 SetCommand="{Binding RollerB2PositionSetCommand}"
                                                                 CancelCommand="{Binding RollerB2PositionCancelCommand}"/>
                            <ToggleButton Grid.Row="6" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding RollerB2MoveToggle, Mode=OneWay}" Command="{Binding RollerB2MoveCommand}"/>
                            <controls:SignalLight Grid.Row="6" Grid.Column="3" Width="18" Height="18" LightColor="Green" IsOn="{Binding RollerB2MoveStatus}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            
                            <!-- Alarm Code -->
                            <Border Grid.Row="8" Grid.Column="0" Width="60" Height="26" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding AlarmCode}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                            </Border>

                            <!-- Alarm Status -->
                            <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Top" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc DriverAlarm}" VerticalAlignment="Center"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                                                      IsOn="{Binding DriverAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc LimitAlarm}" VerticalAlignment="Center"/>
                                <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                                                      IsOn="{Binding LimitAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Origin -->
                            <StackPanel Grid.Row="9" Grid.Column="4" Orientation="Horizontal" 
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0">
                                <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding IsAtOrigin}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ToggleButton Content="{lex:Loc Origin}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="80" Height="28" IsChecked="{Binding OriginToggle, Mode=TwoWay}" Command="{Binding OriginCommand}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    
                    <!-- Right: Robot Control -->
                    <GroupBox Grid.Column="1" Margin="5,0,0,0" Header="{lex:Loc RobotControl}" Background="White" BorderBrush="#CCCCCC">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Program Number -->
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{lex:Loc ProgramNumber}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Width="90"
                                                                     Value="{Binding ProgramNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Minimum="0"
                                                                     Maximum="32767"
                                                                     DecimalPlaces="0"
                                                                     Increment="1"
                                                                     IsDirty="{Binding IsProgramNoDirty}"
                                                                     SetCommand="{Binding ProgramNoSetCommand}"
                                                                     CancelCommand="{Binding ProgramNoCancelCommand}"/>
                            </StackPanel>
                            
                            <!-- Row 1: Start, Pause, Stop, Reset -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Grid.Column="0" Content="{lex:Loc Start}" Style="{StaticResource ButtonSuccess}" MinWidth="50" Height="28" Command="{Binding RobotStartCommand}"/>
                                <controls:SignalLight Grid.Column="1" IsBreathing="True" Width="18" Height="18" LightColor="Green" IsOn="{Binding RobotStartStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <ToggleButton Grid.Column="3" Content="{lex:Loc Pause}" Style="{StaticResource ToggleButtonWarning}" MinWidth="50" Height="28" IsChecked="{Binding RobotPauseToggle, Mode=OneWay}" Command="{Binding RobotPauseCommand}"/>
                                <controls:SignalLight Grid.Column="4" Width="18" Height="18" LightColor="Yellow" IsOn="{Binding RobotPauseStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <Button Grid.Column="6" Content="{lex:Loc Stop}" Style="{StaticResource ButtonDanger}" MinWidth="50" Height="28" Command="{Binding RobotStopCommand}"/>
                                <controls:SignalLight Grid.Column="7" Width="18" Height="18" LightColor="Red" IsOn="{Binding RobotStopStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <Button Grid.Column="9" Content="{lex:Loc Reset}" Style="{StaticResource ButtonPrimary}" MinWidth="50" Height="28" Command="{Binding RobotResetCommand}"/>
                                <controls:SignalLight Grid.Column="10" Width="18" Height="18" LightColor="Blue" IsOn="{Binding RobotResetStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Row 2: Work Area Number -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{lex:Loc WorkAreaNumber}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Width="90"
                                                                     Value="{Binding WorkAreaNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Minimum="0"
                                                                     Maximum="32767"
                                                                     DecimalPlaces="0"
                                                                     Increment="1"
                                                                     IsDirty="{Binding IsWorkAreaNoDirty}"
                                                                     SetCommand="{Binding WorkAreaNoSetCommand}"
                                                                     CancelCommand="{Binding WorkAreaNoCancelCommand}"/>
                            </StackPanel>
                            
                            <!-- Row 3: Operation Buttons -->
                            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Row 1 -->
                                <ToggleButton Grid.Row="0" Grid.Column="0" Content="{lex:Loc ModulePick}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" Margin="0,0,10,0" IsChecked="{Binding WorkAreaPickToggle, Mode=OneWay}" Command="{Binding WorkAreaPickCommand}"/>
                                <ToggleButton Grid.Row="0" Grid.Column="1" Content="{lex:Loc WorkAreaPick}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding WorkAreaPickToggle, Mode=OneWay}" Command="{Binding WorkAreaPickCommand}"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="2" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding WorkAreaPickStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Row="0" Grid.Column="4" Content="{lex:Loc AutoMode}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding AutoModeToggle, Mode=OneWay}" Command="{Binding AutoModeCommand}"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="5" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding AutoModeStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <!-- Row 2 -->
                                <ToggleButton Grid.Row="1" Grid.Column="0" Content="{lex:Loc TransferAPosition}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" Margin="0,0,10,0" IsChecked="{Binding WorkAreaPlaceToggle, Mode=OneWay}" Command="{Binding WorkAreaPlaceCommand}"/>
                                <ToggleButton Grid.Row="1" Grid.Column="1" Content="{lex:Loc WorkAreaPlace}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding WorkAreaPlaceToggle, Mode=OneWay}" Command="{Binding WorkAreaPlaceCommand}"/>
                                <controls:SignalLight Grid.Row="1" Grid.Column="2" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding WorkAreaPlaceStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Row="1" Grid.Column="4" Content="{lex:Loc UseUpperArm}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding UseUpperArmToggle, Mode=OneWay}" Command="{Binding UseUpperArmCommand}"/>
                                <!--<controls:SignalLight Grid.Row="1" Grid.Column="5" Width="18" Height="18" LightColor="Green" HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
                                
                                <!-- Row 3 -->
                                <ToggleButton Grid.Row="2" Grid.Column="0" Content="{lex:Loc TransferBPosition}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" Margin="0,0,10,0" IsChecked="{Binding WaitConfirmToggle, Mode=OneWay}" Command="{Binding WaitConfirmCommand}"/>
                                <ToggleButton Grid.Row="2" Grid.Column="1" Content="{lex:Loc WaitConfirm}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding WaitConfirmToggle, Mode=OneWay}" Command="{Binding WaitConfirmCommand}"/>
                                <controls:SignalLight Grid.Row="2" Grid.Column="2" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding WaitConfirmStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Row="2" Grid.Column="4" Content="{lex:Loc UseLowerArm}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding UseLowerArmToggle, Mode=OneWay}" Command="{Binding UseLowerArmCommand}"/>
                                <controls:SignalLight Grid.Row="2" Grid.Column="5" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding UseLowerArmToggle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Row 3: Roller A1 -->
                                <ToggleButton Grid.Row="3" Grid.Column="0" Content="{lex:Loc RollerA1Position}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" Margin="0,0,10,0" IsChecked="{Binding ConfirmSwitchToggle, Mode=OneWay}" Command="{Binding ConfirmSwitchCommand}"/>
                                <ToggleButton Grid.Row="3" Grid.Column="1" Content="{lex:Loc ConfirmSwitch}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding ConfirmSwitchToggle, Mode=OneWay}" Command="{Binding ConfirmSwitchCommand}"/>
                                <controls:SignalLight Grid.Row="3" Grid.Column="2" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding ConfirmSwitchToggle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Row 4: Roller A2 -->
                                <ToggleButton Grid.Row="4" Grid.Column="0" Content="{lex:Loc RollerA2Position}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" Margin="0,0,10,0" IsChecked="{Binding TurnTo0Toggle, Mode=OneWay}" Command="{Binding TurnTo0Command}"/>
                                        
                                <!-- Row 5: Roller B1 -->
                                <ToggleButton Grid.Row="5" Grid.Column="0" Content="{lex:Loc RollerB1Position}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" Margin="0,0,10,0" IsChecked="{Binding TurnTo0Toggle, Mode=OneWay}" Command="{Binding TurnTo0Command}"/>

                                <ToggleButton Grid.Row="5" Grid.Column="1" Content="{lex:Loc TurnTo0}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding TurnTo0Toggle, Mode=OneWay}" Command="{Binding TurnTo0Command}"/>
                                <controls:SignalLight Grid.Row="5" Grid.Column="2" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding TurnTo0Status}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Row 6: Roller B2 -->
                                <ToggleButton Grid.Row="6" Grid.Column="0" Content="{lex:Loc RollerB2Position}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" Margin="0,0,10,0" IsChecked="{Binding TurnTo180Toggle, Mode=OneWay}" Command="{Binding TurnTo180Command}"/>
                                <ToggleButton Grid.Row="6" Grid.Column="1" Content="{lex:Loc TurnTo180}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding TurnTo180Toggle, Mode=OneWay}" Command="{Binding TurnTo180Command}"/>
                                <controls:SignalLight Grid.Row="6" Grid.Column="2" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding TurnTo180Status}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Sensors (Aligned to Right Bottom) -->
                            <!-- Sensors (Aligned to Right Bottom) -->
                            <StackPanel Grid.Row="6" Grid.RowSpan="2" Grid.Column="4" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-5"> 
                            <!-- Shifted to column 4/5 to be visible -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" HorizontalAlignment="Right">
                                    <TextBlock Text="{lex:Loc UpperArmSensor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <controls:SignalLight Width="18" Height="18" LightColor="Red" IsOn="{Binding UpperArmSensorOn}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" HorizontalAlignment="Right">
                                    <TextBlock Text="{lex:Loc LowerArmSensor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <controls:SignalLight Width="18" Height="18" LightColor="Red" IsOn="{Binding LowerArmSensorOn}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5" HorizontalAlignment="Right">
                                    <TextBlock Text="{lex:Loc CommandReceived}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <controls:SignalLight Width="18" Height="18" LightColor="Red" IsOn="{Binding CommandReceivedOn}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ToggleButton Content="{lex:Loc RobotSafePosition}" Style="{StaticResource MoveToggleButtonStyle}" 
                                            Width="140" Height="28" IsChecked="{Binding RobotSafePositionOn, Mode=OneWay}" Command="{Binding RobotSafePositionCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
                
                <!-- Bottom Status Bar -->
                <Grid Grid.Row="2" Margin="10,0,10,5" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ToggleButton Content="{lex:Loc EmergencyStop}" Style="{StaticResource ToggleButtonDanger}" MinWidth="70" Height="28" Margin="0,0,10,0" IsChecked="{Binding EmergencyStopToggle, Mode=OneWay}" Command="{Binding EmergencyStopCommand}"/>
                        <ToggleButton Content="{lex:Loc AlarmReset}" Style="{StaticResource ToggleButtonWarning}" MinWidth="70" Height="28" Margin="0,0,10,0" IsChecked="{Binding AlarmResetToggle, Mode=OneWay}" Command="{Binding AlarmResetCommand}"/>
                        <ToggleButton Content="{lex:Loc Save}" Style="{StaticResource ToggleButtonSuccess}" MinWidth="70" Height="28" IsChecked="{Binding SaveToggle, Mode=OneWay}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>
        
        <!-- Station Operation View (Index 1) -->
        <TabItem>
            <local:TransferRobotStationView/>
        </TabItem>
    </TabControl>
</UserControl>

