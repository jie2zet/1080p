<UserControl x:Class="CMP.Views.Tabs.OperationTab.RobotControlTab.FeedingRobot.FeedingRobotStationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:robotControlTab="clr-namespace:CMP.ViewModels.Tabs.OperationTab.RobotControlTab"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance robotControlTab:FeedingRobotControlViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DesignHeight="600" d:DesignWidth="900">
    
    <UserControl.Resources>
        <Style x:Key="MoveToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DC3545"/>
                    <Setter Property="BorderBrush" Value="#DC3545"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- 绿色 ToggleButton 样式 (Start/Success) -->
        <Style x:Key="ToggleButtonSuccess" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1E7E34"/>
                    <Setter Property="BorderBrush" Value="#1C7430"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                    <Setter Property="BorderBrush" Value="#1E7E34"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- 红色 ToggleButton 样式 (Stop/Danger) -->
        <Style x:Key="ToggleButtonDanger" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#BD2130"/>
                    <Setter Property="BorderBrush" Value="#B21F2D"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="#C8E6E6">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Grid Grid.Row="0">
            <Button Style="{StaticResource ButtonSuccess}" 
                    Width="80" Height="32" HorizontalAlignment="Left" Margin="20,0,0,0"
                    Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M6,0 L0,5 L6,10 M0,5 L10,5" Stroke="White" StrokeThickness="1.5" 
                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{lex:Loc Back}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{lex:Loc FeedingRobot}" FontSize="20" FontWeight="Bold" 
                       Foreground="#006666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Operation Buttons -->
            <StackPanel Grid.Column="0">
                <!-- Row 1: Reset, Start, Stop -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{lex:Loc Reset}" Style="{StaticResource ButtonPrimary}" Height="28" Command="{Binding StationResetCommand}"/>
                    <controls:SignalLight Grid.Column="1" Width="20" Height="20" LightColor="Blue" IsOn="{Binding StationIsReset}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="{lex:Loc Start}" Style="{StaticResource ButtonSuccess}" Height="28" Command="{Binding StationStartCommand}"/>
                    <controls:SignalLight Grid.Column="4" Width="20" Height="20" LightColor="Green" IsOn="{Binding StationIsRunning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="6" Content="{lex:Loc Stop}" Style="{StaticResource ButtonDanger}" Height="28" Command="{Binding StationStopCommand}"/>
                    <controls:SignalLight Grid.Column="7" Width="20" Height="20" LightColor="Red" IsOn="{Binding StationIsStopped}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                
                <!-- Row 2: Operation Buttons -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    
                    <controls:SignalLight Grid.Row="0" Grid.Column="0" Width="20" Height="20" LightColor="Blue" IsOn="{Binding PickFromBoxActive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Row="0" Grid.Column="2" Content="{lex:Loc PickFromBox}" Style="{StaticResource MoveToggleButtonStyle}" Height="28" IsChecked="{Binding PickFromBoxToggle, Mode=TwoWay}" Command="{Binding PickFromBoxToggleCommand}"/>
                    <controls:SignalLight Grid.Row="0" Grid.Column="4" Width="20" Height="20" LightColor="Green" IsOn="{Binding PickFromBoxDone}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    
                    <controls:SignalLight Grid.Row="1" Grid.Column="0" Width="20" Height="20" LightColor="Blue" IsOn="{Binding PlaceToModuleActive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Row="1" Grid.Column="2" Content="{lex:Loc PlaceToModule}" Style="{StaticResource MoveToggleButtonStyle}" Height="28" IsChecked="{Binding PlaceToModuleToggle, Mode=TwoWay}" Command="{Binding PlaceToModuleToggleCommand}"/>
                    <controls:SignalLight Grid.Row="1" Grid.Column="4" Width="20" Height="20" LightColor="Green" IsOn="{Binding PlaceToModuleDone}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    
                    <controls:SignalLight Grid.Row="2" Grid.Column="0" Width="20" Height="20" LightColor="Blue" IsOn="{Binding PickFromDryAActive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Row="2" Grid.Column="2" Content="{lex:Loc PickFromDryA}" Style="{StaticResource MoveToggleButtonStyle}" Height="28" IsChecked="{Binding PickFromDryAToggle, Mode=TwoWay}" Command="{Binding PickFromDryAToggleCommand}"/>
                    <controls:SignalLight Grid.Row="2" Grid.Column="4" Width="20" Height="20" LightColor="Green" IsOn="{Binding PickFromDryADone}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    
                    <controls:SignalLight Grid.Row="3" Grid.Column="0" Width="20" Height="20" LightColor="Blue" IsOn="{Binding PickFromDryBActive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Row="3" Grid.Column="2" Content="{lex:Loc PickFromDryB}" Style="{StaticResource MoveToggleButtonStyle}" Height="28" IsChecked="{Binding PickFromDryBToggle, Mode=TwoWay}" Command="{Binding PickFromDryBToggleCommand}"/>
                    <controls:SignalLight Grid.Row="3" Grid.Column="4" Width="20" Height="20" LightColor="Green" IsOn="{Binding PickFromDryBDone}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    
                    <controls:SignalLight Grid.Row="4" Grid.Column="0" Width="20" Height="20" LightColor="Blue" IsOn="{Binding PlaceToBoxActive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Row="4" Grid.Column="2" Content="{lex:Loc PlaceToBox}" Style="{StaticResource MoveToggleButtonStyle}" Height="28" IsChecked="{Binding PlaceToBoxToggle, Mode=TwoWay}" Command="{Binding PlaceToBoxToggleCommand}"/>
                    <controls:SignalLight Grid.Row="4" Grid.Column="4" Width="20" Height="20" LightColor="Green" IsOn="{Binding PlaceToBoxDone}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            
            <!-- Right: Alarm + Manual/Auto + Source/Target Boxes -->
            <StackPanel Grid.Column="1" Margin="40,0,0,0">
                <!-- Alarm Area -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc ModuleAlarm}" VerticalAlignment="Center" FontSize="13" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="16" Height="16" LightColor="Red" IsOn="{Binding ModuleAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc GlobalAlarm}" VerticalAlignment="Center" FontSize="13" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="16" Height="16" LightColor="Red" IsOn="{Binding GlobalAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Content="{lex:Loc AlarmReset}" Style="{StaticResource ButtonWarning}" 
                            Width="100" Height="40" FontSize="12" Command="{Binding AlarmResetCommand}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Load Control and Side Status -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>
                    <ToggleButton Grid.Row="0" Grid.Column="0" Content="{lex:Loc StopLoad}" Style="{StaticResource ToggleButtonDanger}"
                                  Height="28" IsChecked="{Binding StopLoadToggle, Mode=OneWay}" Command="{Binding StopLoadCommand}"/>
                    <ToggleButton Grid.Row="0" Grid.Column="2" Content="{lex:Loc ResumeLoad}" Style="{StaticResource ToggleButtonSuccess}"
                                  Height="28" IsChecked="{Binding ResumeLoadToggle, Mode=OneWay}" Command="{Binding ResumeLoadCommand}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc SideAHealthy}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="18" Height="18" LightColor="Green"
                                          IsOn="{Binding SideAHealthy}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{lex:Loc SideBHealthy}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <controls:SignalLight Grid.Row="1" Grid.Column="3" Width="18" Height="18" LightColor="Green"
                                          IsOn="{Binding SideBHealthy}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                
                <!-- Manual/Auto Buttons -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Content="{lex:Loc Manual}" Style="{StaticResource MoveToggleButtonStyle}" Height="32" IsChecked="{Binding ManualModeToggle, Mode=OneWay}" Command="{Binding ManualModeToggleCommand}"/>
                    <controls:SignalLight Grid.Column="2" Width="20" Height="20" LightColor="Blue" IsOn="{Binding IsManualMode}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Column="4" Content="{lex:Loc Auto}" Style="{StaticResource MoveToggleButtonStyle}" Height="32" IsChecked="{Binding AutoModeToggle, Mode=OneWay}" Command="{Binding AutoModeToggleCommand}"/>
                    <controls:SignalLight Grid.Column="6" Width="20" Height="20" LightColor="Green" IsOn="{Binding IsAutoMode}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                
                <!-- Source Box and Target Box -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Source Box -->
                    <Border Grid.Column="0" Background="#A0E0E0" BorderBrush="#006666" BorderThickness="1" Padding="15,10" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" SharedSizeGroup="LabelCol"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{lex:Loc SourceBox}" FontSize="14" Foreground="#006666" 
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc BoxNo}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <controls:EditableNumericWithActions Grid.Row="1" Grid.Column="1" Width="60"
                                                                 Value="{Binding SourceBoxNo}"
                                                                 Minimum="0"
                                                                 Maximum="32767"
                                                                 DecimalPlaces="0"
                                                                 Increment="1"
                                                                 IsDirty="{Binding IsSourceBoxNoDirty, Mode=OneWay}"
                                                                 SetCommand="{Binding SourceBoxNoSetCommand}"
                                                                 CancelCommand="{Binding SourceBoxNoCancelCommand}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc Layer}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <controls:EditableNumericWithActions Grid.Row="2" Grid.Column="1" Width="60"
                                                                 Value="{Binding SourceLayer}"
                                                                 Minimum="0"
                                                                 Maximum="32767"
                                                                 DecimalPlaces="0"
                                                                 Increment="1"
                                                                 IsDirty="{Binding IsSourceLayerDirty, Mode=OneWay}"
                                                                 SetCommand="{Binding SourceLayerSetCommand}"
                                                                 CancelCommand="{Binding SourceLayerCancelCommand}"/>
                        </Grid>
                    </Border>
                    
                    <!-- Transfer Arrow -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <ToggleButton Content="{lex:Loc Transfer}" Style="{StaticResource MoveToggleButtonStyle}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" IsChecked="{Binding TransferToggle, Mode=OneWay}" Command="{Binding TransferToggleCommand}"/>
                        <Path Data="M0,10 L30,10 L30,5 L45,12.5 L30,20 L30,15 L0,15 Z" 
                              Fill="#404040" Stretch="Uniform" Width="40" Height="20"/>
                    </StackPanel>
                    
                    <!-- Target Box -->
                    <Border Grid.Column="2" Background="#A0E0E0" BorderBrush="#006666" BorderThickness="1" Padding="15,10" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" SharedSizeGroup="LabelCol"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{lex:Loc TargetBox}" FontSize="14" Foreground="#006666" 
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc BoxNo}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <controls:EditableNumericWithActions Grid.Row="1" Grid.Column="1" Width="60"
                                                                 Value="{Binding TargetBoxNo}"
                                                                 Minimum="0"
                                                                 Maximum="32767"
                                                                 DecimalPlaces="0"
                                                                 Increment="1"
                                                                 IsDirty="{Binding IsTargetBoxNoDirty, Mode=OneWay}"
                                                                 SetCommand="{Binding TargetBoxNoSetCommand}"
                                                                 CancelCommand="{Binding TargetBoxNoCancelCommand}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lex:Loc Layer}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <controls:EditableNumericWithActions Grid.Row="2" Grid.Column="1" Width="60"
                                                                 Value="{Binding TargetLayer}"
                                                                 Minimum="0"
                                                                 Maximum="32767"
                                                                 DecimalPlaces="0"
                                                                 Increment="1"
                                                                 IsDirty="{Binding IsTargetLayerDirty, Mode=OneWay}"
                                                                 SetCommand="{Binding TargetLayerSetCommand}"
                                                                 CancelCommand="{Binding TargetLayerCancelCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
