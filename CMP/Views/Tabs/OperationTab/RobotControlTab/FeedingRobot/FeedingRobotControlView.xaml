<UserControl x:Class="CMP.Views.Tabs.OperationTab.RobotControlTab.FeedingRobot.FeedingRobotControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewModel="clr-namespace:CMP.ViewModels.Tabs.OperationTab.RobotControlTab"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:local="clr-namespace:CMP.Views.Tabs.OperationTab.RobotControlTab.FeedingRobot"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModel:FeedingRobotControlViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <UserControl.Resources>
        <Style x:Key="HiddenTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- ToggleButton 样式：未选中时为 Primary，选中时为 Danger -->
        <Style x:Key="MoveToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DC3545"/>
                    <Setter Property="BorderBrush" Value="#DC3545"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- 绿色 ToggleButton 样式 (Start/Success) -->
        <Style x:Key="ToggleButtonSuccess" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1E7E34"/>
                    <Setter Property="BorderBrush" Value="#1C7430"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                    <Setter Property="BorderBrush" Value="#1E7E34"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- 黄色 ToggleButton 样式 (Pause/Warning) -->
        <Style x:Key="ToggleButtonWarning" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="BorderBrush" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#D39E00"/>
                    <Setter Property="BorderBrush" Value="#C69500"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                    <Setter Property="BorderBrush" Value="#D39E00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- 红色 ToggleButton 样式 (Stop/Danger) -->
        <Style x:Key="ToggleButtonDanger" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonPrimary}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#BD2130"/>
                    <Setter Property="BorderBrush" Value="#B21F2D"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                    <Setter Property="BorderBrush" Value="#BD2130"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <TabControl Style="{StaticResource HiddenTabControlStyle}" SelectedIndex="{Binding CurrentViewIndex}">
        <!-- Main View (Index 0) -->
        <TabItem>
            <Grid Background="#E8E8E8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Title Bar -->
                <Grid Grid.Row="0" Margin="10,10,10,5">
                    <TextBlock Text="{lex:Loc FeedingRobotAndPosition}" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="{lex:Loc StationOperation}" Style="{StaticResource ButtonSuccess}" 
                            MinWidth="80" Height="30" Padding="10,5"
                            HorizontalAlignment="Right" Command="{Binding StationOperationCommand}"/>
                </Grid>

                <!-- Main Content Area -->
                <Grid Grid.Row="1" Margin="10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Axis Position Adjustment -->
                    <GroupBox Grid.Column="0" Header="{lex:Loc AxisPositionAdjustment}" Margin="0,0,5,0"
                              Background="White" BorderBrush="#CCCCCC">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- LoadPort1# -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="LoadPort1#" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Grid.Row="0" Grid.Column="1"
                                                 Value="{Binding LoadPort1Position}"
                                                 Minimum="{Binding PositionMinimum}"
                                                 Maximum="{Binding PositionMaximum}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsLoadPort1PositionDirty, Mode=OneWay}"
                                                 SetCommand="{Binding LoadPort1SetCommand}"
                                                 CancelCommand="{Binding LoadPort1CancelCommand}"/>
                            <ToggleButton Grid.Row="0" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding LoadPort1MoveToggle, Mode=OneWay}" Command="{Binding LoadPort1MoveCommand}"/>
                             
                            <!-- JOG Speed -->
                            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{lex:Loc JogSpeed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Width="100"
                                                           Value="{Binding JogSpeed}"
                                                           Minimum="-90000" Maximum="90000"
                                                           DecimalPlaces="3" Increment="0.001"
                                                           IsDirty="{Binding IsJogSpeedDirty, Mode=OneWay}"
                                                           SetCommand="{Binding JogSpeedSetCommand}"
                                                           CancelCommand="{Binding JogSpeedCancelCommand}"/>
                            </StackPanel>
                            
                            <!-- LoadPort2# -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="LoadPort2#" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Grid.Row="1" Grid.Column="1"
                                                 Value="{Binding LoadPort2Position}"
                                                 Minimum="{Binding PositionMinimum}"
                                                 Maximum="{Binding PositionMaximum}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsLoadPort2PositionDirty, Mode=OneWay}"
                                                 SetCommand="{Binding LoadPort2SetCommand}"
                                                 CancelCommand="{Binding LoadPort2CancelCommand}"/>
                            <ToggleButton Grid.Row="1" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding LoadPort2MoveToggle, Mode=OneWay}" Command="{Binding LoadPort2MoveCommand}"/>
                            
                            <!-- Auto Speed -->
                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{lex:Loc AutoSpeed}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Width="100"
                                                           Value="{Binding AutoSpeed}"
                                                           Minimum="-90000" Maximum="90000"
                                                           DecimalPlaces="3" Increment="0.001"
                                                           IsDirty="{Binding IsAutoSpeedDirty, Mode=OneWay}"
                                                           SetCommand="{Binding AutoSpeedSetCommand}"
                                                           CancelCommand="{Binding AutoSpeedCancelCommand}"/>
                            </StackPanel>
                            
                            <!-- LoadPort3# -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="LoadPort3#" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Grid.Row="2" Grid.Column="1"
                                                 Value="{Binding LoadPort3Position}"
                                                 Minimum="{Binding PositionMinimum}"
                                                 Maximum="{Binding PositionMaximum}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsLoadPort3PositionDirty, Mode=OneWay}"
                                                 SetCommand="{Binding LoadPort3SetCommand}"
                                                 CancelCommand="{Binding LoadPort3CancelCommand}"/>
                            <ToggleButton Grid.Row="2" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding LoadPort3MoveToggle, Mode=OneWay}" Command="{Binding LoadPort3MoveCommand}"/>
                            
                            <!-- Current Coordinate -->
                            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{lex:Loc CurrentCoordinate}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding CurrentCoordinate, StringFormat=F3}" Width="100" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- LoadPort4# -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="LoadPort4#" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Grid.Row="3" Grid.Column="1"
                                                 Value="{Binding LoadPort4Position}"
                                                 Minimum="{Binding PositionMinimum}"
                                                 Maximum="{Binding PositionMaximum}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsLoadPort4PositionDirty, Mode=OneWay}"
                                                 SetCommand="{Binding LoadPort4SetCommand}"
                                                 CancelCommand="{Binding LoadPort4CancelCommand}"/>
                            <ToggleButton Grid.Row="3" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding LoadPort4MoveToggle, Mode=OneWay}" Command="{Binding LoadPort4MoveCommand}"/>
                            
                            <!-- Enable -->
                            <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <controls:SignalLight Width="20" Height="20" LightColor="Green" IsOn="{Binding IsEnabled}" Margin="0,0,5,0"/>
                                <ToggleButton Content="{lex:Loc Enable}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="80" Height="28" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding EnableCommand}"/>
                            </StackPanel>
                            
                            <!-- LoadPort5# -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="LoadPort5#" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <controls:EditableNumericWithActions Grid.Row="4" Grid.Column="1"
                                                 Value="{Binding LoadPort5Position}"
                                                 Minimum="{Binding PositionMinimum}"
                                                 Maximum="{Binding PositionMaximum}"
                                                 DecimalPlaces="3"
                                                 Increment="0.001"
                                                 IsDirty="{Binding IsLoadPort5PositionDirty, Mode=OneWay}"
                                                 SetCommand="{Binding LoadPort5SetCommand}"
                                                 CancelCommand="{Binding LoadPort5CancelCommand}"/>
                            <ToggleButton Grid.Row="4" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding LoadPort5MoveToggle, Mode=OneWay}" Command="{Binding LoadPort5MoveCommand}"/>
                            
                            <!-- Middle Module -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{lex:Loc MiddleModule}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Grid.Row="5" Grid.Column="1"
                                                       Value="{Binding MiddleModulePosition}"
                                                       Minimum="{Binding PositionMinimum}"
                                                       Maximum="{Binding PositionMaximum}"
                                                       DecimalPlaces="3"
                                                       Increment="0.001"
                                                       IsDirty="{Binding IsMiddleModulePositionDirty, Mode=OneWay}"
                                                       SetCommand="{Binding MiddleModuleSetCommand}"
                                                       CancelCommand="{Binding MiddleModuleCancelCommand}"/>
                            <ToggleButton Grid.Row="5" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding MiddleModuleMoveToggle, Mode=OneWay}" Command="{Binding MiddleModuleMoveCommand}"/>
                           
                            <!-- Jog Up/Down Buttons with Signal Lights -->
                            <StackPanel Grid.Row="4" Grid.RowSpan="4" Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Up Button with Signal Light -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                          IsOn="{Binding JogUpActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                <b:InvokeCommandAction Command="{Binding PressJogUpCommand}"/>
                                            </b:EventTrigger>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                <b:InvokeCommandAction Command="{Binding ReleaseJogUpCommand}"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                        <Path Data="M30,10 L15,35 L45,35 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                                    </Button>
                                </StackPanel>
                                
                                <!-- Middle Signal Light -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                          IsOn="{Binding JogMiddleActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                </StackPanel>
                                
                                <!-- Down Button with Signal Light -->
                                <StackPanel Orientation="Horizontal">
                                    <controls:SignalLight Width="20" Height="20" LightColor="Blue" 
                                                          IsOn="{Binding JogDownActive}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Style="{StaticResource ButtonPrimary}" Width="80" Height="36">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                <b:InvokeCommandAction Command="{Binding PressJogDownCommand}"/>
                                            </b:EventTrigger>
                                            <b:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                <b:InvokeCommandAction Command="{Binding ReleaseJogDownCommand}"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                        <Path Data="M30,35 L15,10 L45,10 Z" Fill="White" Stretch="Uniform" Width="20" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- DryA -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="DryA" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Grid.Row="6" Grid.Column="1"
                                                       Value="{Binding DryAPosition}"
                                                       Minimum="{Binding PositionMinimum}"
                                                       Maximum="{Binding PositionMaximum}"
                                                       DecimalPlaces="3"
                                                       Increment="0.001"
                                                       IsDirty="{Binding IsDryAPositionDirty, Mode=OneWay}"
                                                       SetCommand="{Binding DryASetCommand}"
                                                       CancelCommand="{Binding DryACancelCommand}"/>
                            <ToggleButton Grid.Row="6" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding DryAMoveToggle, Mode=OneWay}" Command="{Binding DryAMoveCommand}"/>
                            
                            <!-- DryB -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="DryB" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <controls:EditableNumericWithActions Grid.Row="7" Grid.Column="1"
                                                       Value="{Binding DryBPosition}"
                                                       Minimum="{Binding PositionMinimum}"
                                                       Maximum="{Binding PositionMaximum}"
                                                       DecimalPlaces="3"
                                                       Increment="0.001"
                                                       IsDirty="{Binding IsDryBPositionDirty, Mode=OneWay}"
                                                       SetCommand="{Binding DryBSetCommand}"
                                                       CancelCommand="{Binding DryBCancelCommand}"/>
                            <ToggleButton Grid.Row="7" Grid.Column="2" Content="{lex:Loc Move}" Style="{StaticResource MoveToggleButtonStyle}" 
                                    Width="55" Height="28" Margin="5,0" IsChecked="{Binding DryBMoveToggle, Mode=OneWay}" Command="{Binding DryBMoveCommand}"/>
                            
                            <!-- Alarm Code -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding AlarmCode}" Width="50" Height="24" 
                                     HorizontalAlignment="Left" />

                            <!-- Alarm Status -->
                            <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Top" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc DriverAlarm}" VerticalAlignment="Center"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                                                      IsOn="{Binding DriverAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc LimitAlarm}" VerticalAlignment="Center"/>
                                <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="16" Height="16" LightColor="Red" 
                                                      IsOn="{Binding LimitAlarm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Origin -->
                            <StackPanel Grid.Row="9" Grid.Column="4" Orientation="Horizontal" 
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0">
                                <controls:SignalLight Width="20" Height="20" LightColor="Blue" IsOn="{Binding IsAtOrigin}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ToggleButton Content="{lex:Loc Origin}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="80" Height="28" IsChecked="{Binding OriginToggle, Mode=TwoWay}" Command="{Binding OriginCommand}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    
                    <!-- Right: Robot Control -->
                    <GroupBox Grid.Column="1" Margin="5,0,0,0" Header="{lex:Loc RobotControl}" Background="White" BorderBrush="#CCCCCC">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Program Number -->
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{lex:Loc ProgramNumber}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding ProgramNumber}" Width="50" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Row 1: Start, Pause, Stop, Reset -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Grid.Column="0" Content="{lex:Loc Start}" Style="{StaticResource ButtonSuccess}" MinWidth="50" Height="28" Command="{Binding StartCommand}"/>
                                <controls:SignalLight Grid.Column="1" IsBreathing="True" Width="18" Height="18" LightColor="Green" IsOn="{Binding IsRunning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <ToggleButton Grid.Column="3" Content="{lex:Loc Pause}" Style="{StaticResource ToggleButtonWarning}" MinWidth="50" Height="28" IsChecked="{Binding PauseToggle, Mode=OneWay}" Command="{Binding PauseToggleCommand}"/>
                                <controls:SignalLight Grid.Column="4" Width="18" Height="18" LightColor="Yellow" IsOn="{Binding IsPaused}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <Button Grid.Column="6" Content="{lex:Loc Stop}" Style="{StaticResource ButtonDanger}" MinWidth="50" Height="28" Command="{Binding StopCommand}"/>
                                <controls:SignalLight Grid.Column="7" Width="18" Height="18" LightColor="Red" IsOn="{Binding IsStopped}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <Button Grid.Column="9" Content="{lex:Loc Reset}" Style="{StaticResource ButtonPrimary}" MinWidth="50" Height="28" Command="{Binding ResetCommand}"/>
                                <controls:SignalLight Grid.Column="10" Width="18" Height="18" LightColor="Blue" IsOn="{Binding IsReset}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Row 2: Work Area Number -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{lex:Loc WorkAreaNumber}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding WorkAreaNumber}" Width="50" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Row 3: Module Position, DryA, DryB and Work Area Pickup/Place, Auto Mode etc -->
                            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Row 1 -->
                                <Button Grid.Row="0" Grid.Column="0" Content="{lex:Loc ModulePosition}" Style="{StaticResource ButtonPrimary}" 
                                        Width="140" Height="28" Margin="0,0,10,0" Command="{Binding ModulePositionCommand}"/>
                                <ToggleButton Grid.Row="0" Grid.Column="1" Content="{lex:Loc WorkAreaPickup}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding WorkAreaPickupToggle, Mode=OneWay}" Command="{Binding WorkAreaPickupCommand}"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="2" Width="18" Height="18" LightColor="Blue" 
                                                      IsOn="{Binding WorkAreaPickup}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Row="0" Grid.Column="4" Content="{lex:Loc AutoMode}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding AutoModeToggle, Mode=OneWay}" Command="{Binding AutoModeToggleCommand}"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="5" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding AutoModeActive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <!-- Row 2 -->
                                <Button Grid.Row="1" Grid.Column="0" Content="DryA" Style="{StaticResource ButtonPrimary}" 
                                        Width="140" Height="28" Margin="0,0,10,0" Command="{Binding DryACommand}"/>
                                <ToggleButton Grid.Row="1" Grid.Column="1" Content="{lex:Loc WorkAreaPlace}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding WorkAreaPlaceToggle, Mode=OneWay}" Command="{Binding WorkAreaPlaceCommand}"/>
                                <controls:SignalLight Grid.Row="1" Grid.Column="2" Width="18" Height="18" LightColor="Blue" 
                                                      IsOn="{Binding WorkAreaPlace}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Row="1" Grid.Column="4" Content="{lex:Loc UseUpperArm}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding UseUpperArmToggle, Mode=OneWay}" Command="{Binding UseUpperArmToggleCommand}"/>
                                <controls:SignalLight Grid.Row="1" Grid.Column="5" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding UseUpperArmActive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <!-- Row 3 -->
                                <Button Grid.Row="2" Grid.Column="0" Content="DryB" Style="{StaticResource ButtonPrimary}" 
                                        Width="140" Height="28" Margin="0,0,10,0" Command="{Binding DryBCommand}"/>
                                <ToggleButton Grid.Row="2" Grid.Column="1" Content="{lex:Loc WaitConfirm}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding WaitConfirmToggle, Mode=OneWay}" Command="{Binding WaitConfirmCommand}"/>
                                <controls:SignalLight Grid.Row="2" Grid.Column="2" Width="18" Height="18" LightColor="Blue" 
                                                      IsOn="{Binding WaitConfirm}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Row="2" Grid.Column="4" Content="{lex:Loc UseLowerArm}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding UseLowerArmToggle, Mode=OneWay}" Command="{Binding UseLowerArmToggleCommand}"/>
                                <controls:SignalLight Grid.Row="2" Grid.Column="5" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding UseLowerArmActive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Confirm Switch Button -->
                            <Grid Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0" Content="{lex:Loc ConfirmSwitch}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding ConfirmSwitchToggle, Mode=OneWay}" Command="{Binding ConfirmSwitchToggleCommand}"/>
                                <controls:SignalLight Grid.Column="1" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding ConfirmSwitchActive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Row 4: Box Number and Layer Count -->
                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{lex:Loc BoxNumber}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding BoxNumber}" Width="50" VerticalContentAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock Text="{lex:Loc LayerCount}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding LayerCount}" Width="50" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Row 5 and 6: Box Pickup, Box Place, Flip to 0, Flip to 180 -->
                            <Grid Grid.Row="6" Grid.RowSpan="2" Grid.Column="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                
                                <ToggleButton Grid.Row="0" Grid.Column="0" Content="{lex:Loc BoxPickup}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding BoxPickupToggle, Mode=OneWay}" Command="{Binding BoxPickupToggleCommand}"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="18" Height="18" LightColor="Blue" 
                                                      IsOn="{Binding BoxPickup}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Row="0" Grid.Column="2" Content="{lex:Loc BoxPlace}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding BoxPlaceToggle, Mode=OneWay}" Command="{Binding BoxPlaceToggleCommand}"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="3" Width="18" Height="18" LightColor="Blue" 
                                                      IsOn="{Binding BoxPlace}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <ToggleButton Grid.Row="1" Grid.Column="0" Content="{lex:Loc FlipTo0}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding FlipTo0Toggle, Mode=OneWay}" Command="{Binding FlipTo0ToggleCommand}"/>
                                <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="18" Height="18" LightColor="Blue" 
                                                      IsOn="{Binding FlipTo0}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Row="1" Grid.Column="2" Content="{lex:Loc FlipTo180}" Style="{StaticResource MoveToggleButtonStyle}" 
                                        Width="140" Height="28" IsChecked="{Binding FlipTo180Toggle, Mode=OneWay}" Command="{Binding FlipTo180ToggleCommand}"/>
                                <controls:SignalLight Grid.Row="1" Grid.Column="3" Width="18" Height="18" LightColor="Blue" 
                                                      IsOn="{Binding FlipTo180}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Right: Upper Arm Sensor, Lower Arm Sensor, Command Accepted, Robot Safe Position -->
                            <Grid Grid.Row="6" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lex:Loc UpperArmSensor}" VerticalAlignment="Center"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="1" Width="18" Height="18" LightColor="Blue" 
                                                      IsOn="{Binding UpperArmSensor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{lex:Loc CommandAccepted}" VerticalAlignment="Center"/>
                                <controls:SignalLight Grid.Row="0" Grid.Column="4" Width="18" Height="18" LightColor="Green" 
                                                      IsOn="{Binding CommandAccepted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lex:Loc LowerArmSensor}" VerticalAlignment="Center"/>
                                <controls:SignalLight Grid.Row="1" Grid.Column="1" Width="18" Height="18" LightColor="Blue" 
                                                      IsOn="{Binding LowerArmSensor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.Row="1" Grid.Column="3" Content="{lex:Loc RobotSafePosition}" Style="{StaticResource MoveToggleButtonStyle}" 
                                              Width="140" Height="28" IsChecked="{Binding RobotSafePositionToggle, Mode=OneWay}" Command="{Binding RobotSafePositionCommand}"/>
                            </Grid>
                            
                        </Grid>
                    </GroupBox>
                </Grid>
                
                <!-- Bottom Status Bar -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,5" VerticalAlignment="Top">
                    <ToggleButton Content="{lex:Loc EmergencyStop}" Style="{StaticResource ToggleButtonDanger}" MinWidth="70" Height="28" Margin="0,0,10,0" IsChecked="{Binding EmergencyStopToggle, Mode=OneWay}" Command="{Binding EmergencyStopCommand}"/>
                    <ToggleButton Content="{lex:Loc Alarm}" Style="{StaticResource ToggleButtonWarning}" MinWidth="70" Height="28" Margin="0,0,10,0" IsChecked="{Binding AlarmResetToggle, Mode=OneWay}" Command="{Binding AlarmResetCommand}"/>
                    <ToggleButton Content="{lex:Loc Save}" Style="{StaticResource ToggleButtonSuccess}" MinWidth="70" Height="28" IsChecked="{Binding SaveToggle, Mode=OneWay}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </TabItem>
        
        <!-- Station Operation View (Index 1) -->
        <TabItem>
            <local:FeedingRobotStationView DataContext="{Binding}"/>
        </TabItem>
    </TabControl>
</UserControl>
