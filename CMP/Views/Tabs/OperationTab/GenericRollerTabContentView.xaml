<UserControl x:Class="CMP.Views.Tabs.OperationTab.GenericRollerTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:viewModel="clr-namespace:CMP.ViewModels.Tabs.OperationTab"
             d:DataContext="{d:DesignInstance viewModel:GenericRollerTabContentViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources">
    <Border BorderThickness="1"
            Margin="5" Padding="0" CornerRadius="4">
        <StackPanel extensions:StackPanelHelpers.Spacing="10">
            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                          Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <StackPanel>
                            <TextBlock Padding="5" Foreground="White" Text="{Binding TabTitle}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Border CornerRadius="4">
                        <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="20">
                            <StackPanel>
                                <StackPanel Margin="0 0 0 0" Orientation="Horizontal"
                                    extensions:StackPanelHelpers.Spacing="20"
                                    HorizontalAlignment="Center">
                                    <Button Content="{lex:Loc Initialize}" Style="{StaticResource ButtonPrimary}" Width="95"
                                        Command="{Binding InitializeCommand}"
                                        CommandParameter="" />
                                    <Button Content="{lex:Loc AutoMode}" Style="{StaticResource ButtonPrimary}" Width="95"
                                        Command="{Binding AutoModeCommand}"
                                        CommandParameter="" />
                                    <Button Content="{lex:Loc ManualMode}" Style="{StaticResource ButtonPrimary}" Width="105"
                                        Command="{Binding ManualModeCommand}"
                                        CommandParameter="" />
                                </StackPanel>
                                <Image Source="/Assets/Images/Clamper.png" Width="328" Height="304"></Image>
                            </StackPanel>

                            <StackPanel extensions:StackPanelHelpers.Spacing="10">
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="30" HorizontalAlignment="Right">
                                    <Button Content="{lex:Loc AutoRun}" Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding AutoRunCommand}"
                                        CommandParameter="Chamber" Width="100"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="30" >
                                    <TextBlock Text="{lex:Loc State}" />
                                    <TextBlock Text="Ready" />
                                    <TextBlock Text="{lex:Loc Step}" />
                                    <TextBlock Text="1/3" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                    <TextBlock VerticalAlignment="Center" Text="{lex:Loc Recipe}" Width="80"
                                               TextTrimming="CharacterEllipsis" />
                                    <hc:ComboBox ItemsSource="{Binding RollRecipes}" 
                                                 SelectedItem="{Binding SelectedRollRecipe}" 
                                                 Width="150" />
                                    <Button Content="{lex:Loc Run}" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding ExecuteRecipeCommand}"
                                            CommandParameter="Manual" Width="65"/>
                                </StackPanel>
                                <StackPanel Margin="0 40 0 0" Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="70"
                                            HorizontalAlignment="Center">
                                    <Button Content="{lex:Loc Start}" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding StartCommand}"
                                            CommandParameter="" Visibility="Hidden"/>
                                    <Button Content="{lex:Loc Abort}" Style="{StaticResource ButtonDanger}"
                                            Command="{Binding StopCommand}"
                                            CommandParameter="" Width="150"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                    Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <StackPanel>
                            <TextBlock Padding="5" Foreground="White" Text="Cylinder Control" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Border Padding="10">
                        <StackPanel extensions:StackPanelHelpers.Spacing="5">
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Lower Roller" Width="100" VerticalAlignment="Center" />
                                <Button Content="Up" Style="{StaticResource ButtonPrimary}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="LowerRollerCylinder_Up" />
                                <Button Content="Down" Style="{StaticResource ButtonDanger}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="LowerRollerCylinder_Down" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Upper Roller" Width="100" VerticalAlignment="Center" />
                                <Button Content="Up" Style="{StaticResource ButtonPrimary}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="UpperRollerCylinder_Up" />
                                <Button Content="Down" Style="{StaticResource ButtonDanger}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="UpperRollerCylinder_Down" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Arm Up/Down" Width="100" VerticalAlignment="Center" />
                                <Button Content="Up" Style="{StaticResource ButtonPrimary}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="ArmUpDown_Up" />
                                <Button Content="Down" Style="{StaticResource ButtonDanger}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="ArmUpDown_Down" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Arm Lateral" Width="100" VerticalAlignment="Center" />
                                <Button Content="Wait" Style="{StaticResource ButtonPrimary}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="ArmLateralMovement_Waiting" />
                                <Button Content="Clean" Style="{StaticResource ButtonWarning}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="ArmLateralMovement_Cleaning" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Clamp" Width="100" VerticalAlignment="Center" />
                                <Button Content="Release" Style="{StaticResource ButtonPrimary}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="ClampCylinder_Release" />
                                <Button Content="Clamp" Style="{StaticResource ButtonDanger}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="ClampCylinder_Clamp" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Ultrasonic" Width="100" VerticalAlignment="Center" />
                                <Button Content="Up" Style="{StaticResource ButtonPrimary}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="UltrasonicNozzle_Up" />
                                <Button Content="Down" Style="{StaticResource ButtonDanger}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="UltrasonicNozzle_Down" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Wafer Inlet" Width="100" VerticalAlignment="Center" />
                                <Button Content="Open" Style="{StaticResource ButtonPrimary}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="WaferInletDoor_Open" />
                                <Button Content="Close" Style="{StaticResource ButtonDanger}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="WaferInletDoor_Close" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Arm Door" Width="100" VerticalAlignment="Center" />
                                <Button Content="Open" Style="{StaticResource ButtonPrimary}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="ArmDoor_Open" />
                                <Button Content="Close" Style="{StaticResource ButtonDanger}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="ArmDoor_Close" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Wafer Outlet" Width="100" VerticalAlignment="Center" />
                                <Button Content="Open" Style="{StaticResource ButtonPrimary}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="WaferOutletDoor_Open" />
                                <Button Content="Close" Style="{StaticResource ButtonDanger}" Width="60"
                                        Command="{Binding CylinderCommand}"
                                        CommandParameter="WaferOutletDoor_Close" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                          Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <StackPanel>
                            <TextBlock Padding="5" Foreground="White" Text="Pressure Control" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Border Padding="10">
                        <StackPanel extensions:StackPanelHelpers.Spacing="6">
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Width="80" />
                                <TextBlock Text="Set " Width="95" TextAlignment="Left" />
                                <TextBlock Text="Act " Width="95" TextAlignment="Left" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Lower Roller" Width="80" VerticalAlignment="Center" />
                                <hc:NumericUpDown Width="70" Value="{Binding LowerRollerSetPressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Minimum="0" Maximum="500" DecimalPlaces="2" Increment="0.01" />
                                <TextBox Width="65" IsReadOnly="True" Text="{Binding LowerRollerActualPressure, Mode=OneWay, StringFormat={}{0:F1}}" />
                                <Button Content="Set" Style="{StaticResource ButtonPrimary}" Width="50"
                                        Command="{Binding PressureCommand}"
                                        CommandParameter="LowerRollerPressure_Pressure" />
                                <Button Content="Reset" Style="{StaticResource ButtonWarning}" Width="50"
                                        Command="{Binding PressureCommand}"
                                        CommandParameter="LowerRollerPressure_Reset" />
                                <Button Content="Cal" Style="{StaticResource ButtonInfo}" Width="50"
                                        Command="{Binding PressureCommand}"
                                        CommandParameter="LowerRollerPressure_Calibration" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Upper Roller" Width="80" VerticalAlignment="Center" />
                                <hc:NumericUpDown Width="70" Value="{Binding UpperRollerSetPressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Minimum="0" Maximum="500" DecimalPlaces="2" Increment="0.01" />
                                <TextBox Width="65" IsReadOnly="True" Text="{Binding UpperRollerActualPressure, Mode=OneWay, StringFormat={}{0:F1}}" />
                                <Button Content="Set" Style="{StaticResource ButtonPrimary}" Width="50"
                                        Command="{Binding PressureCommand}"
                                        CommandParameter="UpperRollerPressure_Pressure" />
                                <Button Content="Reset" Style="{StaticResource ButtonWarning}" Width="50"
                                        Command="{Binding PressureCommand}"
                                        CommandParameter="UpperRollerPressure_Reset" />
                                <Button Content="Cal" Style="{StaticResource ButtonInfo}" Width="50"
                                        Command="{Binding PressureCommand}"
                                        CommandParameter="UpperRollerPressure_Calibration" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                          Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <StackPanel>
                            <TextBlock Padding="5" Foreground="White" Text="{lex:Loc Liquid}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Border Padding="10">
                        <StackPanel extensions:StackPanelHelpers.Spacing="10">
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="Chemical Main" Width="120" VerticalAlignment="Center" />
                                <Button Content="Open" Style="{StaticResource ButtonPrimary}" Width="50"
                                        Command="{Binding LiquidCommand}"
                                        CommandParameter="ChemicalEnterMainValve_Open" />
                                <Button Content="Close" Style="{StaticResource ButtonDanger}" Width="50"
                                        Command="{Binding LiquidCommand}"
                                        CommandParameter="ChemicalEnterMainValve_Close" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="DIW Main" Width="120" VerticalAlignment="Center" />
                                <Button Content="Open" Style="{StaticResource ButtonPrimary}" Width="50"
                                        Command="{Binding LiquidCommand}"
                                        CommandParameter="DiwEnterMainValve_Open" />
                                <Button Content="Close" Style="{StaticResource ButtonDanger}" Width="50"
                                        Command="{Binding LiquidCommand}"
                                        CommandParameter="DiwEnterMainValve_Close" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="{lex:Loc CoolingWater}" Width="120" VerticalAlignment="Center" />
                                <Button Content="Open" Style="{StaticResource ButtonPrimary}" Width="50"
                                        Command="{Binding LiquidCommand}"
                                        CommandParameter="CoolingWaterCirculation_Open" />
                                <Button Content="Close" Style="{StaticResource ButtonDanger}" Width="50"
                                        Command="{Binding LiquidCommand}"
                                        CommandParameter="CoolingWaterCirculation_Close" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                <!-- Flush Control -->
                <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                          Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <StackPanel>
                            <TextBlock Padding="5" Foreground="White" Text="{lex:Loc Flush}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Border Padding="10">
                        <StackPanel extensions:StackPanelHelpers.Spacing="8">
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="DIW(ALL) Open Delay Set" Width="150" VerticalAlignment="Center" />
                                <TextBox Width="70" Text="{Binding RollerViewPoco.Flush.OpenDelaySet, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Set" Style="{StaticResource ButtonPrimary}" Width="50"
                                        Command="{Binding FlushDelaySetCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="DIW(ALL) Open Delay Act" Width="150" VerticalAlignment="Center" />
                                <TextBlock Width="70" Text="{Binding RollerViewPoco.Flush.OpenDelayAct, StringFormat={}{0:F2}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10" HorizontalAlignment="Center">
                                <Button Content="Open" Style="{StaticResource ButtonPrimary}" Width="70"
                                        Command="{Binding FlushCommand}" CommandParameter="Open" />
                                <Button Content="Close" Style="{StaticResource ButtonDanger}" Width="70"
                                        Command="{Binding FlushCommand}" CommandParameter="Close" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                          Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <StackPanel>
                            <TextBlock Padding="5" Foreground="White" Text="WF Pillar Rotate Motor" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Border Padding="10">
                        <StackPanel extensions:StackPanelHelpers.Spacing="8">
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="{lex:Loc Servo}" Width="60" VerticalAlignment="Center" />
                                <Button Content="{Binding PillarRotateMotorServoText}" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding ServoCommand}"
                                    CommandParameter="WfPillarRotateMotor" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="5">
                                <TextBlock Text="Set Vel" Width="60" VerticalAlignment="Center" />
                                <TextBox Width="70" Text="{Binding PillarSetVelocity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="8">
                                <TextBlock Text="{lex:Loc ActVel}" Width="60" VerticalAlignment="Center" />
                                <TextBlock Text="L" VerticalAlignment="Center" />
                                <TextBlock Width="55" Text="{Binding RollerViewPoco.WfLeftPillarRotateMotor.ActVelocity}" />
                                <TextBlock Text="R" VerticalAlignment="Center" />
                                <TextBlock Width="55" Text="{Binding RollerViewPoco.WfRightPillarRotateMotor.ActVelocity}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="8">
                                <TextBlock Text="{lex:Loc Torque}" Width="60" VerticalAlignment="Center" />
                                <TextBlock Text="L" VerticalAlignment="Center" />
                                <TextBlock Width="55" Text="{Binding RollerViewPoco.WfLeftPillarRotateMotor.ActTorque}" />
                                <TextBlock Text="R" VerticalAlignment="Center" />
                                <TextBlock Width="55" Text="{Binding RollerViewPoco.WfRightPillarRotateMotor.ActTorque}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="40" HorizontalAlignment="Center">
                                <Button Content="{lex:Loc Run}" Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding RunCommand}"
                                        CommandParameter="WfPillarRotateMotor" />
                                <Button Content="{lex:Loc Stop}" Style="{StaticResource ButtonDanger}"
                                        Command="{Binding AbortCommand}"
                                        CommandParameter="WfPillarRotateMotor" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                          Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <StackPanel>
                            <TextBlock Padding="5" Foreground="White" Text="Upper Roller Rotate Motor" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Border Padding="10">
                        <StackPanel extensions:StackPanelHelpers.Spacing="10">
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="{lex:Loc Servo}" Width="60" VerticalAlignment="Center" />
                                <Button Content="{Binding UpperRollerRotateMotorServoText}" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding ServoCommand}"
                                    CommandParameter="UpperRollerRotateMotor" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="{lex:Loc SetVel}" Width="60" VerticalAlignment="Center" />
                                <TextBox Width="100" Text="{Binding RollerViewPoco.UpperRollerRotateMotor.SetVelocity}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="{lex:Loc ActVel}" Width="60" VerticalAlignment="Center" />
                                <TextBlock Width="100" Text="{Binding RollerViewPoco.UpperRollerRotateMotor.ActVelocity}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="{lex:Loc Torque}" Width="60" VerticalAlignment="Center" />
                                <TextBlock Width="100" Text="{Binding RollerViewPoco.UpperRollerRotateMotor.ActTorque}" />
                            </StackPanel>
                            <StackPanel Margin="0 0 0 0" Orientation="Horizontal"
                                        extensions:StackPanelHelpers.Spacing="70"
                                        HorizontalAlignment="Center">
                                <Button Content="{lex:Loc Run}" Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding RunCommand}"
                                        CommandParameter="UpperRollerRotateMotor" />
                                <Button Content="{lex:Loc Stop}" Style="{StaticResource ButtonDanger}"
                                        Command="{Binding AbortCommand}"
                                        CommandParameter="UpperRollerRotateMotor" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                    Padding="10" Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <StackPanel>
                            <TextBlock Padding="5" Foreground="White" Text="Lower Roller Rotate Motor" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Border Padding="10">
                        <StackPanel extensions:StackPanelHelpers.Spacing="10">
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="{lex:Loc Servo}" Width="60" VerticalAlignment="Center" />
                                <Button Content="{Binding LowerRollerRotateMotorServoText}" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding ServoCommand}"
                                    CommandParameter="LowerRollerRotateMotor" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="{lex:Loc SetVel}" Width="60" VerticalAlignment="Center" />
                                <TextBox Width="100" Text="{Binding RollerViewPoco.LowerRollerRotateMotor.SetVelocity}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="{lex:Loc ActVel}" Width="60" VerticalAlignment="Center" />
                                <TextBlock Width="100" Text="{Binding RollerViewPoco.LowerRollerRotateMotor.ActVelocity}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                <TextBlock Text="{lex:Loc Torque}" Width="60" VerticalAlignment="Center" />
                                <TextBlock Width="100" Text="{Binding RollerViewPoco.LowerRollerRotateMotor.ActTorque}" />
                            </StackPanel>
                            <StackPanel Margin="0 0 0 0" Orientation="Horizontal"
                                extensions:StackPanelHelpers.Spacing="70"
                                HorizontalAlignment="Center">
                                <Button Content="{lex:Loc Run}" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding RunCommand}"
                                    CommandParameter="LowerRollerRotateMotor" />
                                <Button Content="{lex:Loc Stop}" Style="{StaticResource ButtonDanger}"
                                    Command="{Binding AbortCommand}"
                                    CommandParameter="LowerRollerRotateMotor" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
