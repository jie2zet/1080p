<UserControl x:Class="CMP.Views.Tabs.OperationTab.InterlockTab.InterlockTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewModel="clr-namespace:CMP.ViewModels.Tabs.OperationTab.InterlockTab"
             prism:ViewModelLocator.AutoWireViewModel="True"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DataContext="{d:DesignInstance viewModel:InterlockTabViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1400"
             Foreground="#111827"
             TextElement.Foreground="#111827"
             mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InterlockTextBrush" Color="#111827" />
        <Style x:Key="InterlockTextBlockStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{x:Null}">
            <Setter Property="Foreground" Value="{StaticResource InterlockTextBrush}" />
        </Style>

        <DataTemplate x:Key="EmergencyStopTemplate">
            <StackPanel Width="100" HorizontalAlignment="Center" Margin="3">
                <controls:SignalLight Width="46"
                                       Height="46"
                                       HorizontalAlignment="Center"
                                       LightColor="{Binding CurrentLightColor}"
                                       IsOn="True" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UnlockTemplate">
            <StackPanel Width="128" HorizontalAlignment="Center" Margin="2,0">
                <TextBlock Height="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding DisplayName}"
                           Style="{StaticResource InterlockTextBlockStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <controls:SignalLight Width="20"
                                           Height="20"
                                           Margin="0,0,6,0"
                                           LightColor="{Binding CurrentLightColor}"
                                           IsOn="True" />
                    <ToggleButton Width="52"
                                  Height="24"
                                  IsChecked="{Binding ReadState, Mode=OneWay}"
                                  IsEnabled="True"
                                  IsHitTestVisible="True"
                                  Click="UnlockToggleButton_Click"
                                  Style="{StaticResource ToggleButtonSwitchBaseStyle}"
                                  ToolTip="{Binding DisplayName}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EquipmentTemplate">
            <StackPanel HorizontalAlignment="Center" Margin="3">
                <TextBlock HorizontalAlignment="Center"
                           Text="{Binding DisplayName}"
                           Style="{StaticResource InterlockTextBlockStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12" />
                <controls:SignalLight Width="28"
                                       Height="28"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Center"
                                       LightColor="{Binding CurrentLightColor}"
                                       IsOn="True" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Margin="4"
            Padding="6"
            BorderBrush="#8B96A8"
            BorderThickness="1"
            CornerRadius="4"
            Background="#F8F9FC"
            TextElement.Foreground="#111827">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Grid Width="1100" Height="760" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="365" />
                        <RowDefinition Height="365" />
                    </Grid.RowDefinitions>

                    <!-- B side: emergency lamps, unlock row, then the equipment block. -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="84" />
                            <RowDefinition Height="88" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /> <ColumnDefinition /> <ColumnDefinition /> <ColumnDefinition />
                                <ColumnDefinition /> <ColumnDefinition /> <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="3" Margin="-200, 0, 0, 0"
                                            HorizontalAlignment="Center"
                                            Content="{Binding BSide.EmergencyStops[0]}"
                                            ContentTemplate="{StaticResource EmergencyStopTemplate}" />
                            <ContentControl Grid.Column="6" Margin="-180, 0, 0, 0"
                                            HorizontalAlignment="Center"
                                            Content="{Binding BSide.EmergencyStops[1]}"
                                            ContentTemplate="{StaticResource EmergencyStopTemplate}" />
                        </Grid>
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding BSide.UnlockItems}"
                                      ItemTemplate="{StaticResource UnlockTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Grid.Row="2"
                                Margin="125,0,125,0"
                                Padding="10,6"
                                BorderBrush="#222B38"
                                BorderThickness="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Row="0" Grid.Column="1"
                                                Content="{Binding BSide.EquipmentStatus[0]}"
                                                ContentTemplate="{StaticResource EquipmentTemplate}" />
                                <ContentControl Grid.Row="0" Grid.Column="2"
                                                Content="{Binding BSide.EquipmentStatus[1]}"
                                                ContentTemplate="{StaticResource EquipmentTemplate}" />
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                Content="{Binding BSide.EquipmentStatus[2]}"
                                                ContentTemplate="{StaticResource EquipmentTemplate}" />
                                <ContentControl Grid.Row="1" Grid.Column="1"
                                                Content="{Binding BSide.EquipmentStatus[3]}"
                                                ContentTemplate="{StaticResource EquipmentTemplate}" />
                                <ContentControl Grid.Row="1" Grid.Column="2"
                                                Content="{Binding BSide.EquipmentStatus[4]}"
                                                ContentTemplate="{StaticResource EquipmentTemplate}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- A side mirrors the drawing: one emergency lamp left of the equipment block. -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="88" />
                            <RowDefinition Height="90" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Border Margin="125,0,125,0"
                                    Padding="10,6"
                                    BorderBrush="#222B38"
                                    BorderThickness="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Grid.Row="0" Grid.Column="0"
                                                    Content="{Binding ASide.EquipmentStatus[0]}"
                                                    ContentTemplate="{StaticResource EquipmentTemplate}" />
                                    <ContentControl Grid.Row="0" Grid.Column="1"
                                                    Content="{Binding ASide.EquipmentStatus[1]}"
                                                    ContentTemplate="{StaticResource EquipmentTemplate}" />
                                    <ContentControl Grid.Row="0" Grid.Column="2"
                                                    Content="{Binding ASide.EquipmentStatus[2]}"
                                                    ContentTemplate="{StaticResource EquipmentTemplate}" />
                                    <ContentControl Grid.Row="1" Grid.Column="1"
                                                    Content="{Binding ASide.EquipmentStatus[3]}"
                                                    ContentTemplate="{StaticResource EquipmentTemplate}" />
                                    <ContentControl Grid.Row="1" Grid.Column="2"
                                                    Content="{Binding ASide.EquipmentStatus[4]}"
                                                    ContentTemplate="{StaticResource EquipmentTemplate}" />
                                </Grid>
                            </Border>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" Margin="-200, -200, 0, 0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{Binding ASide.EmergencyStops[0]}"
                                            ContentTemplate="{StaticResource EmergencyStopTemplate}" />
                            </Grid>
                        </Grid>
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding ASide.UnlockItems}"
                                      ItemTemplate="{StaticResource UnlockTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Content="{Binding ASide.EmergencyStops[1]}"
                                            ContentTemplate="{StaticResource EmergencyStopTemplate}" />
                            <ContentControl Grid.Column="6" Margin="-180, 0, 0, 0"
                                            HorizontalAlignment="Center"
                                            Content="{Binding ASide.EmergencyStops[2]}"
                                            ContentTemplate="{StaticResource EmergencyStopTemplate}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Viewbox>
        </ScrollViewer>
    </Border>
</UserControl>
