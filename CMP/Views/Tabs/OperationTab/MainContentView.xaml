<UserControl x:Class="CMP.Views.Tabs.OperationTab.MainContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:viewModel="clr-namespace:CMP.ViewModels.Tabs.OperationTab"
             xmlns:operationTab="clr-namespace:CMP.Views.Tabs.OperationTab"
             xmlns:converters="clr-namespace:Core.Controls.Converters;assembly=Core"
             d:DataContext="{d:DesignInstance viewModel:MainContentViewModel}"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DesignHeight="800" d:DesignWidth="1770">
    <UserControl.Resources>
        <!-- AddBooleanToVisibilityConverter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StringToBrushConverter x:Key="StringToBrushConverter" />
        <!-- Process data labels stay readable on both light and dark equipment images. -->
        <Style TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Panel.ZIndex" Value="5">
                    <Setter Property="Background" Value="#B0000000" />
                    <Setter Property="Padding" Value="2,0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="DualArmRobotCanvasTemplate">
            <Canvas Width="100" Height="100">
                <Image Source="/Assets/Images/Robot.png" Width="80" Height="80" Stretch="Fill" />
                <Image Source="/Assets/Images/wafer.png"
                       Width="42" Height="42"
                       Canvas.Left="50" Canvas.Top="0"
                       Panel.ZIndex="1"
                       Visibility="{Binding IsVisibleUpperArmWafer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Canvas.Left="52" Canvas.Top="10" Panel.ZIndex="2"
                           Foreground="Blue" FontWeight="Bold" FontSize="7"
                           Text="{Binding UpperArmWaferInfo, StringFormat='U {0}'}"
                           Visibility="{Binding IsVisibleUpperArmWafer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Image Source="/Assets/Images/wafer.png"
                       Width="42" Height="42"
                       Canvas.Left="50" Canvas.Top="48"
                       Panel.ZIndex="1"
                       Visibility="{Binding IsVisibleLowerArmWafer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Canvas.Left="52" Canvas.Top="58" Panel.ZIndex="2"
                           Foreground="Blue" FontWeight="Bold" FontSize="7"
                           Text="{Binding LowerArmWaferInfo, StringFormat='L {0}'}"
                           Visibility="{Binding IsVisibleLowerArmWafer, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Canvas>
        </DataTemplate>

    </UserControl.Resources>
    <Grid extensions:GridHelpers.ColumnDefinitions="380,1400">
        <operationTab:MainPageView Grid.Column="0"
                                   DataContext="{Binding MainPage}" />
        <!-- Center Content -->
        <Border BorderBrush="Gray"
