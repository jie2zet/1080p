                        <Image Source="/Assets/Images/lp2.png" VerticalAlignment="Center" Stretch="None" Width="120" />
                        <Image Source="/Assets/Images/OnlyFoup.png" Width="75" Height="75" HorizontalAlignment="Left"
                               Canvas.Left="{Binding AllLoadPorts[0].DockValue}" Canvas.Top="10"
                               VerticalAlignment="Center" Visibility="{Binding AllLoadPorts[0].IsVisibility}" />
