                                    <TextBlock Padding="5" Foreground="White" Text="{lex:Loc EFEMRobot}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Add Wafer" Command="{Binding AddWaferCommand}"
                                                          CommandParameter="EFEMRobot" />
                                                <MenuItem Header="Delete Wafer" Command="{Binding DeleteWaferCommand}"
                                                          CommandParameter="EFEMRobot" />
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                    <TextBlock Padding="5" Foreground="White" Text="{Binding EFEMRobot.RobotStatus}">
