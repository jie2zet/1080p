                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Grid.ColumnSpan="4" Grid.Column="0">
                    <Button Content="{lex:Loc Initialize}" Width="140" Margin="10"
                            Style="{StaticResource ButtonPrimary}" Command="{Binding InitCommand}">
                    </Button>
                    <Button Content="{lex:Loc AutoMode}" Width="140" Margin="10" Style="{StaticResource ButtonPrimary}"
                            Command="{Binding AutoModeCommand}">
                    </Button>
                    <Button Content="{lex:Loc ManualMode}" Width="140" Margin="10"
                            Style="{StaticResource ButtonPrimary}" Command="{Binding ManualModeCommand}">
                    </Button>
                    <Button Content="{lex:Loc ResetAlarm}" Width="140" Margin="10"
                            Style="{StaticResource ButtonPrimary}" Command="{Binding ResetAlarmCommand}">
                    </Button>
                    <Button Content="{lex:Loc Stop}" Width="140" Margin="10" Style="{StaticResource ButtonDanger}"
                            Command="{Binding StopCommand}">
                    </Button>
                    <Button Content="{lex:Loc AutoRun}" Width="160" Margin="10" Style="{StaticResource ButtonPrimary}"
                            Command="{Binding AutoRunCommand}">
                    </Button>
                    <Button Content="{lex:Loc Abort}" Width="160" Style="{StaticResource ButtonDanger}" />
                </WrapPanel>
