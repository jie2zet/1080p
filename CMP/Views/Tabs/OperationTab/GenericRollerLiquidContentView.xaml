<UserControl x:Class="CMP.Views.Tabs.OperationTab.GenericRollerLiquidContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
             xmlns:viewModels="clr-namespace:CMP.ViewModels.Tabs.MainTab.Content"
             mc:Ignorable="d"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DataContext="{d:DesignInstance viewModels:GenericRollerLiquidContentViewModel}">
    <UserControl.Resources>
        <Style x:Key="LiquidRowText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="LiquidColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource LiquidRowText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <Border BorderThickness="1" Margin="5" Padding="0" CornerRadius="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel MinWidth="1000" HorizontalAlignment="Left" extensions:StackPanelHelpers.Spacing="10">
                <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                          Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <TextBlock Padding="5" Foreground="White" Text="{lex:Loc LiquidParameterSettings}" />
                    </GroupBox.Header>
                    <Border Padding="10">
                        <StackPanel extensions:StackPanelHelpers.Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lex:Loc LiquidItemName}" Style="{StaticResource LiquidColumnHeader}" />
                                <TextBlock Grid.Column="1" Text="{lex:Loc DrawingName}" Style="{StaticResource LiquidColumnHeader}" />
                                <TextBlock Grid.Column="2" Text="{lex:Loc LiquidValue}" Style="{StaticResource LiquidColumnHeader}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LiquidRowText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DrawingTag}" Style="{StaticResource LiquidRowText}" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                                <TextBox Width="90" Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                                <TextBlock Width="70" Text="{Binding Unit}" VerticalAlignment="Center" />
                                                <Button Content="{lex:Loc Set}" Style="{StaticResource ButtonPrimary}" MinWidth="72"
                                                        Command="{Binding SetCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                          Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                    <GroupBox.Header>
                        <TextBlock Padding="5" Foreground="White" Text="{lex:Loc LiquidControl}" />
                    </GroupBox.Header>
                    <Border Padding="10">
                        <StackPanel extensions:StackPanelHelpers.Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lex:Loc LiquidItemName}" Style="{StaticResource LiquidColumnHeader}" />
                                <TextBlock Grid.Column="1" Text="{lex:Loc DrawingName}" Style="{StaticResource LiquidColumnHeader}" />
                                <TextBlock Grid.Column="2" Text="{lex:Loc Action}" Style="{StaticResource LiquidColumnHeader}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CommandGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource LiquidRowText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding PidTag}" Style="{StaticResource LiquidRowText}" />
                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Commands}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button x:Name="ActionButton" Content="{Binding ActionName}" Command="{Binding ExecuteCommand}"
                                                                Style="{StaticResource ButtonPrimary}" MinWidth="72" Padding="12,5" Margin="0,0,10,0" />
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Definition.ActionKey}" Value="ActionClose">
                                                                <Setter TargetName="ActionButton" Property="Style" Value="{StaticResource ButtonDanger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Definition.ActionKey}" Value="ActionFlowrateReset">
                                                                <Setter TargetName="ActionButton" Property="Style" Value="{StaticResource ButtonWarning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Definition.ActionKey}" Value="ActionClfcCalibration">
                                                                <Setter TargetName="ActionButton" Property="Style" Value="{StaticResource ButtonInfo}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
