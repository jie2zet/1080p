<UserControl x:Class="CMP.Views.Tabs.OperationTab.PolishUnitTab.PolishSlurryContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             MinWidth="380">
    <UserControl.Resources>
        <DataTemplate x:Key="SlurrySwitchTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Grid.Column="1" Content="{lex:Loc ActionOpen}" MinWidth="72" Padding="12,5" Margin="0,0,8,0"
                        Style="{StaticResource ButtonPrimary}" Command="{Binding OpenCommand}" />
                <Button Grid.Column="2" Content="{lex:Loc ActionClose}" MinWidth="72" Padding="12,5"
                        Style="{StaticResource ButtonDanger}" Command="{Binding CloseCommand}" />
            </Grid>
        </DataTemplate>
        <Style x:Key="SlurryColumnText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <DataTemplate x:Key="SlurryLineTemplate">
            <StackPanel Margin="0,5,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{lex:Loc PolishSlurrySetFlowrate}" Style="{StaticResource SlurryColumnText}" FontWeight="SemiBold" Margin="0,0,8,5" />
                    <TextBlock Grid.Column="1" Text="{lex:Loc PolishSlurryActualFlowrate}" Style="{StaticResource SlurryColumnText}" FontWeight="SemiBold" Margin="0,0,8,5" />
                    <TextBlock Grid.Column="2" Text="{lex:Loc Unit}" Style="{StaticResource SlurryColumnText}" FontWeight="SemiBold" Margin="0,0,8,5" />
                    <TextBox Grid.Row="1" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding Parameter.InputValue, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActualFlowrate, StringFormat=F2}" Style="{StaticResource SlurryColumnText}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Parameter.Unit}" Style="{StaticResource SlurryColumnText}" />
                    <Button Grid.Row="1" Grid.Column="3" Content="{lex:Loc Set}" Padding="8,5" Style="{StaticResource ButtonPrimary}" Command="{Binding SetCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Controls}" ItemTemplate="{StaticResource SlurrySwitchTemplate}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <ContentControl Content="{Binding TotalControl}" ContentTemplate="{StaticResource SlurrySwitchTemplate}" Margin="0,0,0,8" />
        <TabControl ItemsSource="{Binding Lines}" SelectedIndex="0" Padding="8"
                    Style="{StaticResource SecondaryTabControlStyle}"
                    ItemContainerStyle="{StaticResource SecondaryTabItemStyle}"
                    ContentTemplate="{StaticResource SlurryLineTemplate}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </StackPanel>
</UserControl>
