<UserControl x:Class="CMP.Views.Tabs.OperationTab.PolishUnitTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:viewModel="clr-namespace:CMP.ViewModels.Tabs.OperationTab"
             xmlns:polishUnit="clr-namespace:CMP.Views.Tabs.OperationTab.PolishUnitTab"
             d:DataContext="{d:DesignInstance viewModel:PolishUnitTabContentViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources">
    <Border BorderThickness="1"
            Margin="5" Padding="0" CornerRadius="4">
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10" Grid.Row="0"
                            Grid.Column="0">
                    <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                              Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                        <GroupBox.Header>
                            <StackPanel>
                                <TextBlock Padding="5" Foreground="White" Text="{lex:Loc Polish}" />
                            </StackPanel>
                        </GroupBox.Header>
                        <Border CornerRadius="4">
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="20">
                                <StackPanel>
                                    <StackPanel Margin="0 0 0 0" Orientation="Horizontal"
                                                extensions:StackPanelHelpers.Spacing="20"
                                                HorizontalAlignment="Center">
                                        <Button Content="{lex:Loc Initialize}" Style="{StaticResource ButtonPrimary}"
                                                Width="95"
                                                Command="{Binding InitializeCommand}"
                                                CommandParameter="" />
                                        <Button Content="{lex:Loc AutoMode}" Style="{StaticResource ButtonPrimary}"
                                                Width="95"
                                                Command="{Binding AutoModeCommand}"
                                                CommandParameter="" />
                                        <Button Content="{lex:Loc ManualMode}" Style="{StaticResource ButtonPrimary}"
                                                Width="105"
                                                Command="{Binding ManualModeCommand}"
                                                CommandParameter="" />
                                    </StackPanel>
                                    <Image Source="/Assets/Images/polish_device.png" Width="328" Height="304"></Image>
                                </StackPanel>

                                <StackPanel extensions:StackPanelHelpers.Spacing="10">
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="30"
                                                HorizontalAlignment="Right">
                                        <Button Content="{lex:Loc AutoRun}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding AutoRunCommand}"
                                                CommandParameter="Chamber" Width="100" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="30">
                                        <TextBlock Text="{lex:Loc State}" />
                                        <TextBlock Text="Ready" />
                                        <TextBlock Text="{lex:Loc Step}" />
                                        <TextBlock Text="4/5" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                        <TextBlock VerticalAlignment="Center" Text="{lex:Loc Load}" Width="60"
                                                   TextTrimming="CharacterEllipsis" />
                                        <hc:ComboBox ItemsSource="{Binding LoadRecipes}"
                                                     SelectedItem="{Binding SelectedLoadRecipe}"
                                                     Width="190" />
                                        <Button Content="{lex:Loc Load}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding LoadCommand}"
                                                CommandParameter="Chamber" Width="65" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10"
                                                Visibility="Hidden">
                                        <TextBlock VerticalAlignment="Center" Text="{lex:Loc Pre_Cond}" Width="60"
                                                   TextTrimming="CharacterEllipsis" />
                                        <hc:ComboBox ItemsSource="{Binding ConditionRecipes}"
                                                     SelectedItem="{Binding SelectedPreCondRecipe}"
                                                     Width="190" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                        <TextBlock VerticalAlignment="Center" Text="{lex:Loc Polish}" Width="60"
                                                   TextTrimming="CharacterEllipsis" />
                                        <hc:ComboBox ItemsSource="{Binding PolishRecipes}"
                                                     SelectedItem="{Binding SelectedPolishRecipe}"
                                                     Width="190" />
                                        <Button Content="{lex:Loc Polish}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding PolishCommand}"
                                                CommandParameter="Chamber" Width="65" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                        <TextBlock VerticalAlignment="Center" Text="{lex:Loc Condition}" Width="60"
                                                   TextTrimming="CharacterEllipsis" />
                                        <hc:ComboBox ItemsSource="{Binding ExsituConditionRecipes}"
                                                     SelectedItem="{Binding SelectedExsituConditionRecipe}"
                                                     Width="190" />
                                        <Button Content="{lex:Loc BreakIn}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding ExsituConditionCommand}"
                                                CommandParameter="Chamber" Width="65" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                        <TextBlock VerticalAlignment="Center" Text="Dechuck" Width="60"
                                                   TextTrimming="CharacterEllipsis" />
                                        <hc:ComboBox ItemsSource="{Binding DechuckRecipes}"
                                                     SelectedItem="{Binding SelectedDechuckRecipe}"
                                                     Width="190" />
                                        <Button Content="Dechuck" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding DechuckCommand}"
                                                CommandParameter="Chamber" Width="70" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                        <TextBlock VerticalAlignment="Center" Text="{lex:Loc Unload}" Width="60"
                                                   TextTrimming="CharacterEllipsis" />
                                        <hc:ComboBox ItemsSource="{Binding UnloadRecipes}"
                                                     SelectedItem="{Binding SelectedUnloadRecipe}"
                                                     Width="190" />
                                        <Button Content="{lex:Loc Unload}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding UnloadCommand}"
                                                CommandParameter="Chamber" Width="65" />
                                    </StackPanel>
                                    <StackPanel Margin="0 40 0 0" Orientation="Horizontal"
                                                extensions:StackPanelHelpers.Spacing="70"
                                                HorizontalAlignment="Center">
                                        <Button Content="{lex:Loc Auto}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding AutoCommand}"
                                                CommandParameter="Chamber" Visibility="Hidden" />
                                        <Button Content="{lex:Loc Abort}" Style="{StaticResource ButtonDanger}"
                                                Command="{Binding AbortUnitCommand}"
                                                CommandParameter="Chamber" Width="150" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </GroupBox>
                    <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                              Padding="10" MaxWidth="520" Style="{StaticResource GroupBoxTab.Small}">
                        <GroupBox.Header>
                            <StackPanel>
                                <TextBlock Padding="5" Foreground="White" Text="Pressure" />
                            </StackPanel>
                        </GroupBox.Header>
                        <Border Padding="10 0 10 10">
                            <StackPanel extensions:StackPanelHelpers.Spacing="5">
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                    <TextBlock Text="Zone1" Width="60" VerticalAlignment="Center" />
                                    <TextBox Width="60" Text="{Binding PolishUnit.Zone1.SetPress, Mode=TwoWay}" />
                                    <TextBlock Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone1.ActPress}" />
                                    <TextBlock Visibility="Hidden" Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone1.ActVacuum}" />
                                    <Button Content="{lex:Loc Press}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding PressCommand}" CommandParameter="Zone1" />
                                    <Button Content="{lex:Loc Vent}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VentCommand}" CommandParameter="Zone1" />
                                    <Button Content="{lex:Loc Vacc}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VacuumCommand}" CommandParameter="Zone1" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                    <TextBlock Text="Zone2" Width="60" VerticalAlignment="Center" />
                                    <TextBox Width="60" Text="{Binding PolishUnit.Zone2.SetPress, Mode=TwoWay}" />
                                    <TextBlock Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone2.ActPress}" />
                                    <TextBlock Visibility="Hidden" Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone2.ActVacuum}" />
                                    <Button Content="{lex:Loc Press}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding PressCommand}" CommandParameter="Zone2" />
                                    <Button Content="{lex:Loc Vent}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VentCommand}" CommandParameter="Zone2" />
                                    <Button Content="{lex:Loc Vacc}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VacuumCommand}" CommandParameter="Zone2" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                    <TextBlock Text="Zone3" Width="60" VerticalAlignment="Center" />
                                    <TextBox Width="60" Text="{Binding PolishUnit.Zone3.SetPress, Mode=TwoWay}" />
                                    <TextBlock Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone3.ActPress}" />
                                    <TextBlock Visibility="Hidden" Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone3.ActVacuum}" />
                                    <Button Content="{lex:Loc Press}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding PressCommand}" CommandParameter="Zone3" />
                                    <Button Content="{lex:Loc Vent}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VentCommand}" CommandParameter="Zone3" />
                                    <Button Content="{lex:Loc Vacc}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VacuumCommand}" CommandParameter="Zone3" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                    <TextBlock Text="Zone4" Width="60" VerticalAlignment="Center" />
                                    <TextBox Width="60" Text="{Binding PolishUnit.Zone4.SetPress, Mode=TwoWay}" />
                                    <TextBlock Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone4.ActPress}" />
                                    <TextBlock Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone4.ActVacuum}" />
                                    <Button Content="{lex:Loc Press}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding PressCommand}" CommandParameter="Zone4" />
                                    <Button Content="{lex:Loc Vent}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VentCommand}" CommandParameter="Zone4" />
                                    <Button Content="{lex:Loc Vacc}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VacuumCommand}" CommandParameter="Zone4" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                    <TextBlock Text="Zone5" Width="60" VerticalAlignment="Center" />
                                    <TextBox Width="60" Text="{Binding PolishUnit.Zone5.SetPress, Mode=TwoWay}" />
                                    <TextBlock Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone5.ActPress}" />
                                    <TextBlock Visibility="Hidden" Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone5.ActVacuum}" />
                                    <Button Content="{lex:Loc Press}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding PressCommand}" CommandParameter="Zone5" />
                                    <Button Content="{lex:Loc Vent}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VentCommand}" CommandParameter="Zone5" />
                                    <Button Content="{lex:Loc Vacc}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VacuumCommand}" CommandParameter="Zone5" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                    <TextBlock Text="Zone6" Width="60" VerticalAlignment="Center" />
                                    <TextBox Width="60" Text="{Binding PolishUnit.Zone6.SetPress, Mode=TwoWay}" />
                                    <TextBlock Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone6.ActPress}" />
                                    <TextBlock Visibility="Hidden" Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone6.ActVacuum}" />
                                    <Button Content="{lex:Loc Press}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding PressCommand}" CommandParameter="Zone6" />
                                    <Button Content="{lex:Loc Vent}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VentCommand}" CommandParameter="Zone6" />
                                    <Button Content="{lex:Loc Vacc}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VacuumCommand}" CommandParameter="Zone6" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                    <TextBlock Text="Zone7" Width="60" VerticalAlignment="Center" />
                                    <TextBox Width="60" Text="{Binding PolishUnit.Zone7.SetPress, Mode=TwoWay}" />
                                    <TextBlock Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone7.ActPress}" />
                                    <TextBlock Visibility="Hidden" Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone7.ActVacuum}" />
                                    <Button Content="{lex:Loc Press}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding PressCommand}" CommandParameter="Zone7" />
                                    <Button Content="{lex:Loc Vent}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VentCommand}" CommandParameter="Zone7" />
                                    <Button Content="{lex:Loc Vacc}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VacuumCommand}" CommandParameter="Zone7" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                    <TextBlock Text="Zone8" Width="60" VerticalAlignment="Center" />
                                    <TextBox Width="60" Text="{Binding PolishUnit.Zone8.SetPress, Mode=TwoWay}" />
                                    <TextBlock Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone8.ActPress}" />
                                    <TextBlock Visibility="Hidden" Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Zone8.ActVacuum}" />
                                    <Button Content="{lex:Loc Press}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding PressCommand}" CommandParameter="Zone8" />
                                    <Button Content="{lex:Loc Vent}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VentCommand}" CommandParameter="Zone8" />
                                    <Button Content="{lex:Loc Vacc}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VacuumCommand}" CommandParameter="Zone8" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                    <TextBlock Text="RRing" Width="60" VerticalAlignment="Center" />
                                    <TextBox Width="60" Text="{Binding PolishUnit.Retain.SetPress, Mode=TwoWay}" />
                                    <TextBlock Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Retain.ActPress}" />
                                    <TextBlock Visibility="Hidden" Width="40" VerticalAlignment="Center"
                                               Text="{Binding PolishUnit.Retain.ActVacuum}" />
                                    <Button Content="{lex:Loc Press}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding PressCommand}" CommandParameter="Retain" />
                                    <Button Content="{lex:Loc Vent}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VentCommand}" CommandParameter="Retain" />
                                    <Button Content="{lex:Loc Vacc}" Width="55" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VacuumCommand}" CommandParameter="Retain" />
                                </StackPanel>
                                <StackPanel Margin="0 10 0 0" Orientation="Horizontal"
                                            extensions:StackPanelHelpers.Spacing="5"
                                            HorizontalAlignment="Center">
                                    <Button Content="{lex:Loc Press}" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding PressCommand}" />
                                    <Button Content="{lex:Loc Vent}" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VentCommand}" />
                                    <Button Content="{lex:Loc Vacc}" Style="{StaticResource ButtonPrimary}"
                                            Command="{Binding VacuumCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </GroupBox>
                    <StackPanel Orientation="Vertical">
                        <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                                  Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                            <GroupBox.Header>
                                <StackPanel>
                                    <TextBlock Padding="5" Foreground="White" Text="{lex:Loc Slurry}" />
                                </StackPanel>
                            </GroupBox.Header>
                            <Border Padding="10">
                                <polishUnit:PolishSlurryContentView DataContext="{Binding SlurryControl}" />
                            </Border>
                        </GroupBox>
                        <GroupBox Background="Transparent" hc:TitleElement.Background="{StaticResource PrimaryBrush}"
                                  Padding="10 5 10 10" Style="{StaticResource GroupBoxTab.Small}">
                            <GroupBox.Header>
                                <StackPanel>
                                    <TextBlock Padding="5" Foreground="White" Text="{lex:Loc Cylinder}" />
                                </StackPanel>
                            </GroupBox.Header>
                            <Border Padding="10">
                                <StackPanel extensions:StackPanelHelpers.Spacing="10">
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                        <TextBlock Text="{lex:Loc Platen Breakwater}" Width="120"
                                                   VerticalAlignment="Center" />
                                        <Button Content="{lex:Loc Up}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding UpCommand}"
                                                CommandParameter="PlatenBreakwater">
                                        </Button>
                                        <Button Content="{lex:Loc Down}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding DownCommand}"
                                                CommandParameter="PlatenBreakwater">
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                        <TextBlock Text="{lex:Loc Condition Head}" Width="120"
                                                   VerticalAlignment="Center" />
                                        <Button Content="{lex:Loc Up}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding UpCommand}"
                                                CommandParameter="ConditionHead">
                                        </Button>
                                        <Button Content="{lex:Loc Down}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding DownCommand}"
                                                CommandParameter="ConditionHead">
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10">
                                        <TextBlock Text="{lex:Loc Disk Pressure}" Width="120"
                                                   VerticalAlignment="Center" />
                                        <TextBox Width="50"
                                                 Text="{Binding PolishUnit.ZoneCondition.SetPress, Mode=TwoWay}" />
                                        <TextBlock Width="50"
                                                   Text="{Binding PolishUnit.ZoneCondition.ActPress, Mode=TwoWay}" />
                                        <Button Content="{lex:Loc Set}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding SetCommand}"
                                                CommandParameter="DiskPressure">
                                        </Button>
                                        <Button Content="{lex:Loc Reset}" Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding ResetCommand}"
                                                CommandParameter="DiskPressure">
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                </StackPanel>
                <TabControl Grid.Row="1" Grid.Column="0" Margin="0 0 0 10">
                    <TabItem Header="{lex:Loc PolishMotorRotaryTab}">
                        <ScrollViewer x:Name="RotaryMotorScrollViewer"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      hc:ScrollViewerAttach.AutoHide="False" CanContentScroll="False" PanningMode="Both">
                            <StackPanel Orientation="Horizontal" extensions:StackPanelHelpers.Spacing="10" Margin="0,5,0,48" VerticalAlignment="Top">
                                <GroupBox Header="{lex:Loc PolishMotorPlatenRotation}" Width="330" Style="{StaticResource GroupBoxTab.Small}">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="82"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{lex:Loc PolishMotorSetSpeed}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                        <controls:EditableNumericWithActions Grid.Row="0" Grid.Column="1" Width="82" Height="32" VerticalAlignment="Center"
                                            Value="{Binding PlatenSetVelocity}" Minimum="-90000" Maximum="90000"
                                            DecimalPlaces="3" Increment="0.001"
                                            IsDirty="{Binding IsPlatenSetVelocityDirty, Mode=OneWay}"
                                            SetCommand="{Binding PlatenSetVelocitySetCommand}"
                                            CancelCommand="{Binding PlatenSetVelocityCancelCommand}"/>
                                        <TextBlock Grid.Row="1" Text="{lex:Loc PolishMotorConfirmedSpeed}" Margin="0 0 8 0" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PolishUnit.PlatenMotor.ConfirmedVelocity, StringFormat=F3}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Text="{lex:Loc PolishMotorActualSpeed}" Margin="0 0 8 0" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PolishUnit.PlatenMotor.ActVelocity, StringFormat=F3}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Text="{lex:Loc PolishMotorActualPosition}" Margin="0 0 8 0" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PolishUnit.PlatenMotor.ActPosition, StringFormat=F3}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Width="120" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Content="{lex:Loc PolishMotorStart}" Width="58" Height="32" Style="{StaticResource ButtonPrimary}" Command="{Binding RotaryMotorStartCommand}" CommandParameter="PlatenMotor"/><Button Content="{lex:Loc Stop}" Width="58" Height="32" Margin="4 0 0 0" Style="{StaticResource ButtonDanger}" Command="{Binding RotaryMotorStopCommand}" CommandParameter="PlatenMotor"/></StackPanel>
                                        <TextBlock Grid.Row="4" Text="{lex:Loc PolishMotorJogSpeed}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                        <controls:EditableNumericWithActions Grid.Row="4" Grid.Column="1" Width="82" Height="32" VerticalAlignment="Center"
                                            Value="{Binding PlatenJogVelocity}" Minimum="-90000" Maximum="90000"
                                            DecimalPlaces="3" Increment="0.001"
                                            IsDirty="{Binding IsPlatenJogVelocityDirty, Mode=OneWay}"
                                            SetCommand="{Binding PlatenJogVelocitySetCommand}"
                                            CancelCommand="{Binding PlatenJogVelocityCancelCommand}"/>
                                        <StackPanel Grid.Row="4" Grid.Column="2" Width="120" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Content="JOG+" Tag="PlatenMotor" Width="58" Height="32" Style="{StaticResource ButtonPrimary}" PreviewMouseLeftButtonDown="JogButton_OnPressed" PreviewMouseLeftButtonUp="JogButton_OnReleased" LostMouseCapture="JogButton_OnCaptureLost"/><Button Content="JOG-" Tag="PlatenMotor" Width="58" Height="32" Margin="4 0 0 0" Style="{StaticResource ButtonPrimary}" PreviewMouseLeftButtonDown="JogButton_OnPressed" PreviewMouseLeftButtonUp="JogButton_OnReleased" LostMouseCapture="JogButton_OnCaptureLost"/></StackPanel>
                                         <TextBlock Grid.Row="5" Text="{lex:Loc Servo}" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                         <Button Grid.Row="5" Grid.Column="2" Content="{Binding PlatenMotorServoText}" Width="120" Height="32" Style="{StaticResource ButtonPrimary}" Command="{Binding ServoCommand}" CommandParameter="PlatenMotor"/>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="{lex:Loc PolishMotorHeadRotation}" Width="330" Style="{StaticResource GroupBoxTab.Small}">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="82"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{lex:Loc PolishMotorSetSpeed}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                        <controls:EditableNumericWithActions Grid.Row="0" Grid.Column="1" Width="82" Height="32" VerticalAlignment="Center"
                                            Value="{Binding HeadSetVelocity}" Minimum="-90000" Maximum="90000"
                                            DecimalPlaces="3" Increment="0.001"
                                            IsDirty="{Binding IsHeadSetVelocityDirty, Mode=OneWay}"
                                            SetCommand="{Binding HeadSetVelocitySetCommand}"
                                            CancelCommand="{Binding HeadSetVelocityCancelCommand}"/>
                                        <TextBlock Grid.Row="1" Text="{lex:Loc PolishMotorConfirmedSpeed}" Margin="0 0 8 0" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PolishUnit.HeadRotateMotor.ConfirmedVelocity, StringFormat=F3}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Text="{lex:Loc PolishMotorActualSpeed}" Margin="0 0 8 0" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PolishUnit.HeadRotateMotor.ActVelocity, StringFormat=F3}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Width="120" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Content="{lex:Loc PolishMotorStart}" Width="58" Height="32" Style="{StaticResource ButtonPrimary}" Command="{Binding RotaryMotorStartCommand}" CommandParameter="HeadRotateMotor"/><Button Content="{lex:Loc Stop}" Width="58" Height="32" Margin="4 0 0 0" Style="{StaticResource ButtonDanger}" Command="{Binding RotaryMotorStopCommand}" CommandParameter="HeadRotateMotor"/></StackPanel>
                                        <TextBlock Grid.Row="4" Text="{lex:Loc PolishMotorJogSpeed}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                        <controls:EditableNumericWithActions Grid.Row="4" Grid.Column="1" Width="82" Height="32" VerticalAlignment="Center"
                                            Value="{Binding HeadJogVelocity}" Minimum="-90000" Maximum="90000"
                                            DecimalPlaces="3" Increment="0.001"
                                            IsDirty="{Binding IsHeadJogVelocityDirty, Mode=OneWay}"
