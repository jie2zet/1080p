<UserControl x:Class="CMP.Views.Tabs.RecipeTab.RecipeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:CMP.ViewModels.Tabs.RecipeTab"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:RecipeEditorViewModel}"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:recipe="clr-namespace:CMP.Models.Recipe.RecipeEdit"
             xmlns:extensions1="clr-namespace:CMP.Extensions"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Core.Controls.Behaviors;assembly=Core"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type recipe:TreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconFontAwesome Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" />
                <TextBlock Text="{Binding Header}" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <Style x:Key="FrozenColumnStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="auto"></Setter>
            <Setter Property="Padding" Value="10 5 10 5"></Setter>
            <Setter Property="Background" Value="#CFCFCF"></Setter>
            <Setter Property="BorderBrush" Value="#FFFFFFFF"></Setter>
            <Setter Property="BorderThickness" Value="0 0 0 1"></Setter>
            <Setter Property="Width" Value="auto"/>
        </Style>

        <Style x:Key="ThisDataGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="#FFFFFFFF"></Setter>
            <Setter Property="VerticalAlignment" Value="Top"></Setter>
            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
            <Setter Property="CanUserAddRows" Value="False"></Setter>
            <Setter Property="CanUserDeleteRows" Value="False"></Setter>
            <Setter Property="CanUserSortColumns" Value="False"></Setter>
            <Setter Property="GridLinesVisibility" Value="All"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"></Setter>

            <Setter Property="HorizontalGridLinesBrush">
                <Setter.Value>
                    <SolidColorBrush Color="#ADADAD"/>
                </Setter.Value>
            </Setter>

            <Setter Property="VerticalGridLinesBrush">
                <Setter.Value>
                    <SolidColorBrush Color="#ADADAD"/>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>
    <Grid extensions:GridHelpers.ColumnDefinitions="2*, 7*" Margin="0,-55,0,0">
        <!--<StackPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="0 0 0 5">
            <ToolBar>

            </ToolBar>
        </StackPanel>-->
        <Grid extensions:GridHelpers.RowDefinitions="2*, 8*" Grid.Column="0" MaxHeight="720" Background="#EEEEEE">
            <GroupBox Grid.Row="0" Style="{StaticResource GroupBoxOriginal}"
                  hc:TitleElement.TitlePlacement="Top">
                <GroupBox.Header>
                    <TextBlock Margin="0" Text="{lex:Loc TotalRecipes}" />
                </GroupBox.Header>
                <TreeView>

                </TreeView>
            </GroupBox>
            <GroupBox Grid.Row="1" Style="{StaticResource GroupBoxOriginal}"
                  hc:TitleElement.TitlePlacement="Top">
                <GroupBox.Header>
                    <TextBlock Margin="0" Text="{lex:Loc UnitRecipes}" />
                </GroupBox.Header>
                <TreeView ItemsSource="{Binding UnitRecipesList}"
                      Style="{StaticResource TreeViewBaseStyle}"
                      x:Name="RecipeTreeView"
                      ScrollViewer.CanContentScroll="True"
                      MaxHeight="550">

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectedItemChanged" SourceObject="{Binding ElementName=RecipeTreeView}">
                            <i:InvokeCommandAction Command="{Binding TreeViewNodeChangedCommand}"
                                                  PassEventArgsToCommand="True"
                                                  CommandParameter="{Binding ElementName=RecipeTreeView, Path=SelectedItem}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{lex:Loc New}"
                                  IsEnabled="{Binding NewItemVisible}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconLucide Kind="CirclePlus" Foreground="{StaticResource PrimaryBrush}" />
                                </MenuItem.Icon>
                                <MenuItem Header="Polishing" CommandParameter="Polishing" Command="{Binding TreeNewCommand}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconGameIcons Kind="FloorPolisher"
                                                                 Foreground="{StaticResource PrimaryBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="{lex:Loc Add}" 
                                  IsEnabled="{Binding AddItemVisible}"
                                  Command="{Binding TreeAddCommand, Mode=TwoWay}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconRemixIcon Kind="FileCopy2Line"
                                                             Foreground="{StaticResource PrimaryBrush}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{lex:Loc Save as}"
                                  IsEnabled="{Binding SaveasItemVisible}"
                                  Command="{Binding TreeSaveAsCommand, Mode=TwoWay}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconMaterial Kind="ContentSaveMoveOutline" 
                                                            Foreground="{StaticResource PrimaryBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{lex:Loc Delete}" Command="{Binding TreeDeleteCommand, Mode=TwoWay}"
                                  IsEnabled="{Binding DeleteItemVisible}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconLucide Kind="Trash2" Foreground="Red" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{lex:Loc Rename}" Command="{Binding TreeRenameCommand, Mode=TwoWay}" 
                                  IsEnabled="{Binding RenameItemVisible}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconBoxIcons Kind="RegularRename" Foreground="{StaticResource PrimaryBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                            <Style.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsSelectionActive" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#3F51B5"/>
                                    <Setter Property="BorderBrush" Value="#3F51B5"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                </MultiTrigger>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="IsExpanded" Value="True"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </GroupBox>
        </Grid>
        
        <Grid Grid.Column="1" Margin="5 0 0 0" MaxHeight="720"
              extensions:GridHelpers.ColumnDefinitions="*"
              extensions:GridHelpers.RowDefinitions="Auto,*">
            <ToolBar>
                <Button Height="45" Margin="0 0 2 0" Command="{Binding AddStepCommand}">
                    <StackPanel>
                        <iconPacks:PackIconLucide Kind="CirclePlus" HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" Text="{lex:Loc Add}" />
                    </StackPanel>
                </Button>
                <Button Height="45" Margin="0 0 2 0" Command="{Binding DeleteStepCommand}">
                    <StackPanel>
                        <iconPacks:PackIconFeatherIcons Kind="Trash2" HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" Text="{lex:Loc Delete}" />
                    </StackPanel>
                </Button>
                <Button Height="45" Margin="0 0 2 0" Command="{Binding SaveRecipeCommand}">
                    <StackPanel>
                        <iconPacks:PackIconMaterialLight Kind="ContentSave" HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" Text="{lex:Loc Save}" />
                    </StackPanel>
                </Button>
                <Button Height="45" Margin="2 0 2 0" Command="{Binding CopyStepCommand}">
                    <StackPanel>
                        <iconPacks:PackIconRemixIcon Kind="FileCopy2Line" HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" Text="{lex:Loc Copy}" />
                    </StackPanel>
                </Button>
                <Button Height="45" Margin="0 0 2 0" Command="{Binding PasteStepCommand}">
                    <StackPanel>
                        <iconPacks:PackIconFontAwesome Kind="ClipboardRegular" HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" Text="{lex:Loc Paste}" />
                    </StackPanel>
                </Button>
                <Button Height="45" Margin="0 0 2 0" Command="{Binding InsertStepCommand}" Visibility="Hidden">
                    <StackPanel>
                        <iconPacks:PackIconLucide Kind="BetweenVerticalStart" HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" Text="{lex:Loc Insert}" />
                    </StackPanel>
                </Button>
               
                <Button Height="45" Margin="0 0 2 0" Command="{Binding NewStepCommand}" Visibility="Hidden">
                    <StackPanel>
                        <iconPacks:PackIconFeatherIcons Kind="FilePlus" HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" Text="{lex:Loc New}" />
                    </StackPanel>
                </Button>
            </ToolBar>
            <DataGrid Grid.Row="1" Name="MainDataGrid" SelectionUnit="Cell" SelectionMode="Extended"
                      ItemsSource="{Binding RecipeData.Data}"                      
                      AutoGenerateColumns="False" CanUserSortColumns="False" 
                      CanUserReorderColumns="True" CanUserResizeColumns="False"
                      FrozenColumnCount="3"
                      extensions1:DataGridExtensions.EnableColumnSelection="True"
                      extensions1:DataGridExtensions.SelectedColumn="{Binding SelectedColumn, Mode=TwoWay}"                      
                      RowHeight="35" Style="{StaticResource DataGrid.Small}">
                <i:Interaction.Behaviors>
                    <behaviors:ColumnReorderBehavior  ColumnReorderedCommand="{Binding ColumnReorderedCommand}"/>
                </i:Interaction.Behaviors>
                <DataGrid.Columns>
                    <!-- 只定义固定列，步骤列在代码中动态添加 -->
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" IsReadOnly="True" HeaderStyle="{StaticResource FrozenColumnStyle}" CanUserReorder="False"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" HeaderStyle="{StaticResource FrozenColumnStyle}" CanUserReorder="False"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" HeaderStyle="{StaticResource FrozenColumnStyle}" CanUserReorder="False"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding Min}" IsReadOnly="True" HeaderStyle="{StaticResource FrozenColumnStyle}" CanUserReorder="False"/>
                    <DataGridTextColumn Header="Max" Binding="{Binding Max}" IsReadOnly="True" HeaderStyle="{StaticResource FrozenColumnStyle}" CanUserReorder="False"/>
                    <!--<DataGridTextColumn Header="Type" Binding="{Binding Type}" />-->
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</UserControl>