<Border x:Class="CMP.Views.Tabs.RecipeTab.AddRecipeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMP.Views.Tabs.RecipeTab"
             xmlns:prism ="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewmodels="clr-namespace:CMP.ViewModels.Tabs.RecipeTab"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:CMP.Models.Recipe.RecipeEdit"
             mc:Ignorable="d" 
             Width="320"
             Height="300"
             CornerRadius="15"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewmodels:AddRecipeEditorViewModel}"
             Background="{DynamicResource RegionBrush}"
             >
    <Border.Resources>
        <ObjectDataProvider x:Key="enumProvider" 
                            MethodName="GetNames"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:RecipeModelTemplate"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Border.Resources>
    
    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="30">
        <TextBlock Style="{StaticResource TextBlockLargeBold}" Text="{Binding Message}"/>
        <ComboBox Margin="0,20,0,0"
                  x:Name="comBoxRecipe"
                  ItemsSource="{Binding Source={StaticResource enumProvider}}" 
                  SelectedItem="{Binding ModelTemplate, Mode=TwoWay}"
                  SelectedIndex="{Binding ComboBoxIndex, Mode=TwoWay}">
            <behavior:Interaction.Triggers>
                <behavior:EventTrigger EventName="SelectionChanged" SourceObject="{Binding ElementName=comBoxRecipe}">
                    <behavior:InvokeCommandAction Command="{Binding SelecteChangedCommand}" 
                                                  PassEventArgsToCommand="True"
                                                  CommandParameter="{Binding ElementName=comBoxRecipe, Path=SelectedItem}"/>
                </behavior:EventTrigger>
            </behavior:Interaction.Triggers>
        </ComboBox>
        <TextBox Margin="0,20,0,0" 
                 Style="{StaticResource TextBoxExtend}" 
                 Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" 
                 hc:InfoElement.Placeholder="{lex:Loc PleaseInput}"/>
        <Button Width="120" Margin="0,20,0,0" Command="{Binding OkCmd}" 
                Style="{StaticResource ButtonPrimary}" 
                Content="{lex:Loc Ok}"/>
        <Button Width="120" Margin="0,8,0,2" 
                Command="{Binding CancelCmd}" 
                Style="{StaticResource ButtonDefault}" 
                Content="{lex:Loc Cancel}"/>
    </StackPanel>
</Border>
