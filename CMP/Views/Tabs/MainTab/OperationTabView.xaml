<TabItem x:Class="CMP.Views.Tabs.MainTab.OperationTabView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
         xmlns:lex="http://wpflocalizeextension.codeplex.com"
         xmlns:mvvm="http://prismlibrary.com/"
         Style="{StaticResource CustomTabItemStyle}">

    <!-- 这里定义TabItem的Header，包括图标和文本 -->
    <TabItem.Header>
        <StackPanel Margin="5 30 5 30" VerticalAlignment="Center" MinWidth="80">
            <iconPacks:PackIconRemixIcon Kind="CpuFill" Height="30" Width="30"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            <TextBlock Margin="0 5 0 0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <Run Text="{lex:Loc Operations}" />
            </TextBlock>
        </StackPanel>
    </TabItem.Header>

    <!-- TabItem的内容区域 -->
    <Border>
        <ContentControl mvvm:RegionManager.RegionName="OperationRegion" />
    </Border>
</TabItem>