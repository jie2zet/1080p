<TabItem x:Class="CMP.Views.Tabs.MainTab.WarnTabView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
         xmlns:lex="http://wpflocalizeextension.codeplex.com"
         xmlns:regions="http://prismlibrary.com/"
         Style="{StaticResource CustomTabItemStyle}">
    <TabItem.Header>
        <StackPanel Margin="5 30 5 30" VerticalAlignment="Center" MinWidth="80">
            <iconPacks:PackIconUnicons Kind="HistoryLine" Height="30" Width="30"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
            <TextBlock Margin="0 5 0 0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <Run Text="{lex:Loc History}" />
            </TextBlock>
        </StackPanel>
    </TabItem.Header>
    <Border>
        <ContentControl regions:RegionManager.RegionName="WarnRegion" />
    </Border>
</TabItem>