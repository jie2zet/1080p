<UserControl x:Class="CMP.Views.Tabs.MainTab.Content.AuditLogContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:CMP.ViewModels.Tabs.MainTab.Content"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:AuditLogContentViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="2" BorderBrush="White" Height="70" Margin="5,10,5,10" Padding="10,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Height="70">
                <TextBox hc:InfoElement.Title="{lex:Loc UserName}"
                         hc:InfoElement.TitlePlacement="Left"
                         hc:InfoElement.TitleWidth="100"
                         Text="{Binding UserNameFilter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxExtend}"
                         Width="240"
                         FontSize="14"
                         Height="30"/>

                <ComboBox Height="30"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding ModuleFilters}"
                          SelectedItem="{Binding SelectedModuleFilter}"
                          Width="200"
                          hc:InfoElement.TitlePlacement="Left"
                          hc:InfoElement.TitleWidth="75"
                          FontSize="14"
                          hc:InfoElement.Title="{lex:Loc Module}"
                          Style="{StaticResource ComboBoxExtend}"/>

                <ComboBox Height="30"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding ActionFilters}"
                          SelectedItem="{Binding SelectedActionFilter}"
                          Width="220"
                          hc:InfoElement.TitlePlacement="Left"
                          hc:InfoElement.TitleWidth="70"
                          FontSize="14"
                          hc:InfoElement.Title="{lex:Loc Action}"
                          Style="{StaticResource ComboBoxExtend}"/>

                <TextBox hc:InfoElement.Title="{lex:Loc Target}"
                         hc:InfoElement.TitlePlacement="Left"
                         hc:InfoElement.TitleWidth="70"
                         Text="{Binding TargetFilter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxExtend}"
                         Width="210"
                         FontSize="14"
                         Height="30"
                         Margin="10,0,0,0"/>

                <hc:DateTimePicker Height="30"
                                   hc:InfoElement.Title="{lex:Loc StartTime}"
                                   hc:InfoElement.TitlePlacement="Left"
                                   hc:InfoElement.TitleWidth="95"
                                   FontSize="14"
                                   SelectedDateTime="{Binding StartTime}"
                                   Margin="10,0,0,0"
                                   Width="320"
                                   Style="{StaticResource DateTimePickerExtend}"/>

                <hc:DateTimePicker Height="30"
                                   hc:InfoElement.Title="{lex:Loc EndTime}"
                                   hc:InfoElement.TitlePlacement="Left"
                                   hc:InfoElement.TitleWidth="85"
                                   FontSize="14"
                                   SelectedDateTime="{Binding EndTime}"
                                   Margin="10,0,0,0"
                                   Width="310"
                                   Style="{StaticResource DateTimePickerExtend}"/>

                <Button Content="{lex:Loc Refresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ButtonSuccess}"
                        FontSize="14"
                        MinWidth="90"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <DataGrid x:Name="AuditLogGrid"
                  Grid.Row="1"
                  IsReadOnly="True"
                  Margin="5"
                  ItemsSource="{Binding AuditLogs}"
                  CanUserReorderColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeaderWidth="60"
                  AutoGenerateColumns="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="{lex:Loc Time}" Binding="{Binding Timestamp}" Width="170"/>
                <DataGridTextColumn Header="{lex:Loc UserName}" Binding="{Binding UserName}" Width="100"/>
                <DataGridTextColumn Header="{lex:Loc Role}" Binding="{Binding Level}" Width="100"/>
                <DataGridTextColumn Header="{lex:Loc Module}" Binding="{Binding Module}" Width="100"/>
                <DataGridTextColumn Header="{lex:Loc Action}" Binding="{Binding Action}" Width="130"/>
                <DataGridTextColumn Header="{lex:Loc Target}" Binding="{Binding Target}" Width="220"/>
                <DataGridTextColumn Header="{lex:Loc OldValue}" Binding="{Binding OldValue}" Width="100"/>
                <DataGridTextColumn Header="{lex:Loc NewValue}" Binding="{Binding NewValue}" Width="100"/>
                <DataGridTextColumn Header="{lex:Loc Result}" Binding="{Binding Result}" Width="90"/>
                <DataGridTextColumn Header="{lex:Loc Detail}" Binding="{Binding Detail}" Width="*" MinWidth="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="AliceBlue" Height="50">
            <hc:Pagination HorizontalAlignment="Right"
                           DataCountPerPage="{Binding PageSize}"
                           MaxPageCount="{Binding TotalPages}"
                           PageIndex="{Binding Page, Mode=TwoWay}"
                           IsJumpEnabled="True"
                           Margin="10">
                <bh:Interaction.Triggers>
                    <bh:EventTrigger EventName="PageUpdated">
                        <prism:InvokeCommandAction Command="{Binding PageChangeCommand}"/>
                    </bh:EventTrigger>
                </bh:Interaction.Triggers>
            </hc:Pagination>
        </Border>
    </Grid>
</UserControl>
