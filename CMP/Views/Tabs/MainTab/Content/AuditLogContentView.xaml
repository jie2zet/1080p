<UserControl x:Class="CMP.Views.Tabs.MainTab.Content.AuditLogContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:CMP.ViewModels.Tabs.MainTab.Content"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:AuditLogContentViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="2" BorderBrush="White" Height="70" Margin="5,10,5,10" Padding="10,0,10,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Height="70">
                <TextBox hc:InfoElement.Title="用户名"
                         hc:InfoElement.TitlePlacement="Left"
                         hc:InfoElement.TitleWidth="80"
                         Text="{Binding UserNameFilter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxExtend}"
                         Width="180"
                         FontSize="14"
                         Height="30"/>

                <ComboBox Height="30"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding ModuleFilters}"
                          SelectedItem="{Binding SelectedModuleFilter}"
                          Width="170"
                          hc:InfoElement.TitlePlacement="Left"
                          hc:InfoElement.TitleWidth="50"
                          FontSize="14"
                          hc:InfoElement.Title="模块"
                          Style="{StaticResource ComboBoxExtend}"/>

                <ComboBox Height="30"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding ActionFilters}"
                          SelectedItem="{Binding SelectedActionFilter}"
                          Width="190"
                          hc:InfoElement.TitlePlacement="Left"
                          hc:InfoElement.TitleWidth="50"
                          FontSize="14"
                          hc:InfoElement.Title="操作"
                          Style="{StaticResource ComboBoxExtend}"/>

                <TextBox hc:InfoElement.Title="对象"
                         hc:InfoElement.TitlePlacement="Left"
                         hc:InfoElement.TitleWidth="50"
                         Text="{Binding TargetFilter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxExtend}"
                         Width="180"
                         FontSize="14"
                         Height="30"
                         Margin="10,0,0,0"/>

                <hc:DateTimePicker Height="30"
                                   hc:InfoElement.Title="开始时间"
                                   hc:InfoElement.TitlePlacement="Left"
                                   FontSize="16"
                                   SelectedDateTime="{Binding StartTime}"
                                   Margin="10,0,0,0"
                                   Width="280"
                                   Style="{StaticResource DateTimePickerExtend}"/>

                <hc:DateTimePicker Height="30"
                                   hc:InfoElement.Title="结束时间"
                                   hc:InfoElement.TitlePlacement="Left"
                                   FontSize="16"
                                   SelectedDateTime="{Binding EndTime}"
                                   Margin="10,0,0,0"
                                   Width="280"
                                   Style="{StaticResource DateTimePickerExtend}"/>

                <Button Content="刷新"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ButtonSuccess}"
                        FontSize="14"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="AuditLogGrid"
                  Grid.Row="1"
                  IsReadOnly="True"
                  Margin="5"
                  ItemsSource="{Binding AuditLogs}"
                  CanUserReorderColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeaderWidth="60"
                  AutoGenerateColumns="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="170"/>
                <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="100"/>
                <DataGridTextColumn Header="角色" Binding="{Binding Level}" Width="100"/>
                <DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="100"/>
                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="130"/>
                <DataGridTextColumn Header="对象" Binding="{Binding Target}" Width="220"/>
                <DataGridTextColumn Header="原值" Binding="{Binding OldValue}" Width="100"/>
                <DataGridTextColumn Header="新值" Binding="{Binding NewValue}" Width="100"/>
                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="90"/>
                <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" MinWidth="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="AliceBlue" Height="50">
            <hc:Pagination HorizontalAlignment="Right"
                           DataCountPerPage="{Binding PageSize}"
                           MaxPageCount="{Binding TotalPages}"
                           PageIndex="{Binding Page, Mode=TwoWay}"
                           IsJumpEnabled="True"
                           Margin="10">
                <bh:Interaction.Triggers>
                    <bh:EventTrigger EventName="PageUpdated">
                        <prism:InvokeCommandAction Command="{Binding PageChangeCommand}"/>
                    </bh:EventTrigger>
                </bh:Interaction.Triggers>
            </hc:Pagination>
        </Border>
    </Grid>
</UserControl>
