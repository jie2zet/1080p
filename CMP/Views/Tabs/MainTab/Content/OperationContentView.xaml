<UserControl x:Class="CMP.Views.Tabs.MainTab.Content.OperationContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             xmlns:extensions="clr-namespace:Core.Controls.Extensions;assembly=Core"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:viewModels="clr-namespace:CMP.ViewModels.Tabs.MainTab.Content"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:operationTab="clr-namespace:CMP.Views.Tabs.OperationTab"
             xmlns:vm="clr-namespace:CMP.ViewModels.Tabs.OperationTab"
             xmlns:mainVm="clr-namespace:CMP.ViewModels.Tabs.MainTab.Content"
             xmlns:controls="clr-namespace:CMP.Controls"
             xmlns:mainContent="clr-namespace:CMP.Views.Tabs.MainTab.Content"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance viewModels:OperationContentViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DesignHeight="500" d:DesignWidth="800">

    <TabControl ItemContainerStyle="{StaticResource SecondaryTabItemStyle}"          Style="{StaticResource SecondaryTabControlStyle}">
        <!--<TabItem Header="{lex:Loc Main}">
            <operationTab:MainContentView />
        </TabItem>-->
        <TabItem Header="{lex:Loc Polish}" Style="{StaticResource SecondaryTabItemStyle}" >
            <Border Padding="10" >
                <TabControl ItemsSource="{Binding PolishUnitTabItems}" Style="{StaticResource SecondaryTabControlStyle}"
                            SelectedIndex="{Binding SelectedIndex}"
                            ItemContainerStyle="{StaticResource SecondaryTabItemStyle}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TabTitle}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
            </Border>
        </TabItem>

        <TabItem Header="{lex:Loc Roller}" Style="{StaticResource SecondaryTabItemStyle}">
            <ContentControl prism:RegionManager.RegionName="RollerRegion"/>
        </TabItem>

        <TabItem Header="{lex:Loc Pen}" Style="{StaticResource SecondaryTabItemStyle}">
            <ContentControl prism:RegionManager.RegionName="PenCleanRegion"/>
        </TabItem>

        <TabItem Header="{lex:Loc Dry}" Style="{StaticResource SecondaryTabItemStyle}">
            <ContentControl prism:RegionManager.RegionName="DryRegion"/>
        </TabItem>

        <TabItem Header="{lex:Loc LoadPortUnit}" Style="{StaticResource SecondaryTabItemStyle}">
            <ContentControl prism:RegionManager.RegionName="LoadPortRegion"/>
        </TabItem>
        
        <!--load port test-->
        <TabItem Header="{lex:Loc SerialPort}" Style="{StaticResource SecondaryTabItemStyle}">
            <ContentControl prism:RegionManager.RegionName="SerialPortRegion"/>
        </TabItem>
        
        <!-- 机器人控制 -->
        <TabItem Header="{lex:Loc RobotControl}" Style="{StaticResource SecondaryTabItemStyle}">
            <ContentControl prism:RegionManager.RegionName="RobotControlRegion"/>
        </TabItem>
        <TabItem Header="IO" Style="{StaticResource SecondaryTabItemStyle}">
            <TabControl ItemsSource="{Binding IoTabs}" SelectedItem="{Binding SelectedIoTab}"
                        Style="{StaticResource SecondaryTabControlStyle}"
                        ItemContainerStyle="{StaticResource SecondaryTabItemStyle}">
                <TabControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Header}" /></DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <TabControl ItemsSource="{Binding Groups}"
                                    Style="{StaticResource SecondaryTabControlStyle}"
                                    ItemContainerStyle="{StaticResource SecondaryTabItemStyle}">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <Border Margin="6" Padding="8" BorderBrush="#556070" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <GroupBox Header="DI" Margin="0,0,4,0">
                                                    <ItemsControl ItemsSource="{Binding DiItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="2">
                                                                    <controls:SignalLight Width="16" Height="16" IsOn="{Binding Value}" Margin="0,0,6,0" />
                                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Value}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </GroupBox>
                                                <GroupBox Header="DO" Grid.Column="1" Margin="4,0,0,0">
                                                    <ItemsControl ItemsSource="{Binding DoItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="2">
                                                                    <controls:SignalLight Width="16" Height="16" IsOn="{Binding Value}" Margin="0,0,6,0" />
                                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                        <Button Content="True" Command="{Binding TrueCommand}" Margin="2,0" Padding="6,1" />
                                                                        <Button Content="False" Command="{Binding FalseCommand}" Margin="2,0" Padding="6,1" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </GroupBox>
                                            </Grid>
                                        </Border>
                                    </ScrollViewer>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </TabItem>

        <TabItem Header="{lex:Loc LiquidControl}" Style="{StaticResource SecondaryTabItemStyle}">
            <mainContent:LiquidContentView DataContext="{Binding Liquid}" />
        </TabItem>

        <!-- 安全联锁 -->
        <TabItem Header="{lex:Loc Interlock}" Style="{StaticResource SecondaryTabItemStyle}">
            <ContentControl prism:RegionManager.RegionName="InterlockRegion"/>
        </TabItem>
        
        <!--<TabItem Header="{lex:Loc Roller}" Style="{StaticResource SecondaryTabItemStyle}">
            <ContentControl prism:RegionManager.RegionName="RollerRegion"/>
        </TabItem>-->
        
    </TabControl>
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:PolishUnitTabContentViewModel}">
            <operationTab:PolishUnitTabContentView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PenCleanTabContentViewModel}">
            <operationTab:PenCleanTabContentView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DryTabContentViewModel}">
            <operationTab:DryTabContentView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BotTabContentViewModel}">
            <operationTab:BotTabContentView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoboticArmTabContentViewModel}">
            <operationTab:RoboticArmTabContentView DataContext="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>
</UserControl>
