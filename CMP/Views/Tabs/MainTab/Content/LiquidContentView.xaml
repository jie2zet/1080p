<UserControl x:Class="CMP.Views.Tabs.MainTab.Content.LiquidContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:viewModels="clr-namespace:CMP.ViewModels.Tabs.MainTab.Content"
             xmlns:operationViewModels="clr-namespace:CMP.ViewModels.Tabs.OperationTab"
             xmlns:operationTab="clr-namespace:CMP.Views.Tabs.OperationTab"
             mc:Ignorable="d"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             d:DataContext="{d:DesignInstance viewModels:LiquidContentViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type operationViewModels:GenericPolishLiquidContentViewModel}">
            <operationTab:GenericPolishLiquidContentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type operationViewModels:GenericRollerLiquidContentViewModel}">
            <operationTab:GenericRollerLiquidContentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type operationViewModels:GenericPenLiquidContentViewModel}">
            <operationTab:GenericPenLiquidContentView />
        </DataTemplate>
    </UserControl.Resources>

    <TabControl ItemsSource="{Binding Tabs}"
                Style="{StaticResource SecondaryTabControlStyle}"
                ItemContainerStyle="{StaticResource SecondaryTabItemStyle}">
        <TabControl.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Header}" />
            </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
            <DataTemplate>
                <Grid Margin="6">
                    <TextBlock Text="{Binding EmptyState}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.7"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TabControl ItemsSource="{Binding Chambers}"
                                Style="{StaticResource SecondaryTabControlStyle}"
                                ItemContainerStyle="{StaticResource SecondaryTabItemStyle}"
                                Visibility="{Binding HasChambers, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Header}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Content}" />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>
