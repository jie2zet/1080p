<UserControl x:Class="CMP.Views.Common.Dialog.FormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMP.Views.Common.Dialog"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
        Width="{Binding Width}"
        Height="{Binding Height}"
        Background="{DynamicResource RegionBrush}">
    <Grid>
        <StackPanel Margin="0,10,0,10" VerticalAlignment="Center">
            <ContentControl prism:RegionManager.RegionName="RegionForm" />
        </StackPanel>
        <StackPanel Margin="0,0,20,10" Height="60" VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Grid.Column="2">
            <hc:Row Width="150" Gutter="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <hc:Col Span="12">
                    <Button Content="取消" Command="{Binding CancelCommand}" CommandParameter="FormDialog" Height="auto"  Style="{StaticResource ButtonSuccess}"  FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </hc:Col>
                <hc:Col Span="12">
                    <Button Content="确认" Command="{Binding ConfirmCommand}" CommandParameter="FormDialog" Height="auto"  Style="{StaticResource ButtonSuccess}"  FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </hc:Col>
            </hc:Row>
        </StackPanel>
    </Grid>
</UserControl>
