<UserControl x:Class="CMP.Views.Common.Dialog.CopyColumnDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:prism ="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"              
             xmlns:local="clr-namespace:CMP.Views.Common.Dialog"
             xmlns:vm="clr-namespace:CMP.ViewModels.Common.Dialog"
             xmlns:gridHelp="clr-namespace:Core.Controls.Extensions;assembly=Core"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance vm:CopyColumnDialogViewModel}"
             d:DesignWidth="400">
    <Grid gridHelp:GridHelpers.RowDefinitions="auto,*,50" Background="White">
        <StackPanel Grid.Row="0" VerticalAlignment="Center" Height="auto">
            <TextBlock Text="{lex:Loc CopySetColumnToZone}" 
               Background="#2C66A7" 
               Width="auto" Height="25" TextAlignment="Center" 
               LineHeight="20"
               LineStackingStrategy="BlockLineHeight"
               Foreground="White" Margin="1"/>
        </StackPanel>
        <Grid Grid.Row="1" gridHelp:GridHelpers.ColumnDefinitions="*,*,*">
            <ComboBox ItemsSource="{Binding ZoneNames}" 
                      SelectedItem="{Binding SelectedZoneName}" 
                      Width="120" Height="30" 
                      HorizontalAlignment="Center" 
                      Margin="5" Grid.Column="0"
                      Style="{StaticResource ComboBox.Small}"
                      BorderBrush="Black"/>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                <iconPacks:PackIconEntypo Kind="ArrowBoldRight" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                          Foreground="LimeGreen" Background="Transparent" Width="40" Height="40" />
            </StackPanel>

            <ListBox Grid.Column="2" Margin="5" ItemsSource="{Binding CopiedTargetZone}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <CheckBox IsChecked="{Binding  IsCopy}" VerticalAlignment="Center" Margin="5"/>
                            <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" Margin="5" IsEnabled="False"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="{lex:Loc Ok}" 
                    Command="{Binding ConfirmCommand}" 
                    Width="80" Height="30" 
                    HorizontalAlignment="Center" 
                    Margin="0,10,10,10"
                    Style="{StaticResource ButtonPrimary}"/>
            <Button Content="{lex:Loc Cancel}" 
                    Command="{Binding CancelCommand}" 
                    Width="80" Height="30" 
                    HorizontalAlignment="Center" 
                    Margin="40,10,10,10"
                    Style="{StaticResource ButtonPrimary}"/>
        </StackPanel>
    </Grid>
</UserControl>
