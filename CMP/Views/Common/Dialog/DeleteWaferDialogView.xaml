<hc:Window x:Class="CMP.Views.Common.Dialog.DeleteWaferDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewModels="clr-namespace:CMP.ViewModels.Common.Dialog"
             Title="删除 Wafer"
             Width="450"
             Height="350"
             ResizeMode="NoResize"
             WindowStartupLocation="CenterOwner"
             Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <Style x:Key="TextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="AliceBlue"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinWidth" Value="250"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="{Binding Title}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Style="{StaticResource TextBlockBaseStyle}"/>

        <Border Grid.Row="1" 
                Margin="10" 
                BorderBrush="#ADADAD" 
                BorderThickness="1.5"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" 
                           Grid.Column="0" 
                           Text="Loadport ID:"
                           FontSize="18"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,20,15"/>
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Style="{StaticResource TextBoxStyle}"
                         Foreground="{DynamicResource canBackForeColor}"
                         Text="{Binding LoadportID, Mode=TwoWay}"/>

                <TextBlock Grid.Row="1" 
                           Grid.Column="0" 
                           Text="Slot ID:"
                           FontSize="18"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,20,0"/>
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource TextBoxStyle}"
                         Foreground="{DynamicResource canBackForeColor}"
                         Text="{Binding SlotID, Mode=TwoWay}"/>
            </Grid>
        </Border>
        
        <StackPanel Grid.Row="2" 
                    VerticalAlignment="Center" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button Style="{StaticResource ButtonSuccess.Small}"                    
                    Height="35" Width="100"
                    Content="确认"
                    FontSize="18"
                    Margin="0,0,20,0"
                    Command="{Binding OKCommand}"/>
            <Button Style="{StaticResource ButtonSuccess.Small}"
                    Height="35" Width="100"
                    Content="取消"
                    FontSize="18"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</hc:Window>

