<UserControl x:Class="CMP.Views.Common.Dialog.UserManageDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMP.Views.Common.Dialog"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:model="clr-namespace:CMP.Models.UserData"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:behavior="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewModels="clr-namespace:CMP.ViewModels.Common.Dialog"
             xmlns:regionNames="clr-namespace:Core.Common.RegionNames;assembly=Core"
             mc:Ignorable="d"             
             d:DataContext="{d:DesignInstance viewModels:UserManageDialogViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="450" d:DesignWidth="800"
             >
    <UserControl.Resources>
        <Style x:Key="TextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#5E5E5E"/>
            <Setter Property="Background" Value="#D1D1D1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="MinWidth" Value="300"/>
        </Style>

        <ObjectDataProvider x:Key="EnumProvider"
                            MethodName="GetNames" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:PermissionEnum"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="{Binding Title}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="20"
                   Style="{StaticResource TextBlockBaseStyle}"/>

        <Border Margin="5" Grid.Row="1" BorderBrush="#ADADAD" BorderThickness="1.5">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Grid.Column="0" 
                           Text="{Binding BlockName1}"
                           FontSize="18"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="30"/>
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="10,0,10,0"
                         Style="{StaticResource TextBoxStyle}"
                         Foreground="{DynamicResource canBackForeColor}"
                         Text="{Binding TextBox1, Mode=TwoWay}">
                    <behavior:Interaction.Behaviors>
                        <!--<events:ClearTextOnMouseEnterBehavior/>-->
                    </behavior:Interaction.Behaviors>
                </TextBox>

                <TextBlock Grid.Row="1" 
                           Grid.Column="0" 
                           Text="{Binding BlockName2}"
                           FontSize="18"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="30"/>
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="10,0,10,0"
                         Style="{StaticResource TextBoxStyle}"
                         Foreground="{DynamicResource canBackForeColor}"
                         Text="{Binding TextBox2, Mode=TwoWay}">
                    <behavior:Interaction.Behaviors>
                        <!--<events:ClearTextOnMouseEnterBehavior/>-->
                    </behavior:Interaction.Behaviors>
                </TextBox>

                <TextBlock Grid.Row="2" 
                           Grid.Column="0" 
                           Text="{Binding BlockName3}"
                           FontSize="18"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="30"   />
                <ComboBox Grid.Row="2"
                         Grid.Column="1"
                         Margin="10,0,10,0"
                         Height="40" Width="200"
                         HorizontalAlignment="Left"
                         Background="#D1D1D1"
                          BorderBrush="#5E5E5E"
                         Foreground="{DynamicResource canBackForeColor}"
                         ItemsSource="{Binding Source={StaticResource EnumProvider}}"
                         SelectedItem="{Binding TextBox3, Mode=TwoWay}">
                    <behavior:Interaction.Behaviors>
                        <!--<events:ClearTextOnMouseEnterBehavior/>-->
                    </behavior:Interaction.Behaviors>
                </ComboBox>

            </Grid>
        </Border>
        
        <StackPanel Grid.Row="2" VerticalAlignment="Center" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10"
                    >
            <Button Style="{StaticResource ButtonSuccess.Small}"                    
                    Height="30" Width="100"
                    Content="Confirm"
                    FontSize="20"
                    Margin="0,0,20,0"
                    Command="{Binding OKCommand}"/>
            <Button Style="{StaticResource ButtonSuccess.Small}"
                    Height="30" Width="100"
                    Content="Cancle "
                    FontSize="20"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
