<UserControl x:Class="CMP.Views.Common.Dialog.ChangePasswordDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:vm="clr-namespace:CMP.ViewModels.Common.Dialog"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance vm:ChangePasswordDialogViewModel}"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources"
             MinWidth="420"
             MinHeight="320">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{lex:Loc ChangePassword}"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="当前用户" Margin="0,0,0,4"/>
                <TextBox Height="36"
                         IsReadOnly="True"
                         Background="#F5F5F5"
                         Text="{Binding CurrentUserName}"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{lex:Loc OldPassword}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="OldPasswordBox"
                             Height="36"
                             PasswordChanged="OldPasswordBox_OnPasswordChanged"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{lex:Loc NewPassword}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="NewPasswordBox"
                             Height="36"
                             PasswordChanged="NewPasswordBox_OnPasswordChanged"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{lex:Loc ConfirmPassword}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="36"
                             PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"
                             KeyDown="ConfirmPasswordBox_OnKeyDown"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       MinHeight="20"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <Button Content="{lex:Loc Ok}"
                    Width="100"
                    Height="32"
                    Margin="0,0,16,0"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding ConfirmCommand}"/>
            <Button Content="{lex:Loc Cancel}"
                    Width="100"
                    Height="32"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
