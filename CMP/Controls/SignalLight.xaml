<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CMP.Controls">
    
    <Style TargetType="{x:Type local:SignalLight}">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SignalLight}">
                    <Grid>
                        <!-- 外发光层 -->
                        <Ellipse x:Name="PART_GlowLayer" Margin="-4" Opacity="0" IsHitTestVisible="False"/>
                        
                        <!-- 外边框 -->
                        <Ellipse>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#808080" Offset="0"/>
                                    <GradientStop Color="#505050" Offset="0.5"/>
                                    <GradientStop Color="#606060" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        
                        <!-- 内凹效果 -->
                        <Ellipse Margin="1">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#202020" Offset="0"/>
                                    <GradientStop Color="#303030" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        
                        <!-- LED灯体 - 熄灭状态 -->
                        <Ellipse x:Name="PART_LightBodyOff" Margin="2" Opacity="1"/>
                        
                        <!-- LED灯体 - 亮起状态 -->
                        <Ellipse x:Name="PART_LightBodyOn" Margin="2" Opacity="0"/>
                        
                        <!-- 玻璃高光 -->
                        <Ellipse Margin="3,3,5,8" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.7,1">
                                    <GradientStop Color="#50FFFFFF" Offset="0"/>
                                    <GradientStop Color="#08FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
