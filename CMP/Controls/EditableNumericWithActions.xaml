<UserControl x:Class="CMP.Controls.EditableNumericWithActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="CMP"
             lex:ResxLocalizationProvider.DefaultDictionary="Resources">
    <Grid>
        <hc:NumericUpDown x:Name="NumericInput"
                          Value="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DecimalPlaces="{Binding DecimalPlaces, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Increment="{Binding Increment, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <Popup x:Name="ActionPopup"
               PlacementTarget="{Binding ElementName=NumericInput}"
               Placement="Bottom"
               VerticalOffset="4"
               IsOpen="{Binding IsActionPopupOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
               StaysOpen="True"
               AllowsTransparency="True">
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{lex:Loc Set}" Style="{StaticResource ButtonPrimary}" Width="55" Height="28"
                            Margin="0,0,6,0"
                            Click="ActionButton_Click"
                            Command="{Binding SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="{lex:Loc Cancel}" Style="{StaticResource ButtonDefault}" Width="55" Height="28"
                            Click="ActionButton_Click"
                            Command="{Binding CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
