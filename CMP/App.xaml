<prism:PrismApplication x:Class="CMP.App"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:prism="clr-namespace:Prism.DryIoc;assembly=Prism.DryIoc.Wpf"
                        xmlns:converters="clr-namespace:Core.Controls.Converters;assembly=Core">
    <Application.Resources>
        <ResourceDictionary>
            <converters:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Core;component/Resources/Theme/Basic/SkinLocal.xaml" />
                <!-- <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/> -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary
                    Source="pack://application:,,,/Core;component/Controls/Styles/Button/ToggleButtonStyle.xaml" />
                
                <ResourceDictionary
                    Source="pack://application:,,,/Core;component/Controls/Styles/TabControl/TabItemStyle.xaml" />
                <ResourceDictionary
                    Source="pack://application:,,,/Core;component/Controls/Styles/TabControl/TabControlStyle.xaml" />
                
                <ResourceDictionary
                    Source="pack://application:,,,/Core;component/Controls/Styles/TabControl/SecondaryTabStyle.xaml" />
                
                <ResourceDictionary
                    Source="pack://application:,,,/Core;component/Controls/Styles/TabControl/TertiaryTabStyle.xaml" />

                <ResourceDictionary
                    Source="/Core;component/Controls/Styles/DataGrid/DataGridStyle.xaml" />
                
                <ResourceDictionary Source="/CMP;component/Controls/SignalLight.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>